{
	"projectName": "OpenManager (PMM & SEP Cross-Repo)",
	"primaryLanguages": ["go", "python", "typescript"],
	"docEntrypoint": "CLAUDE.md",
	"components": [
		{
			"name": "PMM",
			"path": "pmm",
			"language": "go",
			"documentation": "pmm/AGENTS.md"
		},
		{
			"name": "SEP",
			"path": "SEP",
			"language": "python",
			"documentation": "SEP/AGENTS.md"
		}
	],
	"commands": {
		"lint": {
			"pmm": "cd pmm && golangci-lint run ./...",
			"sep": "cd SEP && make lint"
		},
		"test": {
			"pmm": "cd pmm && make test",
			"sep": "cd SEP && make test"
		},
		"format": {
			"pmm": "cd pmm && gofmt -w .",
			"sep": "cd SEP && make format"
		}
	},
	"permissions": {
		"allow": [
			"Bash(git -C SEP log *)",
			"Bash(git -C pmm log *)",
			"Bash(git -C SEP status *)",
			"Bash(git -C pmm status *)",
			"Bash(git -C SEP rev-parse *)",
			"Bash(git -C pmm rev-parse *)",
			"Bash(git -C SEP diff *)",
			"Bash(git -C pmm diff *)",
			"Bash(git -C SEP show *)",
			"Bash(git -C pmm show *)",
			"Bash(git -C SEP branch *)",
			"Bash(git -C pmm branch *)",
			"Bash(git -C SEP ls-files *)",
			"Bash(git -C pmm ls-files *)",
			"Bash(git -C SEP worktree list *)",
			"Bash(git -C pmm worktree list *)",
			"Bash(git -C ../SEP status *)",
			"Bash(git -C ../pmm status *)",
			"Bash(git -C /home/plebioda/openmanager/SEP status *)",
			"Bash(git -C /home/plebioda/openmanager/pmm status *)",
			"Bash(gofmt -l *)",
			"Bash(openssl x509 *)",
			"mcp__claude_ai_Notion__notion-fetch",
			"mcp__claude_ai_Notion__notion-search",
			"mcp__claude_ai_Notion__notion-get-comments",
			"mcp__claude_ai_Notion__notion-get-teams",
			"mcp__claude_ai_Notion__notion-get-users",
			"mcp__claude_ai_Notion__notion-list-recent-pages",
			"mcp__claude_ai_Notion__notion-list-shared-pages",
			"mcp__claude_ai_Notion__notion-list-private-pages",
			"mcp__claude_ai_Notion__notion-list-favorite-pages",
			"mcp__claude_ai_Notion__notion-query-data-sources",
			"mcp__claude_ai_Atlassian__getJiraIssue",
			"mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
			"mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
			"mcp__claude_ai_Atlassian__getVisibleJiraProjects",
			"mcp__claude_ai_Atlassian__getConfluencePage",
			"mcp__claude_ai_Atlassian__getPagesInConfluenceSpace",
			"mcp__claude_ai_Atlassian__getConfluenceSpaces",
			"mcp__claude_ai_Atlassian__searchConfluenceUsingCql",
			"mcp__claude_ai_Atlassian__search",
			"mcp__claude_ai_Atlassian__fetch",
			"mcp__claude_ai_Atlassian__atlassianUserInfo"
		]
	}
}
