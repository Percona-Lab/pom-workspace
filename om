# ---------------------------------------------------------------------------
# build (PMM from source)
# ---------------------------------------------------------------------------

cmd_build() {
  local what="${1:-pmm}"
  case "$what" in
    pmm|ui) ;;
    *) die "only 'pmm' (Go services) or 'ui' (frontend) can be built; got '$what'" ;;
  esac
  docker inspect "$PMM_CONTAINER" >/dev/null 2>&1 \
    || die "$PMM_CONTAINER is not running — ./om start pmm first"
  if [[ "$what" == "ui" ]]; then
    # Forced: `./om start pmm` only rebuilds when the deployed bundle has no SEP
    # routes at all, so this is how UI edits reach the browser without Vite.
    ensure_pmm_ui 1
    return 0
  fi
  info "pmm: compiling working tree (run-all) — this takes a few minutes"
  # `run-all` chains the *-ci targets, which rebuild each Go service and restart
  # it under supervisorctl WITHOUT tailing logs. The bare `run-managed` target
  # tails forever and would hang a script. No -t: there is no TTY here.
  #
  # As root, for the same two reasons ensure_pmm_managed is: the module cache under
  # /root/go is not writable by the default user, and git refuses the repo without
  # the safe.directory exception.
  docker exec -i --user root "$PMM_CONTAINER" \
    git config --global --add safe.directory "$PMM_WORKDIR" >/dev/null 2>&1 || true
  docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" make run-all
  # Stamp it so `./om start pmm` does not immediately rebuild what was just built.
  docker exec -i --user root "$PMM_CONTAINER" \
    sh -c "printf '%s' '$(pmm_tree_fingerprint)' > '$PMM_MANAGED_STAMP'" >/dev/null 2>&1 || true
  ok "pmm-managed, pmm-agent, qan-api2 and vmproxy rebuilt from your tree"
}

# ---------------------------------------------------------------------------
# inventory — PMM's inventory as JSON on stdout
# ---------------------------------------------------------------------------
#
# pmm-managed splits the inventory over three endpoints, and each one answers
# with a map keyed by type — {"generic": [...], "container": [...]} — not a flat
# list, so the type of a record lives in the key rather than in the record. None
# of the three joins to the others either: a service points at a node_id, an
# exporter points at a service_id *and* a pmm_agent_id, and only the pmm_agent
# itself knows which node it runs on. Doing that stitching here is the whole
# point of the command — `./om inventory` emits one document you can jq in a
# single pass instead of three curls and a manual join.
#
# Everything on stdout is JSON and nothing else, so this is safe to pipe.

# The dev container's Grafana admin. Overridable because a PMM started outside
# `./om start pmm` may have had its password changed on first login.
PMM_USER="${OM_PMM_USER:-admin}"
PMM_PASSWORD="${OM_PMM_PASSWORD:-admin}"

# GETs a pmm-managed API path and prints the body. A service account token in
# OM_PMM_API_KEY wins over basic auth — the same kind of token SEP/.env holds as
# PMM__API_KEY, though this deliberately does not read SEP's .env: the inventory
# is PMM's, and asking for it should not require SEP to be set up at all.
pmm_api_get() { # path -> body on stdout
  local url="https://localhost:$PMM_HTTPS_PORT$1" resp code
  local -a auth=(-u "$PMM_USER:$PMM_PASSWORD")
  [[ -n "${OM_PMM_API_KEY:-}" ]] && auth=(-H "Authorization: Bearer $OM_PMM_API_KEY")
  # -w appends the status on its own line; curl's own failure (connection
  # refused, timeout) is the non-zero exit.
  resp="$(curl -sk -m 20 -w $'\n%{http_code}' "${auth[@]}" "$url")" \
    || die "cannot reach PMM at https://localhost:$PMM_HTTPS_PORT — running? (./om start pmm)"
  code="${resp##*$'\n'}"
  resp="${resp%$'\n'*}"
  case "$code" in
    200) printf '%s' "$resp" ;;
    401|403) die "PMM rejected the credentials for $1 (HTTP $code) — set OM_PMM_USER / OM_PMM_PASSWORD, or OM_PMM_API_KEY" ;;
    *)   die "PMM returned HTTP $code for $1: $(printf '%s' "$resp" | head -c 200)" ;;
  esac
}

# Folds the map key into each record as $key, turning PMM's type-keyed map into
# the flat array the rest of the program (and any consumer) actually wants.
JQ_FLATTEN='def flatten_by($key): [ to_entries[] | .key as $t | (.value // [])[] | . + {($key): $t} ];'

# Nodes own services, services own their exporters/QAN agents, and whatever is
# left attaches to the node itself (pmm_agent, node_exporter, and friends).
# `orphans` is not decoration: it makes the tree lossless, so a service whose
# node PMM no longer lists still shows up instead of vanishing from the output.
JQ_INVENTORY_TREE="$JQ_FLATTEN"'
  ($nodes    | flatten_by("node_type"))    as $N |
  ($services | flatten_by("service_type")) as $S |
  ($agents   | flatten_by("agent_type"))   as $A |
  # agent_id -> node_id, the mapping only pmm_agent records carry.
  ([ $A[] | select(.agent_type == "pmm_agent") | {key: .agent_id, value: .runs_on_node_id} ]
   | from_entries) as $node_of |
  # Give every agent a node_id: its own if it is a pmm_agent, else its parents.
  ([ $A[] | . + {node_id: (.runs_on_node_id // $node_of[.pmm_agent_id // ""] // null)} ]) as $A |
  ([ $S[] | .service_id ]) as $service_ids |
  ([ $N[] | .node_id ])    as $node_ids |
  {
    pmm_server: $pmm,
    counts: {nodes: ($N | length), services: ($S | length), agents: ($A | length)},
    nodes: [ $N[] | . as $n | $n + {
      services: [ $S[] | select(.node_id == $n.node_id) | . as $s | $s + {
        agents: [ $A[] | select(.service_id == $s.service_id) ]
      } ],
      agents: [ $A[] | select(.node_id == $n.node_id and (.service_id == null)) ]
    } ],
    orphans: {
      services: [ $S[] | . as $s | select($node_ids | index($s.node_id) | not) ],
      agents: [ $A[] | . as $a | select(
        if $a.service_id != null then ($service_ids | index($a.service_id) | not)
        else ($a.node_id == null or ($node_ids | index($a.node_id) | not)) end
      ) ]
    }
  }'

cmd_inventory() {
  command -v jq >/dev/null 2>&1 || die "jq not found — install jq"
  local what="${1:-tree}"
  case "$what" in
    tree|nodes|services|agents|raw) ;;
    *) die "usage: ./om inventory [tree|nodes|services|agents|raw]" ;;
  esac

  # One endpoint is enough for the flat views; only the tree needs the join.
  case "$what" in
    nodes)    pmm_api_get /v1/inventory/nodes    | jq "$JQ_FLATTEN"'flatten_by("node_type")';    return ;;
    services) pmm_api_get /v1/inventory/services | jq "$JQ_FLATTEN"'flatten_by("service_type")'; return ;;
    agents)   pmm_api_get /v1/inventory/agents   | jq "$JQ_FLATTEN"'flatten_by("agent_type")';   return ;;
  esac

  local nodes services agents
  nodes="$(pmm_api_get /v1/inventory/nodes)"
  services="$(pmm_api_get /v1/inventory/services)"
  agents="$(pmm_api_get /v1/inventory/agents)"

  if [[ "$what" == "raw" ]]; then
    jq -n --argjson nodes "$nodes" --argjson services "$services" --argjson agents "$agents" \
      '{nodes: $nodes, services: $services, agents: $agents}'
    return
  fi
  jq -n --arg pmm "https://localhost:$PMM_HTTPS_PORT" \
        --argjson nodes "$nodes" --argjson services "$services" --argjson agents "$agents" \
        "$JQ_INVENTORY_TREE"
}

# ---------------------------------------------------------------------------
# uris — the HTTP surface each component exposes beyond its landing page
# ---------------------------------------------------------------------------
#
# One table, two consumers: `./om status` prints a component's entries beneath
# it while it is up, `./om urls` prints the lot whatever is running. The PMM
# paths are the ones its nginx actually serves — see
# pmm/build/ansible/roles/nginx/files/conf.d/pmm.conf; VictoriaMetrics runs with
# --http.pathPrefix=/prometheus (managed/services/supervisord/supervisord.go),
# which is why vmui hangs off /prometheus and not /victoriametrics.
#
# Deliberately absent: the ClickHouse (8123/9000) and VictoriaMetrics (9090)
# host ports from pmm/docker-compose.dev.yml. They are published, but both
# daemons bind 127.0.0.1 *inside* the container, so connecting to them from the
# host just gets a reset — reach them with `docker exec pmm-server` instead.
component_uris() { # comp -> "label<TAB>uri" lines
  local pmm="https://localhost:$PMM_HTTPS_PORT"
  local sep="http://localhost:$SEP_BACKEND_PORT"
  case "$1" in
    pmm)
      printf '%s\t%s\n' \
        "Grafana"         "$pmm/graph/" \
        "PMM UI"          "$pmm/pmm-ui/" \
        "Query Analytics" "$pmm/graph/d/pmm-qan/" \
        "vmui"            "$pmm/prometheus/vmui/" \
        "VM targets"      "$pmm/prometheus/targets" \
        "VMAlert rules"   "$pmm/prometheus/rules" \
        "VMAlert alerts"  "$pmm/prometheus/alerts" \
        "Swagger UI"      "$pmm/swagger/" \
        "PostgreSQL"      "postgres://$POM_DB_USER@$POM_DB_HOST:$POM_DB_PORT/$POM_DB_NAME" \
        "Delve (headless)" "127.0.0.1:2345"
      ;;
    sep-backend)
      # /docs and /redoc are 404 by design (SEP/app/main.py): the top-level app
      # disables them so the unified /api/docs is the one Swagger UI to use.
      printf '%s\t%s\n' \
        "API root"      "$sep/" \
        "Swagger UI"    "$sep/api/docs" \
        "OpenAPI JSON"  "$sep/api/openapi.json" \
        "Inventory API" "$sep/api/inventory/docs" \
        "Tasks API"     "$sep/api/tasks/docs"
      ;;
    sep-frontend)
      printf '%s\t%s\n' "Dev server" "http://localhost:$SEP_FRONTEND_PORT/"
      ;;
  esac
}

print_uris() { # comp — indented under whatever status line just went out
  local label uri
  while IFS=$'\t' read -r label uri; do
    [[ -n "$label" ]] || continue
    printf '    %s%-16s%s %s\n' "$C_DIM" "$label" "$C_RESET" "$uri"
  done < <(component_uris "$1")
}

comp_up() { # comp -> 0 when it is running
  case "$1" in
    pmm)   [[ "$(docker inspect -f '{{.State.Running}}' "$PMM_CONTAINER" 2>/dev/null)" == "true" ]] ;;
    sep-backend)  port_busy "$SEP_BACKEND_PORT" ;;
    sep-frontend) port_busy "$SEP_FRONTEND_PORT" ;;
    *) return 1 ;;
  esac
}

cmd_urls() {
  local only=("$@")
  [[ ${#only[@]} -gt 0 ]] || only=(pmm sep-backend sep-frontend)
  local comp
  for comp in "${only[@]}"; do
    case "$comp" in
      pmm|sep-backend|sep-frontend) ;;
      backend)  comp=sep-backend ;;
      frontend) comp=sep-frontend ;;
      *) die "no URIs known for '$comp' (pmm|sep-backend|sep-frontend)" ;;
    esac
    if comp_up "$comp"; then info "$comp"; else info "$comp $C_DIM(stopped)$C_RESET"; fi
    print_uris "$comp"
  done
  echo
  dim "PMM and Grafana: admin/admin — the same credentials cover vmui and Swagger"
  dim "SEP /api/docs: Authorize with \`./om discovery token\` to run requests from the page"
}

# ---------------------------------------------------------------------------
# status / logs
# ---------------------------------------------------------------------------

status_line() { # label, up(0/1), detail
  if [[ "$2" == "0" ]]; then
    printf '  %s●%s %-20s %s\n' "$C_GREEN" "$C_RESET" "$1" "$3"
  else
    printf '  %s○%s %-20s %s%s%s\n' "$C_DIM" "$C_RESET" "$1" "$C_DIM" "$3" "$C_RESET"
  fi
}

cmd_status() {
  info "Components"

  if [[ "$(docker inspect -f '{{.State.Running}}' "$PMM_CONTAINER" 2>/dev/null)" == "true" ]]; then
    local ui_note="image bundle — no SEP apps, run './om build ui'"
    pmm_ui_has_sep && ui_note="working tree UI, SEP apps included"
    status_line pmm 0 "https://localhost:$PMM_HTTPS_PORT (container $PMM_CONTAINER)"
    dim "ui: $ui_note"
    print_uris pmm
  else
    status_line pmm 1 "stopped"
  fi

  local comp pid port
  for comp in sep-backend sep-frontend; do
    case "$comp" in
      sep-backend)  port=$SEP_BACKEND_PORT ;;
      sep-frontend) port=$SEP_FRONTEND_PORT ;;
    esac
    if pid="$(read_pid "$comp")"; then
      local listen="not listening yet"
      port_busy "$port" && listen="http://localhost:$port"
      status_line "$comp" 0 "pid $pid — $listen"
      # Only sep-backend has a surface worth expanding here; sep-frontend serves
      # one page, already spelled out on the status line above.
      # `|| true`: under set -e a false tail command in an if-branch exits the script.
      [[ "$comp" == sep-backend ]] && port_busy "$port" && print_uris "$comp" || true
    elif port_busy "$port"; then
      # Something owns the port that om did not start — e.g. a backend launched by
      # hand with `make dev-backend`. Reporting "stopped" here would be misleading.
      status_line "$comp" 0 "http://localhost:$port (not started by om)"
      [[ "$comp" == sep-backend ]] && print_uris "$comp" || true
    else
      status_line "$comp" 1 "stopped"
    fi
  done

  # PSMDB clusters from psmdb/compose.yaml. Reported only when the directory
  # exists, so a checkout without it looks unchanged.
  if [[ -d "$PSMDB_DIR" ]]; then
    echo
    info "PSMDB clusters (psmdb/compose.yaml)"
    local p up expected
    for p in "${PSMDB_PROFILES[@]}"; do
      case "$p" in
        standalone|replicaset-single) expected=1 ;;
        replicaset-cluster)   expected=3 ;;
        sharded-cluster)      expected=11 ;;
      esac
      up="$(psmdb_running "$p")"
      if [[ "${up:-0}" -gt 0 ]]; then
        status_line "$p" 0 "${up}/${expected} container(s) up"
        local uri node
        if uri="$(psmdb_uri "$p")"; then
          # Labelled, because the two are not interchangeable and the first one does
          # not work from a terminal on this machine -- which is exactly the mistake
          # an unlabelled connection string invites.
          dim "on pmm's network  $uri"
          node="$(psmdb_first_node "$p")"
          [[ -n "$node" ]] && \
            dim "from this host    docker exec -it $node sh -c 'mongosh \"\$(cat /root/.mongodb_uri)\"'"
        fi
      else
        status_line "$p" 1 "stopped"
      fi
    done

    # The client hosts. No URI line, deliberately: the whole point of these is
    # that there is nothing on them to connect to. What is worth printing is
    # which of the pool are up, since they are spawned individually.
    echo
    info "PMM-client-only hosts (psmdb/compose.yaml)"
    local cup names
    cup="$(psmdb_running "$CLIENT_PROFILE")"
    if [[ "${cup:-0}" -gt 0 ]]; then
      status_line "$CLIENT_PROFILE" 0 "${cup}/${CLIENT_NODES} host(s) up - pmm-agent + Nomad, no database"
      names="$(docker ps --format '{{.Names}}' | grep -E "^$CLIENT_PROFILE-" | sort | paste -sd' ' -)"
      [[ -n "$names" ]] && dim "$names"
    else
      status_line "$CLIENT_PROFILE" 1 "stopped - ./om start $(client_node_names | head -1)"
    fi
  fi

  echo
  dim "logs: ./om logs <pmm|sep-backend|sep-frontend|<cluster>|pmm-client> [-f]"
  dim "urls: ./om urls [comp...] — the same list for stopped components too"
  # Every line below is about reaching a *database*, so it is gated on a database
  # topology being up rather than on any node: with only client hosts running there
  # are no URIs above for "the first is for SEP" to refer to.
  if [[ -d "$PSMDB_DIR" ]] && [[ -n "$(psmdb_up_profiles | grep -vx "$CLIENT_PROFILE")" ]]; then
    # The network URIs name containers, which only resolve inside the network. A GUI
    # client on this machine can still reach one node directly: container IPs are
    # routable from the host, but only with directConnection=true -- without it the
    # driver asks the set for its members, gets those same container names back, and
    # fails on them instead.
    dim "the first is for SEP, a payload, another container — its names do not resolve"
    dim "here unless you add them:  ./om hosts [--write]"
    dim "for a GUI client:  docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <node>"
    dim "                   then mongodb://root:root-password@<ip>:27017/?authSource=admin&directConnection=true"
  fi
}

cmd_logs() {
  local comp="${1:-}"; shift || true
  local follow=""
  [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]] && follow=1
  case "$comp" in
    pmm)
      docker inspect "$PMM_CONTAINER" >/dev/null 2>&1 \
        || die "$PMM_CONTAINER does not exist — ./om start pmm first"
      if [[ -n "$follow" ]]; then docker logs -f --tail=200 "$PMM_CONTAINER"
      else docker logs --tail=200 "$PMM_CONTAINER"; fi ;;
    standalone|replicaset-single|replicaset-cluster|sharded-cluster|pmm-client|pmm-client-node[0-9][0-9])
      # No om-managed log file: these are compose services, so defer to compose.
      # A single client node works here too, because its own name is also a
      # compose profile - see the pmm-client block in psmdb/compose.yaml.
      if [[ -n "$follow" ]]; then psmdb_compose --profile "$comp" logs -f --tail=200
      else psmdb_compose --profile "$comp" logs --tail=200; fi ;;
    sep-backend|sep-frontend)
      local f; f="$(log_file "$comp")"
      [[ -f "$f" ]] || die "no log yet for $comp"
      if [[ -n "$follow" ]]; then tail -f "$f"; else tail -n 200 "$f"; fi ;;
    "") die "usage: ./om logs <pmm|sep-backend|sep-frontend|replicaset-cluster|replicaset-single|standalone|sharded-cluster|pmm-client[-nodeNN]> [-f]" ;;
    *)  die "unknown component '$comp'" ;;
  esac
}

# ---------------------------------------------------------------------------
# pom (POM: inspect a run across Postgres, VictoriaMetrics and Tasks)
# ---------------------------------------------------------------------------

# SEP's three databases all point at PMM's embedded PostgreSQL, so this is the
# one connection for inventory, tasks and POM's own tables alike.
POM_DB_HOST=127.0.0.1
POM_DB_PORT=5432
POM_DB_NAME=sep
POM_DB_USER=sep


# Reads the SEP database password from SEP/.env. `head -1`: several *__DATABASE__
# PASSWORD keys are set (SEP__, INVENTORY__, TASKS__) and they share one value.
pom_db_password() {
  [[ -f "$SEP_DIR/.env" ]] || die "SEP/.env missing — run ./om setup first"
  grep -oP '(?<=DATABASE__PASSWORD=).*' "$SEP_DIR/.env" | head -1
}

# Reads the PMM API key from SEP/.env. `tail -1`, NOT head: .env carries more than
# one PMM__API_KEY line and python-dotenv takes the last one. Taking the first (or
# worse, grepping without picking one) yields a key SEP is not using, and every
# request silently comes back empty or unauthorized.
pom_pmm_key() {
  [[ -f "$SEP_DIR/.env" ]] || die "SEP/.env missing — run ./om setup first"
  grep -oP '(?<=PMM__API_KEY=).*' "$SEP_DIR/.env" | tail -1
}

# SEP derives the internal token from SECRET_KEY when SEP_INTERNAL_TOKEN is unset, so
# it is always available and always matches what the running backend accepts.
sep_token() {
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  ( cd "$SEP_DIR" && "$SEP_DIR/venv/bin/python" -c \
      'from app.core.security import get_internal_token; print(get_internal_token() or "")' \
  ) 2>/dev/null || die "could not derive the internal token"
}

# ---------------------------------------------------------------------------
# the four ways to reach POM's data
# ---------------------------------------------------------------------------
#
# POM is split across both products, so there are two stores and two APIs:
#
#   sep_psql   SEP's database      pom_discovery_run  — what the probe collected
#   pmm_psql   pmm-managed's       pom_runs/pom_snapshots — the topology documents
#   pmm_api    /v1/pom             what the UI reads
#   sep_api    /api/apps/<app>     any SEP app, discovery being the first
#
# Both psql helpers run inside the pmm-server container rather than over the
# published port: the databases live there, the socket needs no password, and it
# keeps a host psql client from being a prerequisite.

sep_psql() {
  docker exec -i "$PMM_CONTAINER" psql "postgres://${POM_DB_USER}@127.0.0.1/${POM_DB_NAME}" "$@" \
    || die "cannot reach SEP's database in $PMM_CONTAINER — is pmm running?"
}

pmm_psql() {
  docker exec -i "$PMM_CONTAINER" psql "postgres://pmm-managed@127.0.0.1/pmm-managed" "$@" \
    || die "cannot reach pmm-managed's database in $PMM_CONTAINER — is pmm running?"
}

# GETs (or otherwise calls) a path under pmm-managed's POM API. Extra arguments go
# straight to curl, so a write is `pom api discovery/runs -X POST -d '{}'`.
pmm_api() {
  local path="${1#/}"; shift || true
  curl -sk -m 30 -H "Authorization: Bearer $(pom_pmm_key)" \
    "https://127.0.0.1:${PMM_HTTPS_PORT}/v1/pom/${path}" "$@"
}

# The same for any SEP app's API. `app` is the module name as registered in
# settings.yaml, so this keeps working for the upgrade and restart apps to come.
sep_api() {
  local app="$1" path="${2#/}"; shift 2 || true
  curl -s -m 30 -H "Authorization: Bearer $(sep_token)" \
    "http://127.0.0.1:8000/api/apps/${app}/${path}" "$@"
}

# Pretty-prints a JSON body, or passes it through when it is not JSON (an error page,
# an empty body) so a failure is readable rather than swallowed by a parse error.
json_out() {
  python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    print(json.dumps(json.loads(raw), indent=2))
except ValueError:
    sys.stdout.write(raw if raw.strip() else "(empty response)\n")'
}

# ---------------------------------------------------------------------------
# pom — the PMM side: topology documents derived from inventory + VictoriaMetrics
# ---------------------------------------------------------------------------

pom_cmd_show() {
  info "POM topology (pmm-managed)"
  pmm_api topology | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit("  could not read /v1/pom/topology — is pmm-managed up with the POM service?")
s, snap = d["summary"], d["snapshot"]
gen, obs, stale = snap["generated_at"], snap["observed_at"], snap["stale"]
run, origin = snap["run_id"], d.get("origin_node")
print("  generated %s  observed %s  stale=%s" % (gen, obs, stale))
print("  run %s  origin %s" % (run, origin))
print("  %d service(s): %d up, %d down  |  %d cluster(s) in %d environment(s)" % (
    s["services_total"], s["services_up"], s["services_down"], s["clusters"], s["environments"]))
print("  roles: " + ", ".join("%s=%d" % kv for kv in sorted(s["by_process_role"].items())))
'
  echo
  pom_cmd_topology
}

# One row per service, which is what you actually want to look at: the document is
# nested environment -> cluster -> service and unreadable as raw JSON at any size.
pom_cmd_topology() {
  pmm_api topology | python3 -c '
import json, sys
d = json.load(sys.stdin)
rows = [(e.get("env_name") or "-", c.get("name") or "-", s)
        for e in d["environments"] for c in e["clusters"] for s in c["services"]]
if not rows:
    sys.exit("  no MongoDB services in the document")
def g(v, dash="-"):
    return dash if v is None else str(v)
def num(v):
    return "-" if v is None or v == -1 else f"{float(v):.0f}"
hdr = ("SERVICE", "CLUSTER", "ROLE", "STATE", "STATUS", "VERSION", "INSTALLED", "CPU%", "FREE%", "LAG", "OPLOG")
w = [max(len(h), *(len(x) for x in col)) for h, col in zip(hdr, zip(*[
    (s["service_name"], cl, s["process_role"], g(s["state"]), s["status"], g(s["version"]),
     g(s.get("installed_version")), num(s["cpu_usage_percent"]), num(s["connections_free_percent"]),
     num(s["replication_lag_seconds"]), num(s["oplog_window_seconds"]))
    for _, cl, s in rows]))]
print("  " + "  ".join(h.ljust(n) for h, n in zip(hdr, w)))
for _, cl, s in rows:
    cells = (s["service_name"], cl, s["process_role"], g(s["state"]), s["status"], g(s["version"]),
             g(s.get("installed_version")), num(s["cpu_usage_percent"]), num(s["connections_free_percent"]),
             num(s["replication_lag_seconds"]), num(s["oplog_window_seconds"]))
    print("  " + "  ".join(c.ljust(n) for c, n in zip(cells, w)))
'
}

pom_cmd_raw() { pmm_api topology | json_out; }

pom_cmd_runs() {
  info "POM collection runs (pmm-managed)"
  pmm_api "discovery/runs?limit=${1:-15}" | python3 -c '
import json, sys
runs = json.load(sys.stdin).get("runs") or []
if not runs:
    sys.exit("  no runs recorded yet — trigger one with ./om pom run")
for r in runs:
    c = r["counts"]
    src = " ".join("%s=%s" % (x["source"], x["status"]) for x in r.get("sources") or [])
    print("  %s  %-8s total=%-3d up=%-3d stale=%-3d %s" % (
        r["started_at"][11:19], r["status"], c["services_total"],
        c["probes_ok"], c["services_stale"], src))
    for e in r.get("errors") or []:
        print("      ! [%s] %s: %s" % (e["scope"], e["code"], e["message"][:96]))
'
}

pom_cmd_run() {
  info "Triggering a POM collection"
  # Synchronous on the PMM side: inventory is a local read and VictoriaMetrics is on
  # localhost, so this answers with a terminal status rather than an id to poll. It
  # does NOT probe -- on-host facts come from the discovery sweep, ./om discovery run.
  local body; body="$(pmm_api discovery/runs -X POST -d '{}')"
  printf '%s\n' "$body" | json_out
  echo
  pom_cmd_runs 1
}

pom_cmd_sql() {
  [[ $# -gt 0 ]] || die "usage: ./om pom sql <query>   (tables: pom_runs, pom_snapshots)"
  pmm_psql -c "$*"
}

pom_cmd_api() {
  [[ $# -gt 0 ]] || die "usage: ./om pom api <path> [curl args]   e.g. ./om pom api topology"
  local path="$1"; shift
  pmm_api "$path" "$@" | json_out
}

cmd_pom() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show)     pom_cmd_show "$@" ;;
    topology) pom_cmd_topology "$@" ;;
    raw)      pom_cmd_raw "$@" ;;
    runs)     pom_cmd_runs "$@" ;;
    run)      pom_cmd_run "$@" ;;
    sql)      pom_cmd_sql "$@" ;;
    api)      pom_cmd_api "$@" ;;
    *) die "unknown pom subcommand '$sub' (show|topology|raw|runs|run|sql|api)" ;;
  esac
}

# ---------------------------------------------------------------------------
# discovery — the SEP side: on-host facts no metric carries
# ---------------------------------------------------------------------------

disc_cmd_show() {
  info "POM discovery (SEP app pom_discovery)"
  sep_api pom_discovery facts | python3 -c '
import json, sys
from collections import Counter
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit("  could not read the app — is sep-backend up and pom_discovery enabled?")
if not d.get("run_id"):
    sys.exit("  no sweep has completed yet — trigger one with ./om discovery run")
c = d.get("counts") or {}
print("  sweep %s  %s  %ds old  stale=%s" % (
    d["run_id"], d["status"], int(d["age_seconds"]), d["stale"]))
if d.get("error"):
    print("  error: %s" % d["error"])
print("  %s service(s): %s resolved, %s orphaned, %s answered" % (
    c.get("services_total"), c.get("services_resolved"),
    c.get("services_orphaned"), c.get("services_answered")))
facts = d.get("facts") or []
print("  %d fact(s) over %d service(s)" % (len(facts), len({f["service_id"] for f in facts})))
counts = sorted(Counter(f["field"] for f in facts).items())
print("  fields: " + ", ".join("%s=%d" % kv for kv in counts))
'
}

# The facts themselves, one service per block, labelled with the service name.
#
# The names come from PMM: discovery stores facts against PMM's service UUID, because
# that is the only key the consumer can join on, so on its own it can only show you
# UUIDs. Resolving them here is what makes `facts standalone` -- the obvious thing to
# type -- work at all. The optional argument matches the name or any field value.
disc_cmd_facts() {
  local names
  names="$(pmm_api topology 2>/dev/null || true)"
  sep_api pom_discovery facts | FILTER="${1:-}" NAMES="$names" python3 -c '
import json, os, sys
from collections import defaultdict

d = json.load(sys.stdin)
facts = d.get("facts") or []
if not facts:
    sys.exit("  no facts stored — the last sweep collected nothing")

# id -> name, best effort: without PMM the blocks are still listed, just by UUID.
names = {}
try:
    topo = json.loads(os.environ.get("NAMES") or "{}")
    for env in topo.get("environments") or []:
        for cluster in env.get("clusters") or []:
            for svc in cluster.get("services") or []:
                if svc.get("service_id"):
                    names[svc["service_id"]] = svc["service_name"]
except ValueError:
    pass

by_service = defaultdict(dict)
for f in facts:
    by_service[f["service_id"]][f["field"]] = f["value"]

needle = os.environ.get("FILTER", "").lower()
shown = 0
for sid, fields in sorted(by_service.items(), key=lambda kv: names.get(kv[0], kv[0])):
    name = names.get(sid)
    label = "%s  (%s)" % (name, sid) if name else sid
    blob = " ".join([label] + ["%s=%s" % kv for kv in fields.items()]).lower()
    if needle and needle not in blob:
        continue
    shown += 1
    print("  " + label)
    for k, v in sorted(fields.items()):
        print("      %-20s %s" % (k, v))
if not shown:
    sys.exit("  nothing matched %r" % needle)
'
}

disc_cmd_runs() {
  info "Probe sweeps (SEP)"
  sep_api pom_discovery "runs?limit=${1:-15}" | python3 -c '
import json, sys
runs = json.load(sys.stdin)
if not runs:
    sys.exit("  no sweeps recorded yet — trigger one with ./om discovery run")
for r in runs:
    c = r["counts"]
    print("  %s  %-8s resolved=%-3d answered=%-3d orphaned=%-3d facts=%d" % (
        r["started_at"][11:19], r["status"], c["services_resolved"],
        c["services_answered"], c["services_orphaned"], r["facts_collected"]))
    if r.get("error"):
        print("      ! %s" % r["error"][:100])
'
}

disc_cmd_run() {
  info "Queueing a probe sweep"
  dim "dispatches a Nomad job per executor host; tens of seconds, not instant"
  sep_api pom_discovery runs -X POST | json_out
  echo
  dim "watch it with: ./om discovery runs"
}

disc_cmd_sql() {
  [[ $# -gt 0 ]] || die "usage: ./om discovery sql <query>   (table: pom_discovery_run)"
  sep_psql -c "$*"
}

disc_cmd_api() {
  [[ $# -gt 0 ]] || die "usage: ./om discovery api <path> [curl args]   e.g. ./om discovery api facts"
  local path="$1"; shift
  sep_api pom_discovery "$path" "$@" | json_out
}

disc_cmd_sync() {
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  info "Syncing SEP inventory from PMM"
  dim "run this after rebuilding a cluster, or every service maps as orphaned"
  ( cd "$SEP_DIR" && "$SEP_DIR/venv/bin/python" - <<'PY'
import asyncio, logging, sys
logging.basicConfig(level=logging.WARNING, stream=sys.stdout)
from app.sep.apps.inventory.sync import run_scheduled_inventory_sync
asyncio.run(run_scheduled_inventory_sync("app.sep.sync.syncers.pmm.PMMSyncer"))
PY
  ) || die "the sync failed — see the traceback above"
  ok "inventory synced"
  sep_psql -c "
    select coalesce(cluster, '-') as cluster, count(*) as services
    from service where type = 'MONGODB' group by 1 order by 1"
}

cmd_discovery() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show)  disc_cmd_show "$@" ;;
    facts) disc_cmd_facts "$@" ;;
    runs)  disc_cmd_runs "$@" ;;
    run)   disc_cmd_run "$@" ;;
    sync)  disc_cmd_sync "$@" ;;
    sql)   disc_cmd_sql "$@" ;;
    api)   disc_cmd_api "$@" ;;
    token) sep_token ;;
    *) die "unknown discovery subcommand '$sub' (show|facts|runs|run|sync|sql|api|token)" ;;
  esac
}

# Any SEP app's API, for the apps that come after discovery.
cmd_sep_api() {
  [[ $# -ge 2 ]] || die "usage: ./om sep-api <app> <path> [curl args]   e.g. ./om sep-api pom_discovery facts"
  local app="$1" path="$2"; shift 2
  sep_api "$app" "$path" "$@" | json_out
}

# ---------------------------------------------------------------------------
# component dispatch
# ---------------------------------------------------------------------------

# Populates the global COMPONENTS array. Deliberately NOT echo-and-capture: a
# `die` inside a process substitution or $( ) only kills the subshell, so a bad
# component name would print an error and then be silently ignored, leaving the
# caller to act on an empty list.
COMPONENTS=()
expand_components() {
  COMPONENTS=()
  if [[ $# -eq 0 ]]; then
    COMPONENTS=(pmm sep-backend sep-frontend)
    return 0
  fi
  local a
  for a in "$@"; do
    case "$a" in
      all)          COMPONENTS+=(pmm sep-backend sep-frontend) ;;
      sep)          COMPONENTS+=(sep-backend sep-frontend) ;;
      pmm)          COMPONENTS+=(pmm) ;;
      sep-backend|backend)   COMPONENTS+=(sep-backend) ;;
      sep-frontend|frontend) COMPONENTS+=(sep-frontend) ;;
      # `psmdb` is spelled both ways because it is what the directory is called.
      # It stays the four *database* topologies: the client hosts are not a
      # cluster and nobody asking for "the clusters" means them.
      clusters|psmdb)        COMPONENTS+=("${PSMDB_PROFILES[@]}") ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) COMPONENTS+=("$a") ;;
      # The whole pool, or one host of it by name.
      pmm-client|pmm-clients|clients) COMPONENTS+=("$CLIENT_PROFILE") ;;
      *)
        client_node_name "$a" || die "unknown component '$a' (pmm|sep-backend|sep-frontend|sep|all|clusters|standalone|replicaset-single|replicaset-cluster|sharded-cluster|pmm-client|$(client_node_names | paste -sd'|' -))"
        COMPONENTS+=("$a")
        ;;
    esac
  done
}

# `./om start` and `./om stop` with no arguments act on the whole machine, clusters
# included, and the clusters they act on are the ones that were up last time. Naming
# components explicitly bypasses all of that and means exactly what it says.
cmd_start() {
  if [[ $# -eq 0 ]]; then
    local remembered=() line
    while read -r line; do [[ -n "$line" ]] && remembered+=("$line"); done < <(psmdb_remembered)
    if [[ ${#remembered[@]} -gt 0 ]]; then
      dim "clusters from the last ./om stop: ${remembered[*]}"
      set -- pmm sep-backend sep-frontend "${remembered[@]}"
    fi
  fi
  expand_components "$@"
  local c
  for c in "${COMPONENTS[@]}"; do
    case "$c" in
      pmm)          start_pmm ;;
      sep-backend)  start_sep_backend ;;
      sep-frontend) start_sep_frontend ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) start_sandbox_node "$c" ;;
      pmm-client|pmm-client-node[0-9][0-9]) start_sandbox_node "$c" ;;
    esac
  done
  echo
  cmd_status
}

cmd_stop() {
  if [[ $# -eq 0 ]]; then
    # Record before stopping anything: afterwards there is nothing left to look at.
    psmdb_remember_up
    local running=() line
    while read -r line; do [[ -n "$line" ]] && running+=("$line"); done < <(psmdb_remembered)
    [[ ${#running[@]} -gt 0 ]] && dim "clusters to restore on the next ./om start: ${running[*]}"
    set -- pmm sep-backend sep-frontend "${running[@]}"
  fi
  expand_components "$@"
  # Reverse order so dependents go down before what they depend on.
  local comps=() i
  for (( i=${#COMPONENTS[@]}-1; i>=0; i-- )); do comps+=("${COMPONENTS[$i]}"); done
  local c
  for c in "${comps[@]}"; do
    case "$c" in
      pmm)          stop_pmm ;;
      sep-backend)  info "sep-backend: stopping";  stop_native sep-backend ;;
      sep-frontend) info "sep-frontend: stopping"; stop_native sep-frontend ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) stop_sandbox_node "$c" ;;
      pmm-client|pmm-client-node[0-9][0-9]) stop_sandbox_node "$c" ;;
    esac
  done
}

cmd_restart() {
  cmd_stop "$@"
  echo
  cmd_start "$@"
}

# Prints the header comment block as the help text: from the first line of the
# block to the blank line that ends it, so it stays right as the block grows.
usage() { sed -n '3,/^$/p' "${BASH_SOURCE[0]}" | sed "s/^# \{0,1\}//"; }

main() {
  local cmd="${1:-}"; shift || true
  # Before anything, so every command works from one rendered file. Cheap, and it
  # has to happen here rather than in start_sep_backend: migrations, the beat
  # bootstrap and the inventory sync all build settings in their own processes.
  render_sep_settings
  case "$cmd" in
    setup)   cmd_setup "$@" ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    status)  cmd_status ;;
    logs)    cmd_logs "$@" ;;
    build)   cmd_build "$@" ;;
    pom)     cmd_pom "$@" ;;
    discovery) cmd_discovery "$@" ;;
    sep-api) cmd_sep_api "$@" ;;
    ports)   cmd_ports ;;
    urls|uris) cmd_urls "$@" ;;
    hosts)   cmd_hosts "$@" ;;
    inventory) cmd_inventory "$@" ;;
    doctor)  cmd_doctor ;;
    ""|-h|--help|help) usage ;;
    *) err "unknown command '$cmd'"; echo; usage; exit 1 ;;
  esac
}

main "$@"
