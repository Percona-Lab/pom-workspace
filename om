#!/usr/bin/env bash
#
# om — OpenManager workspace orchestrator.
#
# Runs SEP from its repo (natively, so edits are live), PMM from its repo (in
# PMM's own devcontainer, so `om build pmm` compiles your Go changes), and the
# PSMDB clusters from psmdb/compose.yaml.
#
#   ./om setup              one-time bootstrap (idempotent, safe to re-run)
#   ./om start [comp...]    start components (no args: all, plus the clusters
#                           that were up when you last ran a bare ./om stop)
#   ./om stop [comp...]     stop components (no args: all, clusters included)
#   ./om restart [comp...]  stop then start
#   ./om status             what is running, and on which ports
#   ./om logs <comp> [-f]   show logs
#   ./om build pmm          compile the PMM working tree into the running server
#   ./om build ui           rebuild pmm/ui and deploy it into the running server
#                           (./om start pmm rebuilds both automatically when the
#                           container is serving the image's stale binary/bundle,
#                           which a container recreate always leaves it doing)
#   ./om pom [sub]          POM in PMM: topology documents (see below)
#   ./om discovery [sub]    POM discovery in SEP: on-host facts (see below)
#   ./om sep-api <app> <p>  call any SEP app's API
#   ./om inventory [view]   PMM's inventory as JSON on stdout, nodes/services/
#                           agents joined into one document. Views: tree
#                           (default), nodes, services, agents, raw
#   ./om urls [comp...]     every URI a component serves (vmui, Swagger, ...)
#   ./om hosts [--write]    /etc/hosts entries so the cluster URIs resolve here
#                           (prints by default; --write needs sudo, --remove undoes)
#   ./om ports              what each stack publishes onto the host
#   ./om doctor             check prerequisites only
#
# POM is split across both products. pmm-managed derives the topology document
# from PMM's own inventory and VictoriaMetrics; SEP's pom_discovery app probes the
# database hosts over Nomad for the facts no metric carries, and PMM pulls them.
# There is a command group per side, and each reaches both its store and its API.
#
# POM in PMM (tables pom_runs / pom_snapshots, API /v1/pom):
#
#   ./om pom                overview: the document, plus a row per service
#   ./om pom topology       just the per-service table
#   ./om pom raw            the document as JSON
#   ./om pom runs [n]       collection runs, with each source's verdict
#   ./om pom run            trigger a collection (fast; does NOT probe)
#   ./om pom sql <query>    psql against pom_runs / pom_snapshots
#   ./om pom api <path>     any /v1/pom path, e.g. `api discovery/runs -X POST -d {}`
#
# POM discovery in SEP (table pom_discovery_run, API /api/apps/pom_discovery):
#
#   ./om discovery          overview: the last sweep and what it collected
#   ./om discovery facts [f] the stored facts, per service; [f] filters
#   ./om discovery runs [n] sweeps, newest first
#   ./om discovery run      queue a sweep (Nomad jobs; tens of seconds)
#   ./om discovery sync     refresh SEP inventory from PMM (after a rebuild)
#   ./om discovery sql <q>  psql against pom_discovery_run
#   ./om discovery api <p>  any /api/apps/pom_discovery path
#   ./om discovery token    bearer token for /api/docs Authorize and for curl
#
# Components: pmm, sep-backend, sep-frontend, the PSMDB clusters:
#             standalone, replicaset-single, replicaset-cluster, sharded-cluster
#             and pmm-client - hosts carrying a PMM client and no database at
#             all, spawned one at a time as pmm-client-node00 .. node02
#             (psmdb/compose.yaml; each needs pmm running first)
# Groups:     sep (= sep-backend + sep-frontend), clusters (= all four PSMDB
#             topologies, also spelled psmdb), all
#
# With NO components, start and stop act on the whole machine and remember each
# other: `./om stop` notes which clusters were up and takes them down with the
# rest, and the next `./om start` brings that same set back. Naming components
# explicitly does exactly what it says and leaves the memory alone.
#
#   ./om stop                               everything down, clusters remembered
#   ./om start                              everything back, same clusters
#   ./om start pmm sep replicaset-cluster   a full stack with a 3-node replica set
#   ./om stop replicaset-cluster            containers down, data volumes kept
#   ./om start pmm-client-node00            one bare host, no database on it

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEP_DIR="$ROOT/SEP"
PMM_DIR="$ROOT/pmm"
HARNESS_DIR="$ROOT/harness"
STATE_DIR="$ROOT/.om"

# SEP's own settings.yaml deep-merged with this workspace's development overrides,
# written to harness/ and handed to SEP as SETTINGS_FILE (PreEnvSettings reads it,
# app/core/config.py). That keeps the SEP checkout at upstream's file, so its branch
# carries POM code alone, exactly as harness/pmm.conf does for pmm.
#
# Rendered from SEP's current settings.yaml on every run rather than snapshotted, so
# an upstream change to any setting this workspace does not override is picked up
# instead of silently pinned.
#
# Exported for every child process: uvicorn, celery, alembic and the ad-hoc python
# below all construct settings, and they must all read the same file.
SEP_SETTINGS="$HARNESS_DIR/sep-settings.yaml"
export SETTINGS_FILE="$SEP_SETTINGS"

render_sep_settings() {
  local src="$SEP_DIR/settings.yaml" overlay="$HARNESS_DIR/sep-settings-overlay.yaml"
  [[ -f "$src" ]] || return 0          # no submodule yet: nothing to render, not an error
  [[ -f "$overlay" ]] || die "SEP settings overlay missing at $overlay"
  python3 - "$src" "$overlay" "$SEP_SETTINGS" <<'PY' || die "rendering $SEP_SETTINGS failed"
import sys, yaml

def merge(base, over):
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            # An explicit null overwrites rather than being skipped: that is how the
            # overlay drops an auth provider the default block merged in.
            base[key] = value
    return base

src, overlay, out = sys.argv[1:4]
with open(src) as fh:
    data = yaml.safe_load(fh)
with open(overlay) as fh:
    data = merge(data, yaml.safe_load(fh))
with open(out + ".tmp", "w") as fh:
    yaml.safe_dump(data, fh, sort_keys=False, default_flow_style=False)
PY
  mv "$SEP_SETTINGS.tmp" "$SEP_SETTINGS"
}
PID_DIR="$STATE_DIR/pids"
LOG_DIR="$STATE_DIR/logs"

# PMM's dev container publishes HTTPS on this host port. 8443 (not PMM's own
# default of 443) because SEP's settings.yaml pins PMM.ENDPOINT to
# https://127.0.0.1:8443 — see om_setup_pmm.
PMM_HTTPS_PORT=8443
PMM_CONTAINER=pmm-server
# Where pmm/docker-compose.dev.yml mounts the repo inside the container.
PMM_WORKDIR=/root/go/src/github.com/percona/pmm
# nginx serves /pmm-ui from this directory (build/ansible/.../pmm.conf), and the
# dev image bakes in a bundle built from whatever `main` was at image build time.
# That prebuilt bundle predates the SEP-in-PMM work, so the two SEP apps are
# absent until the working tree is built over it — see ensure_pmm_ui.
PMM_UI_DIR=/usr/share/pmm-ui
# Records which working-tree build the container is running; see ensure_pmm_managed.
PMM_MANAGED_STAMP=/usr/sbin/.pmm-managed.om-stamp
# A string that only the working tree's router emits (lib/constants.ts ::
# SEP_MYSQL_BACKUPS_PATH). Its presence in the deployed bundle is the cheap
# "is this our UI, with the SEP apps?" probe.
PMM_UI_SEP_MARKER='sep/mysql-backups'

SEP_BACKEND_PORT=8000
SEP_FRONTEND_PORT=5174

# PSMDB clusters (psmdb/compose.yaml). Four topologies as compose profiles, each
# node one container running mongod/mongos + pbm-agent + pmm-agent, so every node
# is a SEP execution host. They join pmm_default rather than defining a network,
# so PMM has to be up first; start_psmdb enforces that rather than letting
# compose fail obscurely.
PSMDB_DIR="$ROOT/psmdb"
PSMDB_PROFILES=(standalone replicaset-single replicaset-cluster sharded-cluster)

# Remembers which cluster profiles were up when `./om stop` last ran with no
# arguments, so the matching bare `./om start` brings the same set back. Lives in
# .om/ beside logs/ and pids/, which is already gitignored: it is state about this
# machine, not about the workspace.
PSMDB_LAST_UP_FILE="$STATE_DIR/psmdb-last-up"
PSMDB_IMAGE="openmanager/psmdb-node:7.0"
PSMDB_NETWORK=pmm_default

# Hosts with a PMM client and nothing else - no mongod, no pbm-agent, none of the
# PSMDB packages. Same Dockerfile as the database nodes, built WITH_PSMDB=0, so
# they still carry pmm-agent and the Nomad client it brings: PMM lists them as
# nodes and SEP will dispatch to them. That makes them the place to develop a
# payload with no database to talk to, and the starting point for one that
# installs a database (the psmdb apt repos are enabled on them, just unused).
#
# One compose profile for the pool plus a private profile per node, so
# `./om start pmm-client` brings up all of them and `./om start pmm-client-node01`
# brings up exactly one. CLIENT_NODES must match the number of services declared
# in psmdb/compose.yaml.
CLIENT_PROFILE=pmm-client
CLIENT_IMAGE="openmanager/pmm-client-node:3"
CLIENT_NODES=3

# Everything that is a sandbox node container, database-bearing or not: what the
# /etc/hosts block covers, what a bare `./om stop` remembers, and what `./om start`
# with no arguments brings back.
NODE_PROFILES=("${PSMDB_PROFILES[@]}" "$CLIENT_PROFILE")

NODE_MIN="22.22.0"
PNPM_PIN="11.1.3"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""
fi

info() { printf '%s==>%s %s\n' "$C_BLUE$C_BOLD" "$C_RESET" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()  { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
dim()  { printf '    %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
die()  { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# small utilities
# ---------------------------------------------------------------------------

port_busy() { # port -> 0 if something is listening
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -qE "[:.]$1[[:space:]]"
  else
    curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$1/" 2>/dev/null
  fi
}

# Native components are started with setsid, so PID == process-group ID and we
# can signal the whole tree. That matters because `make dev-backend` execs
# uvicorn with reload, which forks children that would otherwise be orphaned.
pid_file()  { echo "$PID_DIR/$1.pid"; }
log_file()  { echo "$LOG_DIR/$1.log"; }

read_pid() {
  local f; f="$(pid_file "$1")"
  [[ -f "$f" ]] || return 1
  local p; p="$(cat "$f" 2>/dev/null || true)"
  [[ -n "$p" ]] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  echo "$p"
}

stop_native() { # component
  local comp="$1" pid
  if pid="$(read_pid "$comp")"; then
    # Negative PID targets the process group (see setsid note above).
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 40); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.25
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "$comp did not exit on TERM; sending KILL"
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$(pid_file "$comp")"
    ok "$comp stopped"
  else
    rm -f "$(pid_file "$comp")"
    dim "$comp was not running"
  fi
}

start_native() { # component, workdir, command...
  local comp="$1" wd="$2"; shift 2
  if read_pid "$comp" >/dev/null; then
    dim "$comp already running (pid $(read_pid "$comp"))"
    return 0
  fi
  mkdir -p "$PID_DIR" "$LOG_DIR"
  local log; log="$(log_file "$comp")"
  # Truncate so `om logs` shows only the current run.
  : > "$log"
  # `( cd .. && exec setsid ... ) &` then $! is deliberate, and the two details
  # matter:
  #   exec  — replaces the subshell image, so $! is the PID that setsid turns into
  #           the session/process-group leader. Backgrounding a plain `cd && cmd`
  #           AND-list instead makes $! the wrapper subshell, and the recorded PID
  #           then has nothing to do with the real process group.
  #   </dev/null plus the redirect applied through exec — leaves no descriptor of
  #           our own stdout held by the daemon, so a caller piping om's output
  #           (e.g. `om start | tail`) still sees EOF instead of hanging.
  # PID == PGID lets stop_native signal the whole tree; uvicorn's reloader forks
  # children that would otherwise survive and keep holding the port.
  ( cd "$wd" && exec setsid nohup "$@" </dev/null >>"$log" 2>&1 ) &
  echo $! > "$(pid_file "$comp")"
  sleep 1
  if read_pid "$comp" >/dev/null; then
    ok "$comp started (pid $(read_pid "$comp")) — logs: ./om logs $comp"
  else
    err "$comp failed to start; last lines of $log:"
    tail -n 15 "$log" >&2 || true
    return 1
  fi
}

# Sum open inotify instances across all processes. Pure bash — no bc/paste, which
# are not guaranteed to be installed.
count_inotify_instances() {
  local total=0 p n
  for p in /proc/[0-9]*; do
    n="$(ls -l "$p/fd" 2>/dev/null | grep -c inotify || true)"
    total=$(( total + ${n:-0} ))
  done
  echo "$total"
}

node_version() { command -v node >/dev/null 2>&1 && node -p 'process.versions.node' 2>/dev/null || echo ""; }

# Highest nvm-installed version satisfying NODE_MIN, or nothing. Used to tell
# "you never installed it" apart from "you installed it but this shell predates
# `nvm alias default`" — a long-lived terminal keeps whatever nvm gave it at
# startup, so the two failures look identical without this.
nvm_best_version() {
  local dir="$HOME/.nvm/versions/node" d v best=""
  [[ -d "$dir" ]] || return 1
  for d in "$dir"/v*; do
    [[ -x "$d/bin/node" ]] || continue
    v="${d##*/v}"
    [[ "$(printf '%s\n%s\n' "$NODE_MIN" "$v" | sort -V | head -1)" == "$NODE_MIN" ]] || continue
    if [[ -z "$best" || "$(printf '%s\n%s\n' "$best" "$v" | sort -V | tail -1)" == "$v" ]]; then
      best="$v"
    fi
  done
  [[ -n "$best" ]] || return 1
  echo "$best"
}

# Activate a suitable nvm node for THIS process when the calling shell has an old
# one. Without it, om refuses to touch the frontend over a problem the user has
# already fixed — they just have not opened a new terminal.
ensure_node() {
  node_ok && return 0
  local best; best="$(nvm_best_version)" || return 1
  [[ -s "$HOME/.nvm/nvm.sh" ]] || return 1
  # nvm.sh trips over `set -u`, and its output is noise here.
  set +u
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  nvm use "$best" >/dev/null 2>&1 || true
  set -u
  node_ok || return 1
  dim "using node v$(node_version) from nvm (this shell had v${1:-old}; run 'nvm use default' to fix it permanently)"
}

# Full semver compare, not just the major. Node 22.21.1 is a real trap here: the
# major satisfies "22" but SEP's engines field wants >= 22.22.0, so a major-only
# check reports OK and `pnpm install` then refuses.
node_ok() {
  local v; v="$(node_version)"
  [[ -n "$v" ]] || return 1
  [[ "$(printf '%s\n%s\n' "$NODE_MIN" "$v" | sort -V | head -1)" == "$NODE_MIN" ]]
}

# SEP's startup writes its periodic schedule into the Celery beat store, but the
# beat *scheduler* owns those tables — Alembic does not create them. So on a fresh
# checkout `make dev-backend` dies with:
#     sqlite3.OperationalError: no such table: main.celery_intervalschedule
# Running the app once with --start-celery lets the scheduler create them; after
# that a plain backend start works. Verified both ways on 2026-08-03.
#
# Returns 0 when the schema is present (or is not SQLite, i.e. managed elsewhere).
beat_schema_ready() {
  [[ -x "$SEP_DIR/venv/bin/python" ]] || return 1
  ( cd "$SEP_DIR" && "$SEP_DIR/venv/bin/python" - <<'PY' >/dev/null 2>&1
import sqlite3, sys
from app.core.config import settings
uri = str(settings.CELERY.beat_dburi or "")
if not uri.startswith("sqlite"):
    sys.exit(0)
path = uri.split("sqlite:///")[-1]
try:
    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    names = {r[0] for r in con.execute("select name from sqlite_master where type='table'")}
except Exception:
    sys.exit(1)
sys.exit(0 if "celery_intervalschedule" in names else 1)
PY
  )
}

bootstrap_beat_schema() {
  info "SEP: Celery beat schedule tables"
  if beat_schema_ready; then
    dim "already present"
    return 0
  fi
  dim "missing — starting the app with celery once so the scheduler creates them"
  mkdir -p "$PID_DIR" "$LOG_DIR"
  local log="$LOG_DIR/beat-bootstrap.log" pidf="$PID_DIR/beat-bootstrap.pid"
  : > "$log"
  # Same exec/setsid construct as start_native — see the comment there. Getting
  # this wrong records the wrapper subshell's PID, so the group kill below misses
  # and leaves an orphaned uvicorn holding port 8000.
  ( cd "$SEP_DIR" && exec setsid nohup make dev-backend START_CELERY=1 </dev/null >>"$log" 2>&1 ) &
  local pid=$!
  echo "$pid" > "$pidf"
  local done=1 i
  for i in $(seq 1 60); do
    sleep 2
    if beat_schema_ready; then done=0; break; fi
    kill -0 "$pid" 2>/dev/null || break
  done
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  sleep 2
  kill -KILL -- "-$pid" 2>/dev/null || true
  rm -f "$pidf"
  if [[ "$done" -eq 0 ]]; then
    ok "beat schedule tables created"
  else
    err "could not create the beat schedule tables; see $log"
    tail -n 15 "$log" >&2 || true
    return 1
  fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
  local fail=0
  info "Prerequisites"

  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then ok "docker $(docker --version | awk '{print $3}' | tr -d ,)"
    else err "docker is installed but the daemon is not reachable"; fail=1; fi
  else err "docker not found"; fail=1; fi

  if docker compose version >/dev/null 2>&1; then ok "docker compose plugin"
  else err "'docker compose' plugin not found (v1 'docker-compose' is not supported)"; fail=1; fi

  command -v make >/dev/null 2>&1 && ok "make" || { err "make not found"; fail=1; }
  command -v python3 >/dev/null 2>&1 && ok "python3 $(python3 -V 2>&1 | awk '{print $2}')" \
    || { err "python3 not found"; fail=1; }

  # Node/pnpm gate the SEP frontend only. PMM's UI builds inside its
  # devcontainer, which ships its own Node.
  if ensure_node "$(node_version)"; then
    ok "node v$(node_version)"
  elif [[ -n "$(node_version)" ]]; then
    err "node v$(node_version) is too old — SEP's frontend requires >= $NODE_MIN (blocks sep-frontend only)"
    if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
      dim "nvm is installed: nvm install 22 && nvm alias default 22"
      dim "then re-activate pnpm for that version: corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
    fi
    fail=1
  else
    err "node not found — required >= $NODE_MIN (blocks sep-frontend only)"; fail=1
  fi

  if command -v pnpm >/dev/null 2>&1; then ok "pnpm $(pnpm --version 2>/dev/null)"
  elif command -v corepack >/dev/null 2>&1; then
    warn "pnpm not active; enable the pinned version with:"
    dim "corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
    fail=1
  else err "neither pnpm nor corepack found"; fail=1; fi

  [[ -d "$SEP_DIR" ]] && ok "SEP/ present" || { err "SEP/ not found at $SEP_DIR"; fail=1; }
  [[ -d "$PMM_DIR" ]] && ok "pmm/ present" || { err "pmm/ not found at $PMM_DIR"; fail=1; }

  return $fail
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

om_setup_sep() {
  info "SEP: python environment"
  if [[ -x "$SEP_DIR/venv/bin/python" ]]; then
    dim "venv exists — refreshing dependencies"
  fi
  make -C "$SEP_DIR" venv
  ok "venv ready ($("$SEP_DIR/venv/bin/python" -V 2>&1))"

  info "SEP: .env"
  # Created empty rather than derived: SEP reads its overrides from here, and the
  # values that matter are per-machine secrets nothing local can generate.
  if [[ -f "$SEP_DIR/.env" ]]; then
    dim ".env exists — left untouched"
  else
    : > "$SEP_DIR/.env"
    ok ".env created (empty)"
    dim "add PMM__API_KEY=<service account token> here once PMM is running,"
    dim "plus the SEP__/INVENTORY__/TASKS__ DATABASE__PASSWORD values ./om discovery reads"
  fi

  info "SEP: database migrations"
  make -C "$SEP_DIR" migrate
  ok "sep.db / inventory.db / tasks.db up to date"

  bootstrap_beat_schema || warn "continuing; sep-backend will not start until this succeeds"

  info "SEP: frontend dependencies"
  ensure_node "$(node_version)" || true
  if node_ok && command -v pnpm >/dev/null 2>&1; then
    ( cd "$SEP_DIR/frontend" && pnpm install )
    ok "frontend node_modules ready"
  elif node_ok; then
    warn "skipped — node is fine (v$(node_version)) but pnpm is not active"
    dim "corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
  else
    local v; v="$(node_version)"
    warn "skipped — node >= $NODE_MIN required (found ${v:-none})"
    dim "sep-backend and pmm work without it; only sep-frontend is blocked"
  fi
}

om_setup_pmm() {
  info "PMM: .env"
  local envf="$PMM_DIR/.env"
  if [[ -f "$envf" ]]; then
    dim ".env exists — left untouched"
  else
    # .env.dev.example pins PMM_SERVER_IMAGE to the dev-container image, which is
    # what makes the mounted working tree buildable. The release .env.example
    # would give a stock server with no toolchain inside.
    cp "$PMM_DIR/.env.dev.example" "$envf"
    ok ".env created from .env.dev.example (dev-container image)"
  fi

  # SEP pins PMM.ENDPOINT to https://127.0.0.1:8443, while PMM's own default is
  # 443. Align the published port or PMMSyncer cannot reach it.
  if grep -qE '^PMM_PORT_HTTPS=' "$envf"; then
    local cur; cur="$(grep -E '^PMM_PORT_HTTPS=' "$envf" | tail -1 | cut -d= -f2)"
    if [[ "$cur" != "$PMM_HTTPS_PORT" ]]; then
      sed -i -E "s/^PMM_PORT_HTTPS=.*/PMM_PORT_HTTPS=$PMM_HTTPS_PORT/" "$envf"
      ok "PMM_PORT_HTTPS $cur -> $PMM_HTTPS_PORT (matches SEP's PMM.ENDPOINT)"
    else
      dim "PMM_PORT_HTTPS already $PMM_HTTPS_PORT"
    fi
  else
    echo "PMM_PORT_HTTPS=$PMM_HTTPS_PORT" >> "$envf"
    ok "PMM_PORT_HTTPS=$PMM_HTTPS_PORT appended"
  fi
}

cmd_setup() {
  cmd_doctor || warn "some prerequisites are missing — continuing with what is possible"
  echo
  om_setup_sep
  echo
  om_setup_pmm
  echo
  info "Setup complete"
  dim "Next:  ./om start          (pmm + sep)"
  dim "       ./om build pmm      compile the PMM working tree into the server"
  dim "       ./om status"
}

# ---------------------------------------------------------------------------
# start / stop per component
# ---------------------------------------------------------------------------

# 0 when the bundle nginx serves is our working tree's (i.e. carries the SEP apps).
pmm_ui_has_sep() {
  docker exec -i --user root "$PMM_CONTAINER" \
    grep -rqs "$PMM_UI_SEP_MARKER" "$PMM_UI_DIR" 2>/dev/null
}

# The devcontainer image has node but neither pnpm nor corepack, and `ui`'s own
# `make setup` assumes corepack. Install the version pinned by ui/package.json's
# `packageManager` so the lockfile is honoured, rather than whatever is latest.
ensure_container_pnpm() {
  docker exec -i --user root "$PMM_CONTAINER" sh -c 'command -v pnpm' >/dev/null 2>&1 && return 0
  local pinned
  pinned="$(sed -n 's/.*"packageManager": *"\(pnpm@[0-9.]*\).*/\1/p' "$PMM_DIR/ui/package.json" | head -1)"
  [[ -n "$pinned" ]] || pinned=pnpm
  dim "installing $pinned in the container (no pnpm/corepack in the dev image)"
  docker exec -i --user root "$PMM_CONTAINER" npm i -g "$pinned" >/dev/null 2>&1 \
    || { err "could not install $pinned in $PMM_CONTAINER"; return 1; }
}

# Build the working tree's UI over the image's prebuilt bundle. Without this the
# two SEP apps (Collect Diagnostic Data, MySQL Backups) are simply not in the
# JS nginx serves, so they appear nowhere in PMM no matter how the backend is
# configured. `build-ui` deploys a static bundle rather than running Vite, so it
# survives for the container's lifetime with no process to keep alive — but a
# container recreate resets it to the image's copy, which is why this runs on
# every start. Pass force=1 (or `./om build ui`) to rebuild after UI edits.
ensure_pmm_ui() {
  local force="${1:-0}"
  if [[ "${OM_PMM_UI:-1}" == "0" ]]; then
    dim "pmm-ui: skipped (OM_PMM_UI=0) — SEP apps will be missing from the UI"
    return 0
  fi
  if [[ "$force" != "1" ]] && pmm_ui_has_sep; then
    ok "pmm-ui: working tree bundle already deployed (SEP apps present)"
    return 0
  fi
  ensure_container_pnpm || { warn "pmm-ui: left at the image's bundle — SEP apps missing"; return 0; }
  info "pmm-ui: building ui/ and deploying over the image's bundle (minutes on a cold cache)"
  local log; log="$(log_file pmm-ui)"
  mkdir -p "$LOG_DIR"
  # No -t: there is no TTY here. build-ui restarts grafana at the end so the
  # pmm-compat plugin is reloaded alongside the new bundle.
  if docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" make build-ui >"$log" 2>&1; then
    if pmm_ui_has_sep; then
      ok "pmm-ui: deployed — /pmm-ui/sep/atw and /pmm-ui/sep/mysql-backups are live"
    else
      # A clean build whose output lacks the marker means the checked-out branch
      # does not carry the SEP routes, not that the deploy failed.
      warn "pmm-ui: built, but no SEP routes in it — is this branch missing PMM-15216?"
    fi
  else
    warn "pmm-ui: build failed — UI left at the image's bundle (SEP apps missing)"
    dim "log: $log"
    tail -n 15 "$log" >&2 || true
  fi
}

# Fingerprints the Go sources pmm-managed is built from: HEAD, plus the content of
# any uncommitted change under managed/ or api/. Content, not just filenames, so a
# second edit to the same file is still noticed.
pmm_tree_fingerprint() {
  # In a subshell that has actually cd'd: `git -C` moves git's directory but not the
  # shell's, so `cat` would look for the listed paths under the workspace root and
  # quietly find nothing -- which silently drops every new file from the fingerprint.
  (
    cd "$PMM_DIR" 2>/dev/null || exit 0
    git rev-parse HEAD 2>/dev/null || echo nohead
    git diff HEAD -- managed api 2>/dev/null || true
    git ls-files --others --exclude-standard -- managed api 2>/dev/null | xargs -r cat || true
  ) | sha1sum | cut -c1-16
}

# Rebuilds pmm-managed from the working tree when the container is not already
# running that build.
#
# This exists because a container recreate silently undoes `./om build pmm`. The
# image ships its own /usr/sbin/pmm-managed, `make run-managed-ci` installs the
# working tree's over it, and `make env-up` throws that away with the container --
# taking every route the tree adds with it. The symptom is a healthy gateway
# answering "endpoint not found" for an endpoint you know you wrote.
#
# The stamp sits next to the binary rather than in /srv on purpose: /srv is a volume
# and survives the recreate, so a stamp there would claim a build that is gone.
ensure_pmm_managed() {
  local force="${1:-0}"
  if [[ "${OM_PMM_MANAGED:-1}" == "0" ]]; then
    dim "pmm-managed: skipped (OM_PMM_MANAGED=0) — running the image's binary"
    return 0
  fi

  local want; want="$(pmm_tree_fingerprint)"
  local have
  have="$(docker exec -i --user root "$PMM_CONTAINER" cat "$PMM_MANAGED_STAMP" 2>/dev/null || true)"
  if [[ "$force" != "1" && -n "$have" && "$have" == "$want" ]]; then
    ok "pmm-managed: working tree build already deployed"
    return 0
  fi

  info "pmm-managed: compiling the working tree over the image's binary (a minute or two)"
  local log; log="$(log_file pmm-managed-build)"
  mkdir -p "$LOG_DIR"
  # As root: the module cache under /root/go is not writable by the default user, and
  # go refuses to build a repo git calls "dubious ownership" without this exception.
  docker exec -i --user root "$PMM_CONTAINER" \
    git config --global --add safe.directory "$PMM_WORKDIR" >/dev/null 2>&1 || true
  if docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" \
       make run-managed-ci >"$log" 2>&1; then
    docker exec -i --user root "$PMM_CONTAINER" \
      sh -c "printf '%s' '$want' > '$PMM_MANAGED_STAMP'" >/dev/null 2>&1 || true
    ok "pmm-managed: deployed from the working tree"
  else
    warn "pmm-managed: build failed — left at the image's binary, so routes your tree adds will 404"
    dim "log: $log"
    tail -n 15 "$log" >&2 || true
  fi
}

# pmm.conf with the workspace's SEP locations injected, written to harness/.
#
# PMM's nginx has no include hook inside its server block, so a location cannot
# be added without replacing the whole file. Rendering it from pmm's current copy
# on every start keeps PMM's other locations exactly as the checkout has them --
# a snapshot would drift, which is how SEP's own committed template ended up
# still proxying the five bare prefixes the SEP UI stopped using on 2026-08-10.
#
# The fragment goes in ahead of `location /pmm-ui`, inside the server block.
render_pmm_conf() {
  local src="$PMM_DIR/build/ansible/roles/nginx/files/conf.d/pmm.conf"
  local frag="$HARNESS_DIR/sep-locations.conf"
  local out="$HARNESS_DIR/pmm.conf"
  [[ -f "$src" ]]  || die "pmm.conf missing at $src"
  [[ -f "$frag" ]] || die "SEP locations fragment missing at $frag"
  grep -q '^    # PMM UI$' "$src" || die "pmm.conf has no '# PMM UI' anchor — render_pmm_conf needs updating"
  awk -v frag="$frag" '
    /^    # PMM UI$/ && !done { while ((getline line < frag) > 0) print line; print ""; done = 1 }
    { print }
  ' "$src" > "$out.tmp" || die "rendering pmm.conf failed"
  grep -q 'location /sep/' "$out.tmp" || die "rendered pmm.conf has no /sep location"
  mv "$out.tmp" "$out"
}

# Both compose files, in order. The first one fixes the project directory, so
# pmm/ must lead: it keeps the project name `pmm` (as `make env-up` produces) and
# makes the override's relative paths resolve against the pmm checkout.
pmm_compose() {
  ( cd "$PMM_DIR" && COMPOSE_PROFILES=pmm docker compose \
      -f docker-compose.dev.yml \
      -f "$HARNESS_DIR/pmm-compose.override.yml" "$@" )
}

start_pmm() {
  info "pmm: devcontainer (from repo)"
  [[ -f "$PMM_DIR/.env" ]] || die "pmm/.env missing — run ./om setup first"
  local img
  img="$(grep -E '^PMM_SERVER_IMAGE=' "$PMM_DIR/.env" | tail -1 | cut -d= -f2- || true)"
  if [[ -n "$img" ]] && ! docker image inspect "$img" >/dev/null 2>&1; then
    warn "$img is not present locally — first start pulls several GB"
  fi
  # PMM's own docker-compose.dev.yml plus harness/pmm-compose.override.yml, which
  # carries what this workspace needs and the pmm checkout should not: the SEP
  # nginx overlay, the host-gateway alias, and the entrypoint mounts the published
  # dev image is too old to provide. Then PMM's env-pg-config, which tunes the
  # embedded PostgreSQL on a fresh /srv volume.
  render_pmm_conf
  pmm_compose up -d --wait --wait-timeout 100
  make -C "$PMM_DIR" env-pg-config
  ok "pmm-server up — https://localhost:$PMM_HTTPS_PORT (admin/admin)"
  dim "running the image's binaries; './om build pmm' compiles your working tree"
  ensure_pmm_managed
  ensure_pmm_ui
}

stop_pmm() {
  info "pmm: devcontainer down"
  # Same file pair as the start, so compose tears down what it brought up.
  pmm_compose down --remove-orphans
  ok "pmm stopped"
}

start_sep_backend() {
  # The celery worker + beat run in-process (SEP's --start-celery) by default:
  # without them nothing executes. Task execution is dispatched through celery
  # (app/tasks/routes.py :: execute_task_queue.apply_async), running-task status
  # comes from the 30s sync_running_tasks periodic, and the snippet catalog is
  # populated by sync_snippets.delay() at startup — with no worker those all
  # queue up in data/celery/broker/ and silently never run. SEP_CELERY=0 opts
  # out for the rare uvicorn-only case.
  local celery_note="" make_args=()
  if [[ "${SEP_CELERY:-1}" != "0" ]]; then
    make_args=(START_CELERY=1); celery_note=" + celery worker/beat"
  fi
  info "sep-backend: uvicorn (native, reload on)${celery_note}"
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  if [[ "${SEP_CELERY:-1}" == "0" ]] && ! beat_schema_ready; then
    err "the Celery beat schedule tables are missing, so startup would fail with"
    err "  'no such table: main.celery_intervalschedule'"
    die "run './om setup' (it bootstraps them), or drop SEP_CELERY=0"
  fi
  if port_busy "$SEP_BACKEND_PORT" && ! read_pid sep-backend >/dev/null; then
    die "port $SEP_BACKEND_PORT is already in use by something om did not start"
  fi
  start_native sep-backend "$SEP_DIR" make dev-backend "${make_args[@]}"
  # Cold start is slow: poetry-installed imports, the app registry, and the beat
  # model init all happen before uvicorn binds. Measured ~15s warm, longer cold.
  for _ in $(seq 1 90); do
    port_busy "$SEP_BACKEND_PORT" && { ok "listening on http://localhost:$SEP_BACKEND_PORT"; return 0; }
    read_pid sep-backend >/dev/null || { err "process exited during startup:"; tail -n 20 "$(log_file sep-backend)" >&2; return 1; }
    sleep 1
  done
  warn "not listening on :$SEP_BACKEND_PORT yet — ./om logs sep-backend"
}

start_sep_frontend() {
  info "sep-frontend: vite (native)"
  if ! ensure_node "$(node_version)"; then
    local v; v="$(node_version)"
    err "node >= $NODE_MIN required (found ${v:-none})"
    [[ -s "$HOME/.nvm/nvm.sh" ]] && dim "nvm install 22 && nvm alias default 22"
    die "then re-run ./om setup so pnpm install can complete"
  fi
  [[ -d "$SEP_DIR/frontend/node_modules" ]] \
    || die "frontend deps missing — run ./om setup first"

  # Vite dies at startup with ENOSPC / "Emitted 'error' event on FSWatcher" when the
  # per-user inotify *instance* limit is exhausted — not a disk problem, despite the
  # errno name. A desktop with two editors plus Electron apps routinely sits at the
  # 128 default, and this monorepo needs more. Raising it needs root, so fall back to
  # a polling watcher (more CPU, no root) and say so. OM_WATCH_POLLING=1 forces it,
  # OM_WATCH_POLLING=0 disables the fallback entirely.
  local polling="${OM_WATCH_POLLING:-auto}"
  if [[ "$polling" == "auto" ]]; then
    local used limit
    used="$(count_inotify_instances)"
    limit="$(cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null || echo 0)"
    if [[ "${limit:-0}" -gt 0 && "${used:-0}" -ge "$limit" ]]; then
      warn "inotify instances exhausted ($used/$limit) — using a polling file watcher"
      dim "permanent fix (needs root):"
      dim "  sudo tee /etc/sysctl.d/99-inotify.conf <<'EOF'"
      dim "  fs.inotify.max_user_instances = 1024"
      dim "  fs.inotify.max_user_watches = 524288"
      dim "  EOF"
      dim "  sudo sysctl --system"
      polling=1
    else
      polling=0
    fi
  fi
  [[ "$polling" == "1" ]] && export CHOKIDAR_USEPOLLING=1
  if port_busy "$SEP_FRONTEND_PORT" && ! read_pid sep-frontend >/dev/null; then
    die "port $SEP_FRONTEND_PORT is already in use by something om did not start"
  fi
  start_native sep-frontend "$SEP_DIR" make dev-frontend
  for _ in $(seq 1 30); do
    port_busy "$SEP_FRONTEND_PORT" && { ok "develop here: http://localhost:$SEP_FRONTEND_PORT"; return 0; }
    sleep 1
  done
  warn "not listening on :$SEP_FRONTEND_PORT yet — ./om logs sep-frontend"
}

# ---------------------------------------------------------------------------
# Sandbox nodes - the PSMDB clusters, and the database-less hosts beside them
# ---------------------------------------------------------------------------

psmdb_compose() { ( cd "$PSMDB_DIR" && docker compose "$@" ); }

# Containers currently up for a profile. Every service is named
# <profile>-<role><n> — standalone-node00, replicaset-cluster-node01,
# sharded-cluster-shard00svr0, pmm-client-node02 - so the profile name *is* the
# prefix and no lookup table can drift out of sync with compose.yaml.
#
# The alternative `$` branch is for a client node's private profile, where the
# profile name is the whole container name rather than a prefix of several
# (pmm-client-node01). It is what makes `./om start pmm-client-node01` count and
# wait for its one node instead of finding none.
#
# One ordering trap this creates: "replicaset-single" is not a prefix of
# "replicaset-cluster" and vice versa, so the counts stay disjoint. Keep it that
# way if you add a topology.
psmdb_running() {
  docker ps --format '{{.Names}}' 2>/dev/null | grep -cE "^$1(-|\$)" || true
}

# Every node profile with at least one container up, in NODE_PROFILES order.
psmdb_up_profiles() {
  local p
  for p in "${NODE_PROFILES[@]}"; do
    [[ "$(psmdb_running "$p")" -gt 0 ]] && printf '%s\n' "$p"
  done
  return 0
}

# Writes that set down, so a later bare `./om start` can restore it. Called only by
# the argument-less `./om stop`: an explicit `./om stop sharded-cluster` is a
# statement about one profile, not about what the machine should look like next
# time, and must not overwrite the memory.
#
# Records the pool profile for the client hosts, not the individual nodes, so a
# machine left with one client host up comes back with all of them. Restoring the
# exact set is not worth a second state file for hosts this cheap.
psmdb_remember_up() {
  mkdir -p "$(dirname "$PSMDB_LAST_UP_FILE")"
  psmdb_up_profiles > "$PSMDB_LAST_UP_FILE"
}

# Reads it back, dropping anything that is no longer a known profile -- a stale
# entry from a renamed topology should be ignored, not passed to Compose.
psmdb_remembered() {
  [[ -f "$PSMDB_LAST_UP_FILE" ]] || return 0
  local line p
  while read -r line; do
    [[ -n "$line" ]] || continue
    for p in "${NODE_PROFILES[@]}"; do
      [[ "$line" == "$p" ]] && printf '%s\n' "$line" && break
    done
  done < "$PSMDB_LAST_UP_FILE"
  return 0
}

# True when the argument names one of the declared client nodes. Generated from
# CLIENT_NODES rather than matched with a glob so `./om start pmm-client-node07`
# is rejected here, with the list of what exists, instead of reaching compose -
# which answers an unknown profile by starting nothing and saying nothing.
client_node_name() {
  local n
  for (( n = 0; n < CLIENT_NODES; n++ )); do
    [[ "$1" == "$(printf '%s-node%02d' "$CLIENT_PROFILE" "$n")" ]] && return 0
  done
  return 1
}

client_node_names() {
  local n
  for (( n = 0; n < CLIENT_NODES; n++ )); do
    printf '%s-node%02d\n' "$CLIENT_PROFILE" "$n"
  done
}

# The root credentials every node is bootstrapped with, read from compose.yaml so a
# change there does not leave om printing a URI that cannot log in.
psmdb_credentials() {
  local user pass
  user="$(sed -n 's/^ *MONGO_ROOT_USER: *//p' "$PSMDB_DIR/compose.yaml" | head -1)"
  pass="$(sed -n 's/^ *MONGO_ROOT_PASSWORD: *//p' "$PSMDB_DIR/compose.yaml" | head -1)"
  printf '%s:%s' "${user:-root}" "${pass:-root-password}"
}

# The MongoDB URI for one running profile.
#
# Seeds come from the running containers rather than a table, for the reason
# psmdb_running gives: the profile name is the container-name prefix, so nothing can
# drift out of sync with compose.yaml. A sharded cluster is addressed through its
# routers, so only the mongos nodes are seeds -- the config servers (27019) and shard
# members (27018) are not where a client connects.
#
# Both replica-set profiles name their set after the profile, so ?replicaSet= is the
# profile name. A standalone and a mongos take no such parameter.
psmdb_uri() {
  local profile="$1" filter="^$1-" seeds
  [[ "$profile" == sharded-cluster ]] && filter="^$1-mongos"
  seeds="$(docker ps --format '{{.Names}}' 2>/dev/null | grep "$filter" | sort \
           | sed 's/$/:27017/' | paste -sd, -)"
  [[ -n "$seeds" ]] || return 1
  local params="authSource=admin"
  [[ "$profile" == replicaset-* ]] && params="replicaSet=$profile&$params"
  printf 'mongodb://%s@%s/?%s' "$(psmdb_credentials)" "$seeds" "$params"
}

# The first running container of a profile, for the docker exec hint.
psmdb_first_node() {
  local filter="^$1-"
  [[ "$1" == sharded-cluster ]] && filter="^$1-mongos"
  docker ps --format '{{.Names}}' 2>/dev/null | grep "$filter" | sort | head -1
}

# ---------------------------------------------------------------------------
# hosts — make the cluster names resolve on this machine
# ---------------------------------------------------------------------------
#
# With these in /etc/hosts the network URIs from `./om status` work from the host
# as-is, replica sets included: the driver resolves the seed, asks the set for its
# members, and resolves those too. That is the part directConnection=true has to
# skip.
#
# The catch is that container IPs are not stable. Docker hands out the next free
# address, so one `./om restart standalone` moved a node from .4 to .8 here -- and
# .4 can later belong to a different node, which turns a stale entry into a URI
# that quietly reaches the wrong database. Hence: regenerated from live containers
# on every run, written as one replaceable block, never appended to.

HOSTS_FILE=/etc/hosts
HOSTS_BEGIN="# >>> om psmdb >>>"
HOSTS_END="# <<< om psmdb <<<"

psmdb_hosts_block() {
  local pattern name ip
  pattern="^($(IFS='|'; printf '%s' "${NODE_PROFILES[*]}"))-"
  printf '%s\n' "$HOSTS_BEGIN"
  printf '# %s — regenerate with ./om hosts --write after any cluster restart\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  while read -r name; do
    [[ -n "$name" ]] || continue
    ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$name" 2>/dev/null)"
    [[ -n "$ip" ]] && printf '%-15s %s\n' "$ip" "$name"
  done < <(docker ps --format '{{.Names}}' 2>/dev/null | grep -E "$pattern" | sort)
  printf '%s\n' "$HOSTS_END"
}

# True when /etc/hosts carries a block that no longer matches the running containers.
psmdb_hosts_stale() {
  grep -q "^$HOSTS_BEGIN\$" "$HOSTS_FILE" 2>/dev/null || return 1
  local current live
  current="$(sed -n "/^$HOSTS_BEGIN\$/,/^$HOSTS_END\$/p" "$HOSTS_FILE" | grep -vE '^#')"
  live="$(psmdb_hosts_block | grep -vE '^#')"
  [[ "$current" != "$live" ]]
}

cmd_hosts() {
  local mode="${1:-print}"
  case "$mode" in
    print|--print|-p)
      local body; body="$(psmdb_hosts_block)"
      if [[ "$(printf '%s' "$body" | grep -cE '^[0-9]')" -eq 0 ]]; then
        warn "no cluster containers are running — start one first"
        return 0
      fi
      info "Add this to $HOSTS_FILE (needs sudo), or run: ./om hosts --write"
      printf '%s\n' "$body"
      psmdb_hosts_stale && warn "the block already in $HOSTS_FILE is out of date"
      return 0
      ;;
    --write|write|-w) ;;
    --remove|remove|-r) ;;
    *) die "usage: ./om hosts [--write|--remove]   (default: print)" ;;
  esac

  [[ -w "$HOSTS_FILE" ]] || info "editing $HOSTS_FILE needs sudo — you may be prompted"
  # Kept: the file is system state, and a bad edit here breaks name resolution for
  # everything, not just this workspace.
  sudo cp -n "$HOSTS_FILE" "$HOSTS_FILE.om.bak" 2>/dev/null || true
  # Always drop the old block before writing, so repeated runs replace rather than
  # stack up stale addresses.
  sudo sed -i "/^$HOSTS_BEGIN\$/,/^$HOSTS_END\$/d" "$HOSTS_FILE" \
    || die "could not edit $HOSTS_FILE"

  case "$mode" in
    --remove|remove|-r)
      ok "removed the om block from $HOSTS_FILE"
      return 0
      ;;
  esac

  psmdb_hosts_block | sudo tee -a "$HOSTS_FILE" >/dev/null \
    || die "could not write to $HOSTS_FILE"
  ok "wrote $(psmdb_hosts_block | grep -cE '^[0-9]') entr(y|ies) to $HOSTS_FILE"
  dim "the network URIs from ./om status now work from this machine"
  dim "re-run after restarting a cluster; ./om hosts --remove takes them out again"
}

# The node image is ~1.6 GB and takes a few minutes: build it once, on demand,
# rather than making every user remember a separate step.
#
# Two images come out of the one psmdb/Dockerfile, selected by --build-arg, so a
# workspace that only ever starts client hosts never builds the database one and
# vice versa. Both are cached on the tag alone: change the Dockerfile or anything
# under psmdb/scripts and you must rebuild by hand, since an existing tag is
# taken at face value here.
ensure_node_image() {
  local image="$1"; shift
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  info "psmdb: building $image (first time only, a few minutes)"
  ( cd "$PSMDB_DIR" && docker build "$@" -t "$image" . ) \
    || die "failed to build $image"
  ok "image built"
}

# True when any of this profile's existing containers is pinned to a pmm_default
# that no longer exists.
#
# compose.yaml joins pmm_default as an *external* network, so compose matches it
# by name and never notices that the network behind the name changed. Docker,
# though, records the network's *id* on a container when it is created: restart
# PMM's compose stack and pmm_default is destroyed and recreated with a fresh id,
# stranding every cluster container that predates the restart. `up -d` then
# starts them unchanged and the daemon refuses:
#
#   Error response from daemon: failed to set up container networking:
#   network 9578f6b1... not found
#
# Only recreating the container clears it, and compose will not do that on its
# own — from its side nothing changed. So detect the divergence and ask for it.
# The service list comes from compose rather than from the <profile>-* name
# prefix, which also covers the profile-less services (minio) that come up
# alongside every topology and go stale the same way.
psmdb_stale_network() {
  local profile="$1" want svcs cid nid
  want="$(docker network inspect -f '{{.Id}}' "$PSMDB_NETWORK" 2>/dev/null)" || return 1
  [[ -n "$want" ]] || return 1

  mapfile -t svcs < <(psmdb_compose --profile "$profile" config --services 2>/dev/null || true)
  [[ "${#svcs[@]}" -gt 0 ]] || return 1

  while IFS= read -r cid; do
    [[ -n "$cid" ]] || continue
    # Empty for a container that was created but never attached; nothing to fix.
    nid="$(docker inspect \
      -f "{{index .NetworkSettings.Networks \"$PSMDB_NETWORK\" \"NetworkID\"}}" \
      "$cid" 2>/dev/null || true)"
    [[ -n "$nid" && "$nid" != "$want" ]] && return 0
  done < <(psmdb_compose ps -aq "${svcs[@]}" 2>/dev/null || true)

  return 1
}

start_sandbox_node() {
  local profile="$1"
  [[ -d "$PSMDB_DIR" ]] || die "psmdb/ not found at $PSMDB_DIR"

  # These nodes join the network PMM's compose creates. Without it, `docker
  # compose up` fails with an "external network not found" that reads like a
  # config bug rather than "start PMM first".
  docker network inspect "$PSMDB_NETWORK" >/dev/null 2>&1 \
    || die "network $PSMDB_NETWORK missing — run './om start pmm' first"

  # Both the pool profile and a single node's private profile start with
  # $CLIENT_PROFILE, so one test covers `pmm-client` and `pmm-client-node01`.
  if [[ "$profile" == "$CLIENT_PROFILE"* ]]; then
    ensure_node_image "$CLIENT_IMAGE" --build-arg WITH_PSMDB=0
  else
    ensure_node_image "$PSMDB_IMAGE"
    # The keyfile is replica-set internal auth. A client host mounts none and
    # joins nothing, so generating one for it would be theatre.
    [[ -f "$PSMDB_DIR/secrets/keyfile" ]] || ( cd "$PSMDB_DIR" && ./bootstrap.sh >/dev/null )
  fi

  local recreate=()
  if psmdb_stale_network "$profile"; then
    warn "$profile: containers are pinned to a $PSMDB_NETWORK that no longer exists"
    dim "PMM's compose stack was restarted since they were created; recreating them"
    dim "(named volumes are kept, so the data survives)"
    recreate=(--force-recreate)
  fi

  info "$profile: docker compose (profile '$profile')"
  psmdb_compose --profile "$profile" up -d "${recreate[@]}"

  # Registration is the useful readiness signal, not "container started": a node
  # is only usable once its pmm-agent has connected, which on a database node also
  # means register.sh has written the credentials file the SEP payloads read.
  #
  # /run/om-node-ready is published by register.sh and register-client.sh alike,
  # so this one test covers a database node and a client host without asking which
  # it is looking at. /root/.mongodb_uri is the same signal from before the marker
  # existed - kept so a psmdb-node image built earlier still reports ready rather
  # than timing out until it is rebuilt.
  local pattern nodes i ready
  pattern="^$profile(-|\$)"
  nodes="$(docker ps --format '{{.Names}}' | grep -cE "$pattern" || true)"
  for i in $(seq 1 60); do
    ready=0
    local n
    while IFS= read -r n; do
      [[ -n "$n" ]] || continue
      docker exec "$n" sh -c \
        'test -f /run/om-node-ready || test -f /root/.mongodb_uri' >/dev/null 2>&1 \
        && ready=$((ready + 1))
    done < <(docker ps --format '{{.Names}}' | grep -E "$pattern" || true)
    if [[ "$ready" -ge "$nodes" ]] && [[ "$nodes" -gt 0 ]]; then
      ok "$profile: $nodes/$nodes node(s) up and registered with PMM"
      return 0
    fi
    sleep 5
  done
  warn "$profile: only $ready/$nodes node(s) finished bootstrap — ./om logs $profile"
}

stop_sandbox_node() {
  local profile="$1"
  info "$profile: stopping"
  psmdb_compose --profile "$profile" stop >/dev/null 2>&1 || true
  # A client host writes nothing it would want back, so there is no data to
  # reassure anyone about and no `down -v` worth suggesting.
  if [[ "$profile" == "$CLIENT_PROFILE"* ]]; then
    ok "$profile stopped (containers kept; these hosts carry no data)"
  else
    ok "$profile stopped (containers kept; data volumes intact)"
    dim "wipe its data with: cd psmdb && docker compose --profile $profile down -v"
  fi
}

