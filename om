cmd_doctor() {
  local fail=0
  info "Prerequisites"

  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then ok "docker $(docker --version | awk '{print $3}' | tr -d ,)"
    else err "docker is installed but the daemon is not reachable"; fail=1; fi
  else err "docker not found"; fail=1; fi

  if docker compose version >/dev/null 2>&1; then ok "docker compose plugin"
  else err "'docker compose' plugin not found (v1 'docker-compose' is not supported)"; fail=1; fi

  command -v make >/dev/null 2>&1 && ok "make" || { err "make not found"; fail=1; }
  command -v python3 >/dev/null 2>&1 && ok "python3 $(python3 -V 2>&1 | awk '{print $2}')" \
    || { err "python3 not found"; fail=1; }

  # Node/pnpm gate the SEP frontend only. PMM's UI builds inside its
  # devcontainer, which ships its own Node.
  if ensure_node "$(node_version)"; then
    ok "node v$(node_version)"
  elif [[ -n "$(node_version)" ]]; then
    err "node v$(node_version) is too old — SEP's frontend requires >= $NODE_MIN (blocks sep-frontend only)"
    if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
      dim "nvm is installed: nvm install 22 && nvm alias default 22"
      dim "then re-activate pnpm for that version: corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
    fi
    fail=1
  else
    err "node not found — required >= $NODE_MIN (blocks sep-frontend only)"; fail=1
  fi

  if command -v pnpm >/dev/null 2>&1; then ok "pnpm $(pnpm --version 2>/dev/null)"
  elif command -v corepack >/dev/null 2>&1; then
    warn "pnpm not active; enable the pinned version with:"
    dim "corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
    fail=1
  else err "neither pnpm nor corepack found"; fail=1; fi

  [[ -d "$SEP_DIR" ]] && ok "SEP/ present" || { err "SEP/ not found at $SEP_DIR"; fail=1; }
  [[ -d "$PMM_DIR" ]] && ok "pmm/ present" || { err "pmm/ not found at $PMM_DIR"; fail=1; }

  return $fail
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

# --- the two dotenv files ---------------------------------------------------
#
# Between them pmm/.env and SEP/.env carry one generated password, one generated
# token and one minted Grafana token, and the password has to be byte-identical in
# five places across both files. Getting that wrong produces a workspace that
# starts cleanly and then fails somewhere unrelated, so it is a command rather
# than a paragraph of instructions.
#
# The templates live in harness/ because they are this workspace's needs and not
# the products': pmm/.env.dev.example is upstream's file and is merged into, never
# edited. SEP has no example upstream, so harness/sep-env.example is the whole file.
PMM_ENV_TEMPLATE="$HARNESS_DIR/pmm-env.example"
SEP_ENV_TEMPLATE="$HARNESS_DIR/sep-env.example"

# Last assignment wins, which is what both docker compose and python-dotenv do.
env_value() { # file key -> value on stdout, empty when absent
  [[ -f "$1" ]] || return 0
  sed -n "s/^$2=//p" "$1" | tail -1
}

gen_secret() { # [bytes] -> 2*bytes hex characters
  local bytes="${1:-16}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    head -c "$bytes" /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

# Asks on the terminal rather than on stdin, so a prompt still works when the
# command's stdin is a pipe. No controlling terminal means no answer, and the
# safe reading of no answer is "do not overwrite" - the group redirection is what
# keeps bash from printing its own complaint about /dev/tty in that case.
confirm() { # question -> 0 when the answer is yes
  [[ "${OM_YES:-0}" == 1 ]] && return 0
  { : </dev/tty; } 2>/dev/null || return 1
  local reply
  read -r -p "$1 [y/N] " reply </dev/tty || return 1
  [[ "$reply" == [Yy]* ]]
}

# Waits for Grafana's own API, which is later than PMM being up.
#
# `./om start pmm` waits on pmm-managed's /v1/server/readyz, and Grafana is a
# separate supervisord program that provisions its own database. On a fresh /srv
# it answers well after readyz passes, so the first request during a bootstrap
# reliably fails - and treating that as "PMM is not running" produced a workspace
# with an unusable token and a message pointing at the wrong thing.
GRAFANA_WAIT_SECONDS=120
grafana_wait() { # sets GRAFANA_ERROR and returns 1 on failure
  # The wait covers one specific gap - PMM up, Grafana not yet answering - so a
  # stopped container is not something to wait out. Without this, `./om env` on a
  # cold workspace blocks for the full timeout before saying the obvious.
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$PMM_CONTAINER"; then
    GRAFANA_ERROR="PMM is not running (start it with ./om start pmm)"
    return 1
  fi

  local waited=0 code
  while :; do
    # curl prints 000 itself when it never got a response, and exits non-zero as
    # well - so a `|| echo 000` fallback here appends a second one and reports
    # "last HTTP 000000".
    code="$(curl -sk -m 10 -o /dev/null -w '%{http_code}' \
            -u "$PMM_USER:$PMM_PASSWORD" \
            "https://localhost:$PMM_HTTPS_PORT/graph/api/serviceaccounts/search?query=sep-local" \
            2>/dev/null)" || true
    [[ -n "$code" ]] || code=000
    case "$code" in
      200) return 0 ;;
      # Not something waiting fixes: the admin password has been changed from the
      # one pmm/.env sets, which happens on any PMM someone has logged into.
      401|403) GRAFANA_ERROR="Grafana rejected $PMM_USER (HTTP $code); set OM_PMM_USER / OM_PMM_PASSWORD"
               return 1 ;;
    esac
    if (( waited >= GRAFANA_WAIT_SECONDS )); then
      GRAFANA_ERROR="Grafana's API did not answer within ${waited}s (last HTTP $code)"
      return 1
    fi
    [[ "$waited" == 0 ]] && dim "waiting for Grafana's API (it starts after PMM reports ready)"
    sleep 3
    waited=$((waited + 3))
  done
}

# Mints a Grafana service account token, or fails with GRAFANA_ERROR saying why.
#
# Admin rather than Viewer because the token does two jobs: it backs SEP's Grafana
# auth provider, which reads users, and it is what PMMSyncer presents when it asks
# PMM to run management tasks.
#
# An existing account of the same name is reused, since Grafana rejects a duplicate
# name and a workspace gets re-provisioned far more often than a server does. Tokens
# themselves are append-only here: Grafana will not show an existing token's value
# again, so a re-run that has lost the value has no choice but to add one.
#
# The result comes back in GRAFANA_TOKEN rather than on stdout, so this must not be
# called from a command substitution. Two reasons, both learned the hard way: a
# subshell would discard GRAFANA_ERROR, leaving the caller to invent a cause for a
# failure it cannot see; and any progress line printed while waiting would be
# captured as part of the token.
grafana_mint_token() { # sets GRAFANA_TOKEN / GRAFANA_ERROR
  GRAFANA_ERROR=""
  GRAFANA_TOKEN=""
  command -v jq >/dev/null 2>&1 || { GRAFANA_ERROR="jq is not installed"; return 1; }
  grafana_wait || return 1

  local api="https://localhost:$PMM_HTTPS_PORT/graph/api/serviceaccounts"
  local -a curl_opts=(-sk -m 15 -u "$PMM_USER:$PMM_PASSWORD" -H 'Content-Type: application/json')
  local id token

  id="$(curl "${curl_opts[@]}" -X POST "$api" \
        -d '{"name":"sep-local","role":"Admin","isDisabled":false}' 2>/dev/null \
        | jq -r '.id // empty')"
  if [[ -z "$id" ]]; then
    id="$(curl "${curl_opts[@]}" "$api/search?query=sep-local" 2>/dev/null \
          | jq -r '[.serviceAccounts[]? | select(.name=="sep-local") | .id][0] // empty')"
  fi
  [[ -n "$id" ]] || { GRAFANA_ERROR="could not create or find the sep-local service account"; return 1; }

  # Unique name per mint. Grafana rejects a duplicate token name within an account,
  # so a fixed one would work exactly once and then fail on every workspace that
  # ever re-runs this - which is the normal case, since the value of an existing
  # token cannot be read back and a lost one can only be replaced.
  token="$(curl "${curl_opts[@]}" -X POST "$api/$id/tokens" \
           -d "{\"name\":\"om-$(date +%Y%m%d-%H%M%S)\"}" 2>/dev/null | jq -r '.key // empty')"
  [[ -n "$token" ]] || { GRAFANA_ERROR="the service account exists but Grafana issued no token"; return 1; }
  GRAFANA_TOKEN="$token"
}

# Renders pmm/.env as upstream's .env.dev.example with harness/pmm-env.example
# overlaid, so a key this workspace does not override tracks upstream instead of
# being pinned to whatever it said the day someone copied the file.
env_pmm() { # mode: create (skip when present) | refresh (ask first)
  local mode="$1" out="$PMM_DIR/.env" base="$PMM_DIR/.env.dev.example"
  [[ -f "$base" ]] || die "pmm/.env.dev.example missing - run: git submodule update --init"
  [[ -f "$PMM_ENV_TEMPLATE" ]] || die "missing $PMM_ENV_TEMPLATE"

  if [[ -f "$out" ]]; then
    if [[ "$mode" == create ]]; then
      dim "pmm/.env exists - left untouched"
      return 0
    fi
    confirm "pmm/.env exists. Overwrite it?" || { dim "pmm/.env left untouched"; return 0; }
  fi

  # Carried over rather than regenerated, even when the file is being rewritten.
  # PMM_SEP_POSTGRES_PASSWORD is baked into the `sep` role on the /srv volume at
  # first start, so inventing a new one leaves SEP presenting a password
  # PostgreSQL no longer has - and the symptom appears in SEP, not here.
  local sep_pw sep_token reused=0
  sep_pw="$(env_value "$out" PMM_SEP_POSTGRES_PASSWORD)"
  sep_token="$(env_value "$out" PMM_SEP_TOKEN)"
  [[ -n "$sep_pw" ]] && reused=1 || sep_pw="$(gen_secret 16)"
  [[ -n "$sep_token" ]] || sep_token="$(gen_secret 32)"

  OM_GENERATE_PMM_SEP_POSTGRES_PASSWORD="$sep_pw" \
  OM_GENERATE_PMM_SEP_TOKEN="$sep_token" \
  python3 - "$base" "$PMM_ENV_TEMPLATE" "$out" <<'PY' || die "rendering $out failed"
import os, re, sys

base_path, overlay_path, out_path = sys.argv[1:4]

# Only KEY=VALUE lines are overrides. A commented key in the overlay is
# documentation, exactly as it is in upstream's file.
overrides, order = {}, []
for line in open(overlay_path, encoding="utf-8"):
    match = re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
    if not match:
        continue
    key, value = match.group(1), match.group(2)
    if value == "@generate":
        value = os.environ["OM_GENERATE_" + key]
    overrides[key] = value
    order.append(key)

seen, out = set(), []
for line in open(base_path, encoding="utf-8"):
    match = re.match(r"^([A-Z_][A-Z0-9_]*)=", line)
    if match and match.group(1) in overrides:
        key = match.group(1)
        seen.add(key)
        out.append(f"{key}={overrides[key]}\n")
    else:
        out.append(line)

# Keys upstream's file has no line for, appended in the overlay's own order so the
# block reads as a unit rather than as scattered additions.
extra = [key for key in order if key not in seen]
if extra:
    out.append("\n# --- added by ./om env (harness/pmm-env.example) ---\n")
    out.extend(f"{key}={overrides[key]}\n" for key in extra)

open(out_path, "w", encoding="utf-8").writelines(out)
PY

  ok "pmm/.env rendered from .env.dev.example + harness/pmm-env.example"
  if [[ "$reused" == 1 ]]; then
    dim "kept the existing PMM_SEP_POSTGRES_PASSWORD (it is baked into /srv)"
  else
    dim "generated PMM_SEP_POSTGRES_PASSWORD and PMM_SEP_TOKEN"
  fi
}

# Renders SEP/.env from harness/sep-env.example, resolving the two placeholders.
#
# The Grafana token cannot exist before PMM does, so a cold workspace gets a file
# with everything else in it and a warning. Re-running after `./om start pmm` fills
# it in, which is the only ordering that can work.
env_sep() { # mode: create | refresh
  local mode="$1" out="$SEP_DIR/.env"
  [[ -f "$SEP_ENV_TEMPLATE" ]] || die "missing $SEP_ENV_TEMPLATE"
  [[ -d "$SEP_DIR" ]] || die "SEP/ not found - run: git submodule update --init"

  local existing_token=""
  if [[ -f "$out" ]]; then
    existing_token="$(env_value "$out" PMM__API_KEY)"
  fi

  # A token that is still the placeholder means the file was written on a cold
  # workspace, before PMM existed to mint one. Finishing that job is the whole
  # point of re-running, so it happens even in create mode - which otherwise
  # leaves an existing file alone.
  local unfinished=0
  [[ -z "$existing_token" || "$existing_token" == "@grafana-token" ]] && unfinished=1

  if [[ -f "$out" ]]; then
    if [[ "$mode" == create ]]; then
      if [[ "$unfinished" == 0 ]]; then
        dim "SEP/.env exists - left untouched"
        return 0
      fi
      dim "SEP/.env exists but has no Grafana token - completing it"
    else
      confirm "SEP/.env exists. Overwrite it?" || { dim "SEP/.env left untouched"; return 0; }
    fi
  fi

  local sep_pw internal token
  sep_pw="$(env_value "$PMM_DIR/.env" PMM_SEP_POSTGRES_PASSWORD)"
  [[ -n "$sep_pw" ]] || die "PMM_SEP_POSTGRES_PASSWORD is not in pmm/.env - run ./om env first"
  # Both halves of the same secret: pmm-managed sends it, SEP compares against it.
  internal="$(env_value "$PMM_DIR/.env" PMM_SEP_TOKEN)"
  [[ -n "$internal" ]] || die "PMM_SEP_TOKEN is not in pmm/.env - run ./om env first"

  if [[ -n "$existing_token" && "$existing_token" != "@grafana-token" ]]; then
    token="$existing_token"
    dim "kept the existing Grafana service account token"
  elif grafana_mint_token; then
    token="$GRAFANA_TOKEN"
    ok "minted a Grafana service account token (sep-local, role Admin)"
  else
    token="@grafana-token"
  fi

  sed -e "s|@sep-password|$sep_pw|g" -e "s|@pmm-sep-token|$internal|g" \
      -e "s|@grafana-token|$token|g" \
      "$SEP_ENV_TEMPLATE" > "$out.tmp" || die "rendering $out failed"
  mv "$out.tmp" "$out"

  if [[ "$token" == "@grafana-token" ]]; then
    ok "SEP/.env rendered, without the Grafana token"
    warn "no Grafana token: ${GRAFANA_ERROR:-PMM is not running}"
    dim "SEP cannot reach PMM until it has one, so nothing that talks to PMM will work:"
    dim "  ./om discovery sync fails with 401 'Auth method is not service account token'"
    dim "fix it with ./om env once PMM is up"
  else
    ok "SEP/.env rendered from harness/sep-env.example"
  fi
}

cmd_env() {
  local mode=refresh
  while (($#)); do
    case "$1" in
      -y|--yes) OM_YES=1 ;;
      --create) mode=create ;;
      *) die "usage: ./om env [-y] [--create]" ;;
    esac
    shift
  done

  info "env: pmm/.env"
  env_pmm "$mode"
  echo
  info "env: SEP/.env"
  env_sep "$mode"
}

om_setup_sep() {
  info "SEP: python environment"
  if [[ -x "$SEP_DIR/venv/bin/python" ]]; then
    dim "venv exists — refreshing dependencies"
  fi
  make -C "$SEP_DIR" venv
  ok "venv ready ($("$SEP_DIR/venv/bin/python" -V 2>&1))"

  info "SEP: database migrations"
  make -C "$SEP_DIR" migrate
  ok "sep.db / inventory.db / tasks.db up to date"

  bootstrap_beat_schema || warn "continuing; sep-backend will not start until this succeeds"

  info "SEP: frontend dependencies"
  ensure_node "$(node_version)" || true
  if node_ok && command -v pnpm >/dev/null 2>&1; then
    ( cd "$SEP_DIR/frontend" && pnpm install )
    ok "frontend node_modules ready"
  elif node_ok; then
    warn "skipped — node is fine (v$(node_version)) but pnpm is not active"
    dim "corepack enable && corepack prepare pnpm@$PNPM_PIN --activate"
  else
    local v; v="$(node_version)"
    warn "skipped — node >= $NODE_MIN required (found ${v:-none})"
    dim "sep-backend and pmm work without it; only sep-frontend is blocked"
  fi
}

# PMM_PORT_HTTPS is not corrected here any more.
#
# It used to be, and that was a trap: the correction ran at setup while `./om start
# pmm` is the first thing anyone does, so a .env written by hand went into a
# container published on 443 and compose interpolates the port at create time, not
# restart time. harness/pmm-env.example sets it instead, which means it is right
# before anything is started rather than after.
om_setup_pmm() {
  local envf="$PMM_DIR/.env"
  [[ -f "$envf" ]] || die "pmm/.env missing - run ./om env"

  local port; port="$(env_value "$envf" PMM_PORT_HTTPS)"
  if [[ "$port" != "$PMM_HTTPS_PORT" ]]; then
    warn "pmm/.env has PMM_PORT_HTTPS=${port:-unset}, not $PMM_HTTPS_PORT"
    dim "SEP pins PMM.ENDPOINT to https://127.0.0.1:$PMM_HTTPS_PORT; run ./om env to fix it"
  fi
}

cmd_setup() {
  cmd_doctor || warn "some prerequisites are missing — continuing with what is possible"
  echo
  # Before either component: SEP's .env derives its password from PMM's, so the
  # order is not a preference.
  cmd_env --create
  echo
  om_setup_sep
  echo
  om_setup_pmm
  echo
  info "Setup complete"
  dim "Next:  ./om start          (pmm + sep)"
  dim "       ./om env            again, once PMM is up, if the Grafana token is still missing"
  dim "       ./om build pmm      compile the PMM working tree into the server"
  dim "       ./om status"
}

# --- bootstrap --------------------------------------------------------------
#
# Everything a fresh clone needs, in the one order that works.
#
# Two of the orderings are forced, and neither is guessable from the commands'
# names - which is the entire reason this exists rather than four lines of README
# that people follow out of order once and then debug for an afternoon:
#
#   pmm/.env has to be right *before* PMM is created, not before it is restarted.
#   Compose interpolates the published port when the container is created, so a
#   container made against a wrong file stays wrong through every restart and only
#   a recreate fixes it.
#
#   PMM has to be running before `./om setup`, because SEP's migrations run
#   against the PostgreSQL inside the PMM container. In the other order they fail
#   with a connection error that looks like a SEP problem.
#
# `./om env` looks like it runs twice and does not: the cold run cannot mint a
# Grafana service account token because Grafana does not exist yet, and `./om
# setup` re-runs `./om env --create`, which finishes that one outstanding job. No
# ordering avoids the two passes - the token depends on the thing the token
# configures.
#
# Idempotent all the way through. Existing .env files, an already-running PMM and
# an up-to-date venv are all left as they are, so this doubles as the "put it back
# the way it should be" command rather than being a one-shot.
cmd_bootstrap() {
  info "bootstrap: PMM, SEP, and the dotenv files they share"
  dim "safe to re-run - each step leaves existing state alone"
  echo

  ensure_submodules
  echo

  info "1/4  dotenv files"
  cmd_env --create
  echo

  # Before setup, and with the .env files already correct, so the container is
  # created against the ports and flags it will keep.
  info "2/4  PMM"
  cmd_start pmm
  echo

  # Runs ./om env --create again as its second step, which is where the Grafana
  # token gets minted now that there is a Grafana to mint it against.
  info "3/4  SEP: venv, migrations, frontend"
  cmd_setup
  echo

  info "4/4  the rest of the stack"
  cmd_start
  echo

  ok "bootstrap complete"
  dim "PMM:  https://localhost:$PMM_HTTPS_PORT  (admin/admin)"
  dim "next: ./om build pmm     compile the PMM working tree into the server"
  dim "      ./om start <cluster>   standalone | replicaset-cluster | sharded-cluster | ..."
}

# A fresh clone has empty submodule directories and every later step then fails in
# its own unrelated-looking way. Tested by file rather than by directory, because
# a `git submodule update` that failed partway leaves the directories behind.
ensure_submodules() {
  [[ -f "$PMM_DIR/.env.dev.example" && -f "$SEP_DIR/settings.yaml" ]] && return 0
  info "submodules: pmm/ and SEP/ are not checked out"
  ( cd "$ROOT" && git submodule update --init ) \
    || die "git submodule update --init failed - check your access to percona/pmm and percona/SEP"
  ok "submodules initialised"

  # main() renders the settings file before dispatching to any command, and on a
  # fresh clone that render is a no-op: SEP/settings.yaml does not exist yet, and
  # it returns rather than failing. Everything downstream reads SETTINGS_FILE, so
  # without a second render the migrations build settings from pydantic defaults
  # and die on a missing CELERY.broker_url - a message naming neither the
  # submodule that was missing nor the file that was never written.
  render_sep_settings
  ok "settings rendered, now that SEP/ is present"
}

# ---------------------------------------------------------------------------
# start / stop per component
# ---------------------------------------------------------------------------

# 0 when the bundle nginx serves is our working tree's (i.e. carries the SEP apps).
pmm_ui_has_sep() {
  docker exec -i --user root "$PMM_CONTAINER" \
    grep -rqs "$PMM_UI_SEP_MARKER" "$PMM_UI_DIR" 2>/dev/null
}

# The devcontainer image has node but neither pnpm nor corepack, and `ui`'s own
# `make setup` assumes corepack. Install the version pinned by ui/package.json's
# `packageManager` so the lockfile is honoured, rather than whatever is latest.
ensure_container_pnpm() {
  docker exec -i --user root "$PMM_CONTAINER" sh -c 'command -v pnpm' >/dev/null 2>&1 && return 0
  local pinned
  pinned="$(sed -n 's/.*"packageManager": *"\(pnpm@[0-9.]*\).*/\1/p' "$PMM_DIR/ui/package.json" | head -1)"
  [[ -n "$pinned" ]] || pinned=pnpm
  dim "installing $pinned in the container (no pnpm/corepack in the dev image)"
  docker exec -i --user root "$PMM_CONTAINER" npm i -g "$pinned" >/dev/null 2>&1 \
    || { err "could not install $pinned in $PMM_CONTAINER"; return 1; }
}

# Build the working tree's UI over the image's prebuilt bundle. Without this the
# two SEP apps (Collect Diagnostic Data, MySQL Backups) are simply not in the
# JS nginx serves, so they appear nowhere in PMM no matter how the backend is
# configured. `build-ui` deploys a static bundle rather than running Vite, so it
# survives for the container's lifetime with no process to keep alive — but a
# container recreate resets it to the image's copy, which is why this runs on
# every start. Pass force=1 (or `./om build ui`) to rebuild after UI edits.
ensure_pmm_ui() {
  local force="${1:-0}"
  if [[ "${OM_PMM_UI:-1}" == "0" ]]; then
    dim "pmm-ui: skipped (OM_PMM_UI=0) — SEP apps will be missing from the UI"
    return 0
  fi
  if [[ "$force" != "1" ]] && pmm_ui_has_sep; then
    ok "pmm-ui: working tree bundle already deployed (SEP apps present)"
    return 0
  fi
  ensure_container_pnpm || { warn "pmm-ui: left at the image's bundle — SEP apps missing"; return 0; }
  info "pmm-ui: building ui/ and deploying over the image's bundle (minutes on a cold cache)"
  local log; log="$(log_file pmm-ui)"
  mkdir -p "$LOG_DIR"
  # No -t: there is no TTY here. build-ui restarts grafana at the end so the
  # pmm-compat plugin is reloaded alongside the new bundle.
  if docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" make build-ui >"$log" 2>&1; then
    if pmm_ui_has_sep; then
      ok "pmm-ui: deployed — /pmm-ui/sep/atw and /pmm-ui/sep/mysql-backups are live"
    else
      # A clean build whose output lacks the marker means the checked-out branch
      # does not carry the SEP routes, not that the deploy failed.
      warn "pmm-ui: built, but no SEP routes in it — is this branch missing PMM-15216?"
    fi
  else
    warn "pmm-ui: build failed — UI left at the image's bundle (SEP apps missing)"
    dim "log: $log"
    tail -n 15 "$log" >&2 || true
  fi
}

# Fingerprints the Go sources pmm-managed is built from: HEAD, plus the content of
# any uncommitted change under managed/ or api/. Content, not just filenames, so a
# second edit to the same file is still noticed.
pmm_tree_fingerprint() {
  # In a subshell that has actually cd'd: `git -C` moves git's directory but not the
  # shell's, so `cat` would look for the listed paths under the workspace root and
  # quietly find nothing -- which silently drops every new file from the fingerprint.
  (
    cd "$PMM_DIR" 2>/dev/null || exit 0
    git rev-parse HEAD 2>/dev/null || echo nohead
    git diff HEAD -- managed api 2>/dev/null || true
    git ls-files --others --exclude-standard -- managed api 2>/dev/null | xargs -r cat || true
  ) | sha1sum | cut -c1-16
}

# Rebuilds pmm-managed from the working tree when the container is not already
# running that build.
#
# This exists because a container recreate silently undoes `./om build pmm`. The
# image ships its own /usr/sbin/pmm-managed, `make run-managed-ci` installs the
# working tree's over it, and `make env-up` throws that away with the container --
# taking every route the tree adds with it. The symptom is a healthy gateway
# answering "endpoint not found" for an endpoint you know you wrote.
#
# The stamp sits next to the binary rather than in /srv on purpose: /srv is a volume
# and survives the recreate, so a stamp there would claim a build that is gone.
ensure_pmm_managed() {
  local force="${1:-0}"
  if [[ "${OM_PMM_MANAGED:-1}" == "0" ]]; then
    dim "pmm-managed: skipped (OM_PMM_MANAGED=0) — running the image's binary"
    return 0
  fi

  local want; want="$(pmm_tree_fingerprint)"
  local have
  have="$(docker exec -i --user root "$PMM_CONTAINER" cat "$PMM_MANAGED_STAMP" 2>/dev/null || true)"
  if [[ "$force" != "1" && -n "$have" && "$have" == "$want" ]]; then
    ok "pmm-managed: working tree build already deployed"
    return 0
  fi

  info "pmm-managed: compiling the working tree over the image's binary (a minute or two)"
  local log; log="$(log_file pmm-managed-build)"
  mkdir -p "$LOG_DIR"
  # As root: the module cache under /root/go is not writable by the default user, and
  # go refuses to build a repo git calls "dubious ownership" without this exception.
  docker exec -i --user root "$PMM_CONTAINER" \
    git config --global --add safe.directory "$PMM_WORKDIR" >/dev/null 2>&1 || true
  if docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" \
       make run-managed-ci >"$log" 2>&1; then
    docker exec -i --user root "$PMM_CONTAINER" \
      sh -c "printf '%s' '$want' > '$PMM_MANAGED_STAMP'" >/dev/null 2>&1 || true
    ok "pmm-managed: deployed from the working tree"
  else
    warn "pmm-managed: build failed — left at the image's binary, so routes your tree adds will 404"
    dim "log: $log"
    tail -n 15 "$log" >&2 || true
  fi
}

# pmm.conf with the workspace's SEP locations injected, written to harness/.
#
# PMM's nginx has no include hook inside its server block, so a location cannot
# be added without replacing the whole file. Rendering it from pmm's current copy
# on every start keeps PMM's other locations exactly as the checkout has them --
# a snapshot would drift, which is how SEP's own committed template ended up
# still proxying the five bare prefixes the SEP UI stopped using on 2026-08-10.
#
# The fragment goes in ahead of `location /pmm-ui`, inside the server block.
render_pmm_conf() {
  local src="$PMM_DIR/build/ansible/roles/nginx/files/conf.d/pmm.conf"
  local frag="$HARNESS_DIR/sep-locations.conf"
  local out="$HARNESS_DIR/pmm.conf"
  [[ -f "$src" ]]  || die "pmm.conf missing at $src"
  [[ -f "$frag" ]] || die "SEP locations fragment missing at $frag"
  grep -q '^    # PMM UI$' "$src" || die "pmm.conf has no '# PMM UI' anchor — render_pmm_conf needs updating"
  awk -v frag="$frag" '
    /^    # PMM UI$/ && !done { while ((getline line < frag) > 0) print line; print ""; done = 1 }
    { print }
  ' "$src" > "$out.tmp" || die "rendering pmm.conf failed"
  grep -q 'location /sep/' "$out.tmp" || die "rendered pmm.conf has no /sep location"
  mv "$out.tmp" "$out"
}

# Both compose files, in order. The first one fixes the project directory, so
# pmm/ must lead: it keeps the project name `pmm` (as `make env-up` produces) and
# makes the override's relative paths resolve against the pmm checkout.
pmm_compose() {
  ( cd "$PMM_DIR" && COMPOSE_PROFILES=pmm docker compose \
      -f docker-compose.dev.yml \
      -f "$HARNESS_DIR/pmm-compose.override.yml" "$@" )
}

start_pmm() {
  info "pmm: devcontainer (from repo)"
  [[ -f "$PMM_DIR/.env" ]] || die "pmm/.env missing — run ./om env"
  local img
  img="$(grep -E '^PMM_SERVER_IMAGE=' "$PMM_DIR/.env" | tail -1 | cut -d= -f2- || true)"
  if [[ -n "$img" ]] && ! docker image inspect "$img" >/dev/null 2>&1; then
    warn "$img is not present locally — first start pulls several GB"
  fi
  # PMM's own docker-compose.dev.yml plus harness/pmm-compose.override.yml, which
  # carries what this workspace needs and the pmm checkout should not: the SEP
  # nginx overlay, the host-gateway alias, and the entrypoint mounts the published
  # dev image is too old to provide. Then PMM's env-pg-config, which tunes the
  # embedded PostgreSQL on a fresh /srv volume.
  render_pmm_conf
  pmm_compose up -d --wait --wait-timeout 100
  make -C "$PMM_DIR" env-pg-config
  ok "pmm-server up — https://localhost:$PMM_HTTPS_PORT (admin/admin)"
  dim "running the image's binaries; './om build pmm' compiles your working tree"
  ensure_pmm_managed
  ensure_pmm_ui
}

stop_pmm() {
  info "pmm: devcontainer down"
  # Same file pair as the start, so compose tears down what it brought up.
  pmm_compose down --remove-orphans
  ok "pmm stopped"
}

start_sep_backend() {
  # A directory with no databases in it means ./om setup has not run for this one.
  # Worth saying now: SEP starts perfectly well against empty files and then fails
  # in ways that read as application bugs rather than "the migrations never ran".
  if [[ -n "$SEP_DB_DIR" && ! -f "$SEP_DB_DIR/sep.db" ]]; then
    warn "no databases in $SEP_DB_DIR - run ./om setup first"
    dim "OM_SEP_DB_DIR is read fresh on every invocation and remembered nowhere,"
    dim "so it has to be set for setup and for every command after it"
  fi

  # The celery worker + beat run in-process (SEP's --start-celery) by default:
  # without them nothing executes. Task execution is dispatched through celery
  # (app/tasks/routes.py :: execute_task_queue.apply_async), running-task status
  # comes from the 30s sync_running_tasks periodic, and the snippet catalog is
  # populated by sync_snippets.delay() at startup — with no worker those all
  # queue up in data/celery/broker/ and silently never run. SEP_CELERY=0 opts
  # out for the rare uvicorn-only case.
  local celery_note="" make_args=()
  if [[ "${SEP_CELERY:-1}" != "0" ]]; then
    make_args=(START_CELERY=1); celery_note=" + celery worker/beat"
  fi
  info "sep-backend: uvicorn (native, reload on)${celery_note}"
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  if [[ "${SEP_CELERY:-1}" == "0" ]] && ! beat_schema_ready; then
    err "the Celery beat schedule tables are missing, so startup would fail with"
    err "  'no such table: main.celery_intervalschedule'"
    die "run './om setup' (it bootstraps them), or drop SEP_CELERY=0"
  fi
  if port_busy "$SEP_BACKEND_PORT" && ! read_pid sep-backend >/dev/null; then
    die "port $SEP_BACKEND_PORT is already in use by something om did not start"
  fi
  start_native sep-backend "$SEP_DIR" make dev-backend "${make_args[@]}"
  # Cold start is slow: poetry-installed imports, the app registry, and the beat
  # model init all happen before uvicorn binds. Measured ~15s warm, longer cold.
  for _ in $(seq 1 90); do
    port_busy "$SEP_BACKEND_PORT" && { ok "listening on http://localhost:$SEP_BACKEND_PORT"; return 0; }
    read_pid sep-backend >/dev/null || { err "process exited during startup:"; tail -n 20 "$(log_file sep-backend)" >&2; return 1; }
    sleep 1
  done
  warn "not listening on :$SEP_BACKEND_PORT yet — ./om logs sep-backend"
}

start_sep_frontend() {
  info "sep-frontend: vite (native)"
  if ! ensure_node "$(node_version)"; then
    local v; v="$(node_version)"
    err "node >= $NODE_MIN required (found ${v:-none})"
    [[ -s "$HOME/.nvm/nvm.sh" ]] && dim "nvm install 22 && nvm alias default 22"
    die "then re-run ./om setup so pnpm install can complete"
  fi
  [[ -d "$SEP_DIR/frontend/node_modules" ]] \
    || die "frontend deps missing — run ./om setup first"

  # Vite dies at startup with ENOSPC / "Emitted 'error' event on FSWatcher" when the
  # per-user inotify *instance* limit is exhausted — not a disk problem, despite the
  # errno name. A desktop with two editors plus Electron apps routinely sits at the
  # 128 default, and this monorepo needs more. Raising it needs root, so fall back to
  # a polling watcher (more CPU, no root) and say so. OM_WATCH_POLLING=1 forces it,
  # OM_WATCH_POLLING=0 disables the fallback entirely.
  local polling="${OM_WATCH_POLLING:-auto}"
  if [[ "$polling" == "auto" ]]; then
    local used limit
    used="$(count_inotify_instances)"
    limit="$(cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null || echo 0)"
    if [[ "${limit:-0}" -gt 0 && "${used:-0}" -ge "$limit" ]]; then
      warn "inotify instances exhausted ($used/$limit) — using a polling file watcher"
      dim "permanent fix (needs root):"
      dim "  sudo tee /etc/sysctl.d/99-inotify.conf <<'EOF'"
      dim "  fs.inotify.max_user_instances = 1024"
      dim "  fs.inotify.max_user_watches = 524288"
      dim "  EOF"
      dim "  sudo sysctl --system"
      polling=1
    else
      polling=0
    fi
  fi
  [[ "$polling" == "1" ]] && export CHOKIDAR_USEPOLLING=1
  if port_busy "$SEP_FRONTEND_PORT" && ! read_pid sep-frontend >/dev/null; then
    die "port $SEP_FRONTEND_PORT is already in use by something om did not start"
  fi
  start_native sep-frontend "$SEP_DIR" make dev-frontend
  for _ in $(seq 1 30); do
    port_busy "$SEP_FRONTEND_PORT" && { ok "develop here: http://localhost:$SEP_FRONTEND_PORT"; return 0; }
    sleep 1
  done
  warn "not listening on :$SEP_FRONTEND_PORT yet — ./om logs sep-frontend"
}

# ---------------------------------------------------------------------------
# Sandbox nodes - the PSMDB clusters, and the database-less hosts beside them
# ---------------------------------------------------------------------------

psmdb_compose() { ( cd "$PSMDB_DIR" && docker compose "$@" ); }

# Containers currently up for a profile. Every service is named
# <profile>-<role><n> — standalone-node00, replicaset-cluster-node01,
# sharded-cluster-shard00svr0, pmm-client-node02 - so the profile name *is* the
# prefix and no lookup table can drift out of sync with compose.yaml.
#
# The alternative `$` branch is for a client node's private profile, where the
# profile name is the whole container name rather than a prefix of several
# (pmm-client-node01). It is what makes `./om start pmm-client-node01` count and
# wait for its one node instead of finding none.
#
# One ordering trap this creates: "replicaset-single" is not a prefix of
# "replicaset-cluster" and vice versa, so the counts stay disjoint. Keep it that
# way if you add a topology.
psmdb_running() {
  docker ps --format '{{.Names}}' 2>/dev/null | grep -cE "^$1(-|\$)" || true
}

# Every node profile with at least one container up, in NODE_PROFILES order.
psmdb_up_profiles() {
  local p
  for p in "${NODE_PROFILES[@]}"; do
    [[ "$(psmdb_running "$p")" -gt 0 ]] && printf '%s\n' "$p"
  done
  return 0
}

# Writes that set down, so a later bare `./om start` can restore it. Called only by
# the argument-less `./om stop`: an explicit `./om stop sharded-cluster` is a
# statement about one profile, not about what the machine should look like next
# time, and must not overwrite the memory.
#
# Records the pool profile for the client hosts, not the individual nodes, so a
# machine left with one client host up comes back with all of them. Restoring the
# exact set is not worth a second state file for hosts this cheap.
psmdb_remember_up() {
  mkdir -p "$(dirname "$PSMDB_LAST_UP_FILE")"
  psmdb_up_profiles > "$PSMDB_LAST_UP_FILE"
}

# Reads it back, dropping anything that is no longer a known profile -- a stale
# entry from a renamed topology should be ignored, not passed to Compose.
psmdb_remembered() {
  [[ -f "$PSMDB_LAST_UP_FILE" ]] || return 0
  local line p
  while read -r line; do
    [[ -n "$line" ]] || continue
    for p in "${NODE_PROFILES[@]}"; do
      [[ "$line" == "$p" ]] && printf '%s\n' "$line" && break
    done
  done < "$PSMDB_LAST_UP_FILE"
  return 0
}

# True when the argument names one of the declared client nodes. Generated from
# CLIENT_NODES rather than matched with a glob so `./om start pmm-client-node07`
# is rejected here, with the list of what exists, instead of reaching compose -
# which answers an unknown profile by starting nothing and saying nothing.
client_node_name() {
  local n
  for (( n = 0; n < CLIENT_NODES; n++ )); do
    [[ "$1" == "$(printf '%s-node%02d' "$CLIENT_PROFILE" "$n")" ]] && return 0
  done
  return 1
}

client_node_names() {
  local n
  for (( n = 0; n < CLIENT_NODES; n++ )); do
    printf '%s-node%02d\n' "$CLIENT_PROFILE" "$n"
  done
}

# The root credentials every node is bootstrapped with, read from compose.yaml so a
# change there does not leave om printing a URI that cannot log in.
psmdb_credentials() {
  local user pass
  user="$(sed -n 's/^ *MONGO_ROOT_USER: *//p' "$PSMDB_DIR/compose.yaml" | head -1)"
  pass="$(sed -n 's/^ *MONGO_ROOT_PASSWORD: *//p' "$PSMDB_DIR/compose.yaml" | head -1)"
  printf '%s:%s' "${user:-root}" "${pass:-root-password}"
}

# The MongoDB URI for one running profile.
#
# Seeds come from the running containers rather than a table, for the reason
# psmdb_running gives: the profile name is the container-name prefix, so nothing can
# drift out of sync with compose.yaml. A sharded cluster is addressed through its
# routers, so only the mongos nodes are seeds -- the config servers (27019) and shard
# members (27018) are not where a client connects.
#
# Both replica-set profiles name their set after the profile, so ?replicaSet= is the
# profile name. A standalone and a mongos take no such parameter.
psmdb_uri() {
  local profile="$1" filter="^$1-" seeds
  [[ "$profile" == sharded-cluster ]] && filter="^$1-mongos"
  seeds="$(docker ps --format '{{.Names}}' 2>/dev/null | grep "$filter" | sort \
           | sed 's/$/:27017/' | paste -sd, -)"
  [[ -n "$seeds" ]] || return 1
  local params="authSource=admin"
  [[ "$profile" == replicaset-* ]] && params="replicaSet=$profile&$params"
  printf 'mongodb://%s@%s/?%s' "$(psmdb_credentials)" "$seeds" "$params"
}

# The first running container of a profile, for the docker exec hint.
psmdb_first_node() {
  local filter="^$1-"
  [[ "$1" == sharded-cluster ]] && filter="^$1-mongos"
  docker ps --format '{{.Names}}' 2>/dev/null | grep "$filter" | sort | head -1
}

# ---------------------------------------------------------------------------
# hosts — make the cluster names resolve on this machine
# ---------------------------------------------------------------------------
#
# With these in /etc/hosts the network URIs from `./om status` work from the host
# as-is, replica sets included: the driver resolves the seed, asks the set for its
# members, and resolves those too. That is the part directConnection=true has to
# skip.
#
# The catch is that container IPs are not stable. Docker hands out the next free
# address, so one `./om restart standalone` moved a node from .4 to .8 here -- and
# .4 can later belong to a different node, which turns a stale entry into a URI
# that quietly reaches the wrong database. Hence: regenerated from live containers
# on every run, written as one replaceable block, never appended to.

HOSTS_FILE=/etc/hosts
HOSTS_BEGIN="# >>> om psmdb >>>"
HOSTS_END="# <<< om psmdb <<<"

psmdb_hosts_block() {
  local pattern name ip
  pattern="^($(IFS='|'; printf '%s' "${NODE_PROFILES[*]}"))-"
  printf '%s\n' "$HOSTS_BEGIN"
  printf '# %s — regenerate with ./om hosts --write after any cluster restart\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  while read -r name; do
    [[ -n "$name" ]] || continue
    ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$name" 2>/dev/null)"
    [[ -n "$ip" ]] && printf '%-15s %s\n' "$ip" "$name"
  done < <(docker ps --format '{{.Names}}' 2>/dev/null | grep -E "$pattern" | sort)
  printf '%s\n' "$HOSTS_END"
}

# True when /etc/hosts carries a block that no longer matches the running containers.
psmdb_hosts_stale() {
  grep -q "^$HOSTS_BEGIN\$" "$HOSTS_FILE" 2>/dev/null || return 1
  local current live
  current="$(sed -n "/^$HOSTS_BEGIN\$/,/^$HOSTS_END\$/p" "$HOSTS_FILE" | grep -vE '^#')"
  live="$(psmdb_hosts_block | grep -vE '^#')"
  [[ "$current" != "$live" ]]
}

cmd_hosts() {
  local mode="${1:-print}"
  case "$mode" in
    print|--print|-p)
      local body; body="$(psmdb_hosts_block)"
      if [[ "$(printf '%s' "$body" | grep -cE '^[0-9]')" -eq 0 ]]; then
        warn "no cluster containers are running — start one first"
        return 0
      fi
      info "Add this to $HOSTS_FILE (needs sudo), or run: ./om hosts --write"
      printf '%s\n' "$body"
      psmdb_hosts_stale && warn "the block already in $HOSTS_FILE is out of date"
      return 0
      ;;
    --write|write|-w) ;;
    --remove|remove|-r) ;;
    *) die "usage: ./om hosts [--write|--remove]   (default: print)" ;;
  esac

  [[ -w "$HOSTS_FILE" ]] || info "editing $HOSTS_FILE needs sudo — you may be prompted"
  # Kept: the file is system state, and a bad edit here breaks name resolution for
  # everything, not just this workspace.
  sudo cp -n "$HOSTS_FILE" "$HOSTS_FILE.om.bak" 2>/dev/null || true
  # Always drop the old block before writing, so repeated runs replace rather than
  # stack up stale addresses.
  sudo sed -i "/^$HOSTS_BEGIN\$/,/^$HOSTS_END\$/d" "$HOSTS_FILE" \
    || die "could not edit $HOSTS_FILE"

  case "$mode" in
    --remove|remove|-r)
      ok "removed the om block from $HOSTS_FILE"
      return 0
      ;;
  esac

  psmdb_hosts_block | sudo tee -a "$HOSTS_FILE" >/dev/null \
    || die "could not write to $HOSTS_FILE"
  ok "wrote $(psmdb_hosts_block | grep -cE '^[0-9]') entr(y|ies) to $HOSTS_FILE"
  dim "the network URIs from ./om status now work from this machine"
  dim "re-run after restarting a cluster; ./om hosts --remove takes them out again"
}

# The node image is ~1.6 GB and takes a few minutes: build it once, on demand,
# rather than making every user remember a separate step.
#
# Two images come out of the one psmdb/Dockerfile, selected by --build-arg, so a
# workspace that only ever starts client hosts never builds the database one and
# vice versa. Both are cached on the tag alone: change the Dockerfile or anything
# under psmdb/scripts and you must rebuild by hand, since an existing tag is
# taken at face value here.
ensure_node_image() {
  local image="$1"; shift
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  info "psmdb: building $image (first time only, a few minutes)"
  ( cd "$PSMDB_DIR" && docker build "$@" -t "$image" . ) \
    || die "failed to build $image"
  ok "image built"
}

# True when any of this profile's existing containers is pinned to a pmm_default
# that no longer exists.
#
# compose.yaml joins pmm_default as an *external* network, so compose matches it
# by name and never notices that the network behind the name changed. Docker,
# though, records the network's *id* on a container when it is created: restart
# PMM's compose stack and pmm_default is destroyed and recreated with a fresh id,
# stranding every cluster container that predates the restart. `up -d` then
# starts them unchanged and the daemon refuses:
#
#   Error response from daemon: failed to set up container networking:
#   network 9578f6b1... not found
#
# Only recreating the container clears it, and compose will not do that on its
# own — from its side nothing changed. So detect the divergence and ask for it.
# The service list comes from compose rather than from the <profile>-* name
# prefix, which also covers the profile-less services (minio) that come up
# alongside every topology and go stale the same way.
psmdb_stale_network() {
  local profile="$1" want svcs cid nid
  want="$(docker network inspect -f '{{.Id}}' "$PSMDB_NETWORK" 2>/dev/null)" || return 1
  [[ -n "$want" ]] || return 1

  mapfile -t svcs < <(psmdb_compose --profile "$profile" config --services 2>/dev/null || true)
  [[ "${#svcs[@]}" -gt 0 ]] || return 1

  while IFS= read -r cid; do
    [[ -n "$cid" ]] || continue
    # Empty for a container that was created but never attached; nothing to fix.
    nid="$(docker inspect \
      -f "{{index .NetworkSettings.Networks \"$PSMDB_NETWORK\" \"NetworkID\"}}" \
      "$cid" 2>/dev/null || true)"
    [[ -n "$nid" && "$nid" != "$want" ]] && return 0
  done < <(psmdb_compose ps -aq "${svcs[@]}" 2>/dev/null || true)

  return 1
}

start_sandbox_node() {
  local profile="$1"
  [[ -d "$PSMDB_DIR" ]] || die "psmdb/ not found at $PSMDB_DIR"

  # These nodes join the network PMM's compose creates. Without it, `docker
  # compose up` fails with an "external network not found" that reads like a
  # config bug rather than "start PMM first".
  docker network inspect "$PSMDB_NETWORK" >/dev/null 2>&1 \
    || die "network $PSMDB_NETWORK missing — run './om start pmm' first"

  # Both the pool profile and a single node's private profile start with
  # $CLIENT_PROFILE, so one test covers `pmm-client` and `pmm-client-node01`.
  if [[ "$profile" == "$CLIENT_PROFILE"* ]]; then
    ensure_node_image "$CLIENT_IMAGE" --build-arg WITH_PSMDB=0
  else
    ensure_node_image "$PSMDB_IMAGE"
    # The keyfile is replica-set internal auth. A client host mounts none and
    # joins nothing, so generating one for it would be theatre.
    [[ -f "$PSMDB_DIR/secrets/keyfile" ]] || ( cd "$PSMDB_DIR" && ./bootstrap.sh >/dev/null )
  fi

  local recreate=()
  if psmdb_stale_network "$profile"; then
    warn "$profile: containers are pinned to a $PSMDB_NETWORK that no longer exists"
    dim "PMM's compose stack was restarted since they were created; recreating them"
    dim "(named volumes are kept, so the data survives)"
    recreate=(--force-recreate)
  fi

  info "$profile: docker compose (profile '$profile')"
  psmdb_compose --profile "$profile" up -d "${recreate[@]}"

  # Registration is the useful readiness signal, not "container started": a node
  # is only usable once its pmm-agent has connected, which on a database node also
  # means register.sh has written the credentials file the SEP payloads read.
  #
  # /run/om-node-ready is published by register.sh and register-client.sh alike,
  # so this one test covers a database node and a client host without asking which
  # it is looking at. /root/.mongodb_uri is the same signal from before the marker
  # existed - kept so a psmdb-node image built earlier still reports ready rather
  # than timing out until it is rebuilt.
  local pattern nodes i ready
  pattern="^$profile(-|\$)"
  nodes="$(docker ps --format '{{.Names}}' | grep -cE "$pattern" || true)"
  for i in $(seq 1 60); do
    ready=0
    local n
    while IFS= read -r n; do
      [[ -n "$n" ]] || continue
      docker exec "$n" sh -c \
        'test -f /run/om-node-ready || test -f /root/.mongodb_uri' >/dev/null 2>&1 \
        && ready=$((ready + 1))
    done < <(docker ps --format '{{.Names}}' | grep -E "$pattern" || true)
    if [[ "$ready" -ge "$nodes" ]] && [[ "$nodes" -gt 0 ]]; then
      ok "$profile: $nodes/$nodes node(s) up and registered with PMM"
      return 0
    fi
    sleep 5
  done
  warn "$profile: only $ready/$nodes node(s) finished bootstrap — ./om logs $profile"
}

stop_sandbox_node() {
  local profile="$1"
  info "$profile: stopping"
  psmdb_compose --profile "$profile" stop >/dev/null 2>&1 || true
  # A client host writes nothing it would want back, so there is no data to
  # reassure anyone about and no `down -v` worth suggesting.
  if [[ "$profile" == "$CLIENT_PROFILE"* ]]; then
    ok "$profile stopped (containers kept; these hosts carry no data)"
  else
    ok "$profile stopped (containers kept; data volumes intact)"
    dim "wipe its data with: cd psmdb && docker compose --profile $profile down -v"
  fi
}

# ---------------------------------------------------------------------------
# ports — what each stack publishes onto the host
# ---------------------------------------------------------------------------
#
# The PSMDB clusters publish nothing (psmdb/compose.yaml maps no host ports), so
# only the SEP and PMM stacks are in play and nothing currently collides.
# ---------------------------------------------------------------------------
# reset - put the workspace back to something ./om setup can rebuild
# ---------------------------------------------------------------------------
#
# Three tiers, because "clear everything" spans things that cost seconds to rebuild
# and things that cannot be rebuilt at all:
#
#   state   run state and rendered files. Seconds. Safe.
#   data    the databases and the cluster volumes. Minutes, and the estate is gone.
#   all     the above plus the venv, node_modules, containers and images. Tens of
#           minutes, because the PSMDB image is ~1.6 GB and PMM's is larger.
#
# SEP/.env survives every tier unless --env is passed. It holds per-machine secrets
# nothing local can regenerate -- the PMM service-account token above all -- so
# deleting it turns a five-minute reset into "find the token again", which is not
# what anyone means by "reset".

reset_state() {
  info "state: run state and rendered settings"
  rm -rf "$PID_DIR" "$LOG_DIR" "$PSMDB_LAST_UP_FILE"
  rm -f "$SEP_SETTINGS" "$SEP_SETTINGS.tmp"
  ok "removed .om/ run state; harness/sep-settings.yaml is re-rendered every run"
}

reset_data() {
  info "data: SEP's databases, the cluster volumes and PMM's /srv"

  # On the default backend SEP's data is inside PMM's /srv, so reset_pmm_data below
  # is what clears it and there is nothing to do here.
  #
  # This used to drop the `pom` and `public` schemas over psql instead, on the
  # reasoning that the `sep` database itself is provisioned by PMM's postgres-sep
  # and should outlive a reset. That became unreachable the moment this tier
  # started removing pmm-data: cmd_reset stops everything before calling us, so
  # the container was always gone by the time the drop was attempted, and the only
  # thing it ever printed was "pmm-server is not running; skipped the database" -
  # a warning about a step whose work had already been done a few lines later.
  # Provisioning is not a reason to keep it either: postgres-sep re-runs on every
  # start, so a removed volume comes back with the role and database in place.
  if [[ -n "$SEP_DB_DIR" ]]; then
    rm -f "$SEP_DB_DIR"/*.db
    ok "removed the SQLite files under $SEP_DB_DIR"
  else
    dim "SEP's tables live in PMM's /srv; they go with the volume below"
  fi

  if [[ -d "$PSMDB_DIR" ]]; then
    local profile
    for profile in "${NODE_PROFILES[@]}"; do
      psmdb_compose --profile "$profile" down -v >/dev/null 2>&1 || true
    done
    ok "psmdb containers and data volumes removed"
  fi

  reset_pmm_data
}

# PMM's /srv, which is the volume people mean when a container will not start.
#
# It used to be left alone, and the omission was silent: `reset data` claimed to
# clear data and then reported success while the one volume worth clearing stayed
# behind. That matters most when the image has changed underneath the volume,
# because /srv then holds files the new image's entrypoint cannot remove - a
# denied `rm` in the Grafana plugin sync is enough to kill an entrypoint that runs
# under `set -o errexit`, and the container exits 1 before supervisord logs a line.
#
# Named, not derived: docker-compose.dev.yml declares `name: pmm-data` with no
# project prefix, so it is that exact volume and it is shared by every checkout on
# the machine.
reset_pmm_data() {
  docker volume inspect pmm-data >/dev/null 2>&1 || { dim "no pmm-data volume"; return 0; }

  # The container holds the volume open, and a running PMM is also the one case
  # where wiping it is more likely to be a mistake than an intention.
  if docker ps --format '{{.Names}}' | grep -qx "$PMM_CONTAINER"; then
    warn "$PMM_CONTAINER is running; kept its /srv volume"
    dim "to clear it: ./om stop pmm && ./om reset data"
    return 0
  fi

  if docker volume rm pmm-data >/dev/null 2>&1; then
    ok "removed the pmm-data volume (PMM's /srv)"
    dim "next ./om start pmm re-provisions PostgreSQL, Grafana and the sep database"
  else
    warn "could not remove the pmm-data volume - something still has it open"
    dim "docker ps -a --filter volume=pmm-data"
  fi
}

# Everything a `./om bootstrap` can rebuild, so that it has to.
#
# The point of this tier is that nothing survives to explain a later success: a
# workspace that still works because of a cached artefact is not a workspace whose
# setup works, and that difference is only ever discovered by a colleague.
reset_all() {
  info "all: build outputs, caches, containers and images"
  rm -rf "$SEP_DIR/venv" "$SEP_DIR/frontend/node_modules"
  ok "removed SEP's venv and frontend/node_modules"

  docker rm -f "$PMM_CONTAINER" >/dev/null 2>&1 && ok "removed $PMM_CONTAINER" || true

  # PMM's devcontainer build caches. Keeping them makes the next start much
  # faster and makes it a different thing from the one a fresh clone performs -
  # a broken `make setup` inside the container stays hidden behind a warm
  # node_modules, which is exactly the class of bug this tier exists to expose.
  local volume removed=()
  for volume in go-modules node-modules go-cache; do
    docker volume inspect "$volume" >/dev/null 2>&1 || continue
    docker volume rm "$volume" >/dev/null 2>&1 && removed+=("$volume") \
      || warn "could not remove the $volume volume - something still has it open"
  done
  [[ ${#removed[@]} -gt 0 ]] && ok "removed the devcontainer caches: ${removed[*]}"

  docker image rm -f "$PSMDB_IMAGE" "$CLIENT_IMAGE" >/dev/null 2>&1 \
    && ok "removed the psmdb node images" || true
  rm -f "$PSMDB_DIR/secrets/keyfile"
  dim "the keyfile is regenerated on the next cluster start"

  # Both dotenv files, always, and without asking - which is only defensible
  # because this tier has already removed pmm-data. Keeping them would be worse
  # than dropping them: PMM_SEP_POSTGRES_PASSWORD would survive into a workspace
  # whose `sep` role no longer exists, and `./om env` would faithfully reuse a
  # password for a role that is about to be provisioned with a different one.
  rm -f "$PMM_DIR/.env" "$SEP_DIR/.env"
  ok "removed pmm/.env and SEP/.env"
  dim "./om env regenerates both, including a fresh Grafana token"
}

# The PMM server image, which `all` deliberately leaves alone.
#
# Several GB over the network rather than something rebuilt locally, so it is a
# flag rather than part of a tier: almost nobody clearing their workspace means
# "and re-download the image", and the ones who do know they mean it.
reset_images() {
  local img
  img="$(env_value "$PMM_DIR/.env" PMM_SERVER_IMAGE)"
  [[ -n "$img" ]] || img="$(sed -n 's/^PMM_SERVER_IMAGE=//p' "$PMM_DIR/.env.dev.example" | tail -1)"
  [[ -n "$img" ]] || { dim "no PMM_SERVER_IMAGE to remove"; return 0; }

  if docker image rm -f "$img" >/dev/null 2>&1; then
    ok "removed $img"
    warn "the next ./om start pmm pulls it again - several GB"
  else
    dim "$img was not present locally"
  fi
}

RESET_USAGE="usage: ./om reset <state|data|all> [--env] [--images]
    state    run state and rendered settings (safe)
    data     ...and SEP's databases, the cluster volumes and PMM's /srv (pmm-data)
    all      ...and the venv, node_modules, devcontainer caches, the PMM
             container, the psmdb images, and both .env files
    --env    also delete the .env files on the state/data tiers ('all' always does)
    --images also delete the PMM server image; the next start re-pulls several GB"

cmd_reset() {
  local tier="" drop_env="" drop_images=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --state|state) tier=state ;;
      --data|data)   tier=data ;;
      --all|all)     tier=all ;;
      --env)         drop_env=1 ;;
      --images)      drop_images=1 ;;
      *) die "$RESET_USAGE" ;;
    esac
  done
  [[ -n "$tier" ]] || die "$RESET_USAGE"

  warn "this removes local state; nothing in git is touched"
  dim "stopping everything first"
  cmd_stop >/dev/null 2>&1 || true

  # Before reset_all, which needs pmm/.env to know which image to remove.
  [[ -n "$drop_images" ]] && reset_images

  reset_state
  [[ "$tier" == data || "$tier" == all ]] && reset_data
  [[ "$tier" == all ]] && reset_all

  # 'all' has already dropped both files as part of clearing everything a
  # bootstrap rebuilds; this is the opt-in for the tiers that have not.
  if [[ -n "$drop_env" && "$tier" != all ]]; then
    rm -f "$PMM_DIR/.env" "$SEP_DIR/.env"
    warn "removed pmm/.env and SEP/.env"
    # Only a hazard below the 'all' tier, where pmm-data may still hold a `sep`
    # role provisioned with the password that just went. ./om env then generates
    # a new one and SEP authenticates with a password PostgreSQL does not have.
    [[ "$tier" == state ]] && dim "pmm-data still holds the old sep role - clear it too, or SEP will not connect"
  elif [[ "$tier" != all ]]; then
    dim "the .env files were kept (pass --env to remove them too)"
  fi

  echo
  ok "reset to '$tier'"
  if [[ "$tier" == all ]]; then
    dim "next: ./om bootstrap   (rebuilds everything from a clean slate)"
  else
    dim "next: ./om bootstrap"
  fi
}

cmd_ports() {
  info "Known host ports"
  printf '  %-6s %-22s %s\n' PORT OWNER NOTE
  printf '  %-6s %-22s %s\n' 8000  "SEP backend"        "om"
  printf '  %-6s %-22s %s\n' 5174  "SEP frontend"       "om"
  printf '  %-6s %-22s %s\n' 8443  "repo PMM HTTPS"     "pmm/.env PMM_PORT_HTTPS"
  printf '  %-6s %-22s %s\n' 5432  "repo PMM Postgres"  "pmm/docker-compose.dev.yml"
  printf '  %-6s %-22s %s\n' 9090  "repo PMM VictoriaM" "pmm/docker-compose.dev.yml"
  printf '  %-6s %-22s %s\n' 9000  "repo PMM ClickHouse" "pmm/docker-compose.dev.yml"
  printf '  %-6s %-22s %s\n' 8123  "repo PMM CH HTTP"   "pmm/docker-compose.dev.yml"
  printf '  %-6s %-22s %s\n' 5173  "repo PMM Vite HMR"  "distinct from SEP's 5174"
  echo
  info "Currently listening"
  local p
  for p in 8000 5174 8443 5432 9090 9000 8123 5173; do
    port_busy "$p" && printf '  %s●%s %s\n' "$C_GREEN" "$C_RESET" "$p"
  done
}

# ---------------------------------------------------------------------------
# build (PMM from source)
# ---------------------------------------------------------------------------

cmd_build() {
  local what="${1:-pmm}"
  case "$what" in
    pmm|ui) ;;
    *) die "only 'pmm' (Go services) or 'ui' (frontend) can be built; got '$what'" ;;
  esac
  docker inspect "$PMM_CONTAINER" >/dev/null 2>&1 \
    || die "$PMM_CONTAINER is not running — ./om start pmm first"
  if [[ "$what" == "ui" ]]; then
    # Forced: `./om start pmm` only rebuilds when the deployed bundle has no SEP
    # routes at all, so this is how UI edits reach the browser without Vite.
    ensure_pmm_ui 1
    return 0
  fi
  info "pmm: compiling working tree (run-all) — this takes a few minutes"
  # `run-all` chains the *-ci targets, which rebuild each Go service and restart
  # it under supervisorctl WITHOUT tailing logs. The bare `run-managed` target
  # tails forever and would hang a script. No -t: there is no TTY here.
  #
  # As root, for the same two reasons ensure_pmm_managed is: the module cache under
  # /root/go is not writable by the default user, and git refuses the repo without
  # the safe.directory exception.
  docker exec -i --user root "$PMM_CONTAINER" \
    git config --global --add safe.directory "$PMM_WORKDIR" >/dev/null 2>&1 || true
  docker exec -i --user root --workdir="$PMM_WORKDIR" "$PMM_CONTAINER" make run-all
  # Stamp it so `./om start pmm` does not immediately rebuild what was just built.
  docker exec -i --user root "$PMM_CONTAINER" \
    sh -c "printf '%s' '$(pmm_tree_fingerprint)' > '$PMM_MANAGED_STAMP'" >/dev/null 2>&1 || true
  ok "pmm-managed, pmm-agent, qan-api2 and vmproxy rebuilt from your tree"
}

# ---------------------------------------------------------------------------
# inventory — PMM's inventory as JSON on stdout
# ---------------------------------------------------------------------------
#
# pmm-managed splits the inventory over three endpoints, and each one answers
# with a map keyed by type — {"generic": [...], "container": [...]} — not a flat
# list, so the type of a record lives in the key rather than in the record. None
# of the three joins to the others either: a service points at a node_id, an
# exporter points at a service_id *and* a pmm_agent_id, and only the pmm_agent
# itself knows which node it runs on. Doing that stitching here is the whole
# point of the command — `./om inventory` emits one document you can jq in a
# single pass instead of three curls and a manual join.
#
# Everything on stdout is JSON and nothing else, so this is safe to pipe.

# The dev container's Grafana admin. Overridable because a PMM started outside
# `./om start pmm` may have had its password changed on first login.
PMM_USER="${OM_PMM_USER:-admin}"
PMM_PASSWORD="${OM_PMM_PASSWORD:-admin}"

# GETs a pmm-managed API path and prints the body. A service account token in
# OM_PMM_API_KEY wins over basic auth — the same kind of token SEP/.env holds as
# PMM__API_KEY, though this deliberately does not read SEP's .env: the inventory
# is PMM's, and asking for it should not require SEP to be set up at all.
pmm_api_get() { # path -> body on stdout
  local url="https://localhost:$PMM_HTTPS_PORT$1" resp code
  local -a auth=(-u "$PMM_USER:$PMM_PASSWORD")
  [[ -n "${OM_PMM_API_KEY:-}" ]] && auth=(-H "Authorization: Bearer $OM_PMM_API_KEY")
  # -w appends the status on its own line; curl's own failure (connection
  # refused, timeout) is the non-zero exit.
  resp="$(curl -sk -m 20 -w $'\n%{http_code}' "${auth[@]}" "$url")" \
    || die "cannot reach PMM at https://localhost:$PMM_HTTPS_PORT — running? (./om start pmm)"
  code="${resp##*$'\n'}"
  resp="${resp%$'\n'*}"
  case "$code" in
    200) printf '%s' "$resp" ;;
    401|403) die "PMM rejected the credentials for $1 (HTTP $code) — set OM_PMM_USER / OM_PMM_PASSWORD, or OM_PMM_API_KEY" ;;
    *)   die "PMM returned HTTP $code for $1: $(printf '%s' "$resp" | head -c 200)" ;;
  esac
}

# Folds the map key into each record as $key, turning PMM's type-keyed map into
# the flat array the rest of the program (and any consumer) actually wants.
JQ_FLATTEN='def flatten_by($key): [ to_entries[] | .key as $t | (.value // [])[] | . + {($key): $t} ];'

# Nodes own services, services own their exporters/QAN agents, and whatever is
# left attaches to the node itself (pmm_agent, node_exporter, and friends).
# `orphans` is not decoration: it makes the tree lossless, so a service whose
# node PMM no longer lists still shows up instead of vanishing from the output.
JQ_INVENTORY_TREE="$JQ_FLATTEN"'
  ($nodes    | flatten_by("node_type"))    as $N |
  ($services | flatten_by("service_type")) as $S |
  ($agents   | flatten_by("agent_type"))   as $A |
  # agent_id -> node_id, the mapping only pmm_agent records carry.
  ([ $A[] | select(.agent_type == "pmm_agent") | {key: .agent_id, value: .runs_on_node_id} ]
   | from_entries) as $node_of |
  # Give every agent a node_id: its own if it is a pmm_agent, else its parents.
  ([ $A[] | . + {node_id: (.runs_on_node_id // $node_of[.pmm_agent_id // ""] // null)} ]) as $A |
  ([ $S[] | .service_id ]) as $service_ids |
  ([ $N[] | .node_id ])    as $node_ids |
  {
    pmm_server: $pmm,
    counts: {nodes: ($N | length), services: ($S | length), agents: ($A | length)},
    nodes: [ $N[] | . as $n | $n + {
      services: [ $S[] | select(.node_id == $n.node_id) | . as $s | $s + {
        agents: [ $A[] | select(.service_id == $s.service_id) ]
      } ],
      agents: [ $A[] | select(.node_id == $n.node_id and (.service_id == null)) ]
    } ],
    orphans: {
      services: [ $S[] | . as $s | select($node_ids | index($s.node_id) | not) ],
      agents: [ $A[] | . as $a | select(
        if $a.service_id != null then ($service_ids | index($a.service_id) | not)
        else ($a.node_id == null or ($node_ids | index($a.node_id) | not)) end
      ) ]
    }
  }'

cmd_inventory() {
  command -v jq >/dev/null 2>&1 || die "jq not found — install jq"
  local what="${1:-tree}"
  case "$what" in
    tree|nodes|services|agents|raw) ;;
    *) die "usage: ./om inventory [tree|nodes|services|agents|raw]" ;;
  esac

  # One endpoint is enough for the flat views; only the tree needs the join.
  case "$what" in
    nodes)    pmm_api_get /v1/inventory/nodes    | jq "$JQ_FLATTEN"'flatten_by("node_type")';    return ;;
    services) pmm_api_get /v1/inventory/services | jq "$JQ_FLATTEN"'flatten_by("service_type")'; return ;;
    agents)   pmm_api_get /v1/inventory/agents   | jq "$JQ_FLATTEN"'flatten_by("agent_type")';   return ;;
  esac

  local nodes services agents
  nodes="$(pmm_api_get /v1/inventory/nodes)"
  services="$(pmm_api_get /v1/inventory/services)"
  agents="$(pmm_api_get /v1/inventory/agents)"

  if [[ "$what" == "raw" ]]; then
    jq -n --argjson nodes "$nodes" --argjson services "$services" --argjson agents "$agents" \
      '{nodes: $nodes, services: $services, agents: $agents}'
    return
  fi
  jq -n --arg pmm "https://localhost:$PMM_HTTPS_PORT" \
        --argjson nodes "$nodes" --argjson services "$services" --argjson agents "$agents" \
        "$JQ_INVENTORY_TREE"
}

# ---------------------------------------------------------------------------
# uris — the HTTP surface each component exposes beyond its landing page
# ---------------------------------------------------------------------------
#
# One table, two consumers: `./om status` prints a component's entries beneath
# it while it is up, `./om urls` prints the lot whatever is running. The PMM
# paths are the ones its nginx actually serves — see
# pmm/build/ansible/roles/nginx/files/conf.d/pmm.conf; VictoriaMetrics runs with
# --http.pathPrefix=/prometheus (managed/services/supervisord/supervisord.go),
# which is why vmui hangs off /prometheus and not /victoriametrics.
#
# Deliberately absent: the ClickHouse (8123/9000) and VictoriaMetrics (9090)
# host ports from pmm/docker-compose.dev.yml. They are published, but both
# daemons bind 127.0.0.1 *inside* the container, so connecting to them from the
# host just gets a reset — reach them with `docker exec pmm-server` instead.
component_uris() { # comp -> "label<TAB>uri" lines
  local pmm="https://localhost:$PMM_HTTPS_PORT"
  local sep="http://localhost:$SEP_BACKEND_PORT"
  case "$1" in
    pmm)
      printf '%s\t%s\n' \
        "Grafana"         "$pmm/graph/" \
        "PMM UI"          "$pmm/pmm-ui/" \
        "Query Analytics" "$pmm/graph/d/pmm-qan/" \
        "vmui"            "$pmm/prometheus/vmui/" \
        "VM targets"      "$pmm/prometheus/targets" \
        "VMAlert rules"   "$pmm/prometheus/rules" \
        "VMAlert alerts"  "$pmm/prometheus/alerts" \
        "Swagger UI"      "$pmm/swagger/" \
        "PostgreSQL"      "postgres://$POM_DB_USER@$POM_DB_HOST:$POM_DB_PORT/$POM_DB_NAME" \
        "Delve (headless)" "127.0.0.1:2345"
      ;;
    sep-backend)
      # /docs and /redoc are 404 by design (SEP/app/main.py): the top-level app
      # disables them so the unified /api/docs is the one Swagger UI to use.
      printf '%s\t%s\n' \
        "API root"      "$sep/" \
        "Swagger UI"    "$sep/api/docs" \
        "OpenAPI JSON"  "$sep/api/openapi.json" \
        "Inventory API" "$sep/api/inventory/docs" \
        "Tasks API"     "$sep/api/tasks/docs" \
        "Data"          "$(sep_data_location)"
      ;;
    sep-frontend)
      printf '%s\t%s\n' "Dev server" "http://localhost:$SEP_FRONTEND_PORT/"
      ;;
  esac
}

print_uris() { # comp — indented under whatever status line just went out
  local label uri
  while IFS=$'\t' read -r label uri; do
    [[ -n "$label" ]] || continue
    printf '    %s%-16s%s %s\n' "$C_DIM" "$label" "$C_RESET" "$uri"
  done < <(component_uris "$1")
}

comp_up() { # comp -> 0 when it is running
  case "$1" in
    pmm)   [[ "$(docker inspect -f '{{.State.Running}}' "$PMM_CONTAINER" 2>/dev/null)" == "true" ]] ;;
    sep-backend)  port_busy "$SEP_BACKEND_PORT" ;;
    sep-frontend) port_busy "$SEP_FRONTEND_PORT" ;;
    *) return 1 ;;
  esac
}

cmd_urls() {
  local only=("$@")
  [[ ${#only[@]} -gt 0 ]] || only=(pmm sep-backend sep-frontend)
  local comp
  for comp in "${only[@]}"; do
    case "$comp" in
      pmm|sep-backend|sep-frontend) ;;
      backend)  comp=sep-backend ;;
      frontend) comp=sep-frontend ;;
      *) die "no URIs known for '$comp' (pmm|sep-backend|sep-frontend)" ;;
    esac
    if comp_up "$comp"; then info "$comp"; else info "$comp $C_DIM(stopped)$C_RESET"; fi
    print_uris "$comp"
  done
  echo
  dim "PMM and Grafana: admin/admin — the same credentials cover vmui and Swagger"
  dim "SEP /api/docs: Authorize with \`./om discovery token\` to run requests from the page"
}

# ---------------------------------------------------------------------------
# status / logs
# ---------------------------------------------------------------------------

status_line() { # label, up(0/1), detail
  if [[ "$2" == "0" ]]; then
    printf '  %s●%s %-20s %s\n' "$C_GREEN" "$C_RESET" "$1" "$3"
  else
    printf '  %s○%s %-20s %s%s%s\n' "$C_DIM" "$C_RESET" "$1" "$C_DIM" "$3" "$C_RESET"
  fi
}

cmd_status() {
  info "Components"

  if [[ "$(docker inspect -f '{{.State.Running}}' "$PMM_CONTAINER" 2>/dev/null)" == "true" ]]; then
    local ui_note="image bundle — no SEP apps, run './om build ui'"
    pmm_ui_has_sep && ui_note="working tree UI, SEP apps included"
    status_line pmm 0 "https://localhost:$PMM_HTTPS_PORT (container $PMM_CONTAINER)"
    dim "ui: $ui_note"
    print_uris pmm
  else
    status_line pmm 1 "stopped"
  fi

  local comp pid port
  for comp in sep-backend sep-frontend; do
    case "$comp" in
      sep-backend)  port=$SEP_BACKEND_PORT ;;
      sep-frontend) port=$SEP_FRONTEND_PORT ;;
    esac
    if pid="$(read_pid "$comp")"; then
      local listen="not listening yet"
      port_busy "$port" && listen="http://localhost:$port"
      status_line "$comp" 0 "pid $pid — $listen"
      # Only sep-backend has a surface worth expanding here; sep-frontend serves
      # one page, already spelled out on the status line above.
      # `|| true`: under set -e a false tail command in an if-branch exits the script.
      [[ "$comp" == sep-backend ]] && port_busy "$port" && print_uris "$comp" || true
    elif port_busy "$port"; then
      # Something owns the port that om did not start — e.g. a backend launched by
      # hand with `make dev-backend`. Reporting "stopped" here would be misleading.
      status_line "$comp" 0 "http://localhost:$port (not started by om)"
      [[ "$comp" == sep-backend ]] && print_uris "$comp" || true
    else
      status_line "$comp" 1 "stopped"
    fi
  done

  # PSMDB clusters from psmdb/compose.yaml. Reported only when the directory
  # exists, so a checkout without it looks unchanged.
  if [[ -d "$PSMDB_DIR" ]]; then
    echo
    info "PSMDB clusters (psmdb/compose.yaml)"
    local p up expected
    for p in "${PSMDB_PROFILES[@]}"; do
      case "$p" in
        standalone|replicaset-single) expected=1 ;;
        replicaset-cluster)   expected=3 ;;
        sharded-cluster)      expected=11 ;;
      esac
      up="$(psmdb_running "$p")"
      if [[ "${up:-0}" -gt 0 ]]; then
        status_line "$p" 0 "${up}/${expected} container(s) up"
        local uri node
        if uri="$(psmdb_uri "$p")"; then
          # Labelled, because the two are not interchangeable and the first one does
          # not work from a terminal on this machine -- which is exactly the mistake
          # an unlabelled connection string invites.
          dim "on pmm's network  $uri"
          node="$(psmdb_first_node "$p")"
          [[ -n "$node" ]] && \
            dim "from this host    docker exec -it $node sh -c 'mongosh \"\$(cat /root/.mongodb_uri)\"'"
        fi
      else
        status_line "$p" 1 "stopped"
      fi
    done

    # The client hosts. No URI line, deliberately: the whole point of these is
    # that there is nothing on them to connect to. What is worth printing is
    # which of the pool are up, since they are spawned individually.
    echo
    info "PMM-client-only hosts (psmdb/compose.yaml)"
    local cup names
    cup="$(psmdb_running "$CLIENT_PROFILE")"
    if [[ "${cup:-0}" -gt 0 ]]; then
      status_line "$CLIENT_PROFILE" 0 "${cup}/${CLIENT_NODES} host(s) up - pmm-agent + Nomad, no database"
      names="$(docker ps --format '{{.Names}}' | grep -E "^$CLIENT_PROFILE-" | sort | paste -sd' ' -)"
      [[ -n "$names" ]] && dim "$names"
    else
      status_line "$CLIENT_PROFILE" 1 "stopped - ./om start $(client_node_names | head -1)"
    fi
  fi

  echo
  dim "logs: ./om logs <pmm|sep-backend|sep-frontend|<cluster>|pmm-client> [-f]"
  dim "urls: ./om urls [comp...] — the same list for stopped components too"
  # Every line below is about reaching a *database*, so it is gated on a database
  # topology being up rather than on any node: with only client hosts running there
  # are no URIs above for "the first is for SEP" to refer to.
  if [[ -d "$PSMDB_DIR" ]] && [[ -n "$(psmdb_up_profiles | grep -vx "$CLIENT_PROFILE")" ]]; then
    # The network URIs name containers, which only resolve inside the network. A GUI
    # client on this machine can still reach one node directly: container IPs are
    # routable from the host, but only with directConnection=true -- without it the
    # driver asks the set for its members, gets those same container names back, and
    # fails on them instead.
    dim "the first is for SEP, a payload, another container — its names do not resolve"
    dim "here unless you add them:  ./om hosts [--write]"
    dim "for a GUI client:  docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <node>"
    dim "                   then mongodb://root:root-password@<ip>:27017/?authSource=admin&directConnection=true"
  fi
}

cmd_logs() {
  local comp="${1:-}"; shift || true
  local follow=""
  [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]] && follow=1
  case "$comp" in
    pmm)
      docker inspect "$PMM_CONTAINER" >/dev/null 2>&1 \
        || die "$PMM_CONTAINER does not exist — ./om start pmm first"
      if [[ -n "$follow" ]]; then docker logs -f --tail=200 "$PMM_CONTAINER"
      else docker logs --tail=200 "$PMM_CONTAINER"; fi ;;
    standalone|replicaset-single|replicaset-cluster|sharded-cluster|pmm-client|pmm-client-node[0-9][0-9])
      # No om-managed log file: these are compose services, so defer to compose.
      # A single client node works here too, because its own name is also a
      # compose profile - see the pmm-client block in psmdb/compose.yaml.
      if [[ -n "$follow" ]]; then psmdb_compose --profile "$comp" logs -f --tail=200
      else psmdb_compose --profile "$comp" logs --tail=200; fi ;;
    sep-backend|sep-frontend)
      local f; f="$(log_file "$comp")"
      [[ -f "$f" ]] || die "no log yet for $comp"
      if [[ -n "$follow" ]]; then tail -f "$f"; else tail -n 200 "$f"; fi ;;
    "") die "usage: ./om logs <pmm|sep-backend|sep-frontend|replicaset-cluster|replicaset-single|standalone|sharded-cluster|pmm-client[-nodeNN]> [-f]" ;;
    *)  die "unknown component '$comp'" ;;
  esac
}

# ---------------------------------------------------------------------------
# pom (POM: inspect a run across Postgres, VictoriaMetrics and Tasks)
# ---------------------------------------------------------------------------

# SEP's three databases all point at PMM's embedded PostgreSQL, so this is the
# one connection for inventory, tasks and POM's own tables alike.
POM_DB_HOST=127.0.0.1
POM_DB_PORT=5432
POM_DB_NAME=sep
POM_DB_USER=sep


# Reads the SEP database password from SEP/.env. `head -1`: several *__DATABASE__
# PASSWORD keys are set (SEP__, INVENTORY__, TASKS__) and they share one value.
pom_db_password() {
  [[ -f "$SEP_DIR/.env" ]] || die "SEP/.env missing — run ./om setup first"
  grep -oP '(?<=DATABASE__PASSWORD=).*' "$SEP_DIR/.env" | head -1
}

# Reads the PMM API key from SEP/.env. `tail -1`, NOT head: .env carries more than
# one PMM__API_KEY line and python-dotenv takes the last one. Taking the first (or
# worse, grepping without picking one) yields a key SEP is not using, and every
# request silently comes back empty or unauthorized.
pom_pmm_key() {
  [[ -f "$SEP_DIR/.env" ]] || die "SEP/.env missing — run ./om setup first"
  grep -oP '(?<=PMM__API_KEY=).*' "$SEP_DIR/.env" | tail -1
}

# SEP derives the internal token from SECRET_KEY when SEP_INTERNAL_TOKEN is unset, so
# it is always available and always matches what the running backend accepts.
sep_token() {
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  ( cd "$SEP_DIR" && "$SEP_DIR/venv/bin/python" -c \
      'from app.core.security import get_internal_token; print(get_internal_token() or "")' \
  ) 2>/dev/null || die "could not derive the internal token"
}

# ---------------------------------------------------------------------------
# the four ways to reach POM's data
# ---------------------------------------------------------------------------
#
# POM is split across both products, so there are two stores and two APIs:
#
#   sep_psql   SEP's database      pom.host/service/discovery_run - what the probe saw
#   pmm_psql   pmm-managed's       pom_runs/pom_snapshots — the topology documents
#   pmm_api    /v1/pom             what the UI reads
#   sep_api    /api/apps/<app>     any SEP app, discovery being the first
#
# Both psql helpers run inside the pmm-server container rather than over the
# published port: the databases live there, the socket needs no password, and it
# keeps a host psql client from being a prerequisite.

# Where SEP's data actually is, for the status line. The PMM block advertises PMM's
# embedded PostgreSQL whatever this says -- that database exists either way; what
# changes is whether SEP is one of its users.
sep_data_location() {
  if [[ -n "$SEP_DB_DIR" ]]; then
    printf '%s/*.db (OM_SEP_DB_DIR)' "$SEP_DB_DIR"
  else
    printf 'postgres://%s@%s:%s/%s' \
      "$POM_DB_USER" "$POM_DB_HOST" "$POM_DB_PORT" "$POM_DB_NAME"
  fi
}


sep_psql() {
  docker exec -i "$PMM_CONTAINER" psql "postgres://${POM_DB_USER}@127.0.0.1/${POM_DB_NAME}" "$@" \
    || die "cannot reach SEP's database in $PMM_CONTAINER — is pmm running?"
}

# The SQLite file SEP's own tables live in, when OM_SEP_DB_DIR selects that backend.
# POM's tables are SEP's, so this is the file they are in; inventory and tasks keep
# their own, which is also why `service` here cannot collide with inventory's.
sep_sqlite_file() { printf '%s/sep.db' "$SEP_DB_DIR"; }

# How POM's tables are addressed, which is not the same on both backends.
#
# The models declare a *symbolic* schema that the engine translates per bind: to
# `pom` on PostgreSQL, and to the default schema on SQLite, which has no schemas.
# So the same table is `pom.host` in one and plain `host` in the other, and a query
# written for one is a syntax error against the other.
pom_table() {
  if [[ -n "$SEP_DB_DIR" ]]; then printf '%s' "$1"; else printf 'pom.%s' "$1"; fi
}

# Run one query against SEP's database, whichever backend it is on, and print rows
# separated by tabs with no header. `python3` rather than the `sqlite3` CLI because
# the CLI is not a dependency this workspace otherwise has, and python3 always is.
sep_query() {
  if [[ -z "$SEP_DB_DIR" ]]; then
    sep_psql -t -A -F$'\t' -c "$1"
    return
  fi
  python3 - "$(sep_sqlite_file)" "$1" <<'PY'
import sqlite3, sys
path, query = sys.argv[1:3]
try:
    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
except sqlite3.Error as err:
    sys.exit(f"cannot open {path}: {err}")
try:
    for row in con.execute(query):
        print("\t".join("" if value is None else str(value) for value in row))
except sqlite3.Error as err:
    sys.exit(str(err))
PY
}

pmm_psql() {
  docker exec -i "$PMM_CONTAINER" psql "postgres://pmm-managed@127.0.0.1/pmm-managed" "$@" \
    || die "cannot reach pmm-managed's database in $PMM_CONTAINER — is pmm running?"
}

# GETs (or otherwise calls) a path under pmm-managed's POM API. Extra arguments go
# straight to curl, so a write is `pom api discovery/runs -X POST -d '{}'`.
pmm_api() {
  local path="${1#/}"; shift || true
  curl -sk -m 30 -H "Authorization: Bearer $(pom_pmm_key)" \
    "https://127.0.0.1:${PMM_HTTPS_PORT}/v1/pom/${path}" "$@"
}

# The same for any SEP app's API. `app` is the module name as registered in
# settings.yaml, so this keeps working for the upgrade and restart apps to come.
sep_api() {
  local app="$1" path="${2#/}"; shift 2 || true
  curl -s -m 30 -H "Authorization: Bearer $(sep_token)" \
    "http://127.0.0.1:8000/api/apps/${app}/${path}" "$@"
}

# Pretty-prints a JSON body, or passes it through when it is not JSON (an error page,
# an empty body) so a failure is readable rather than swallowed by a parse error.
json_out() {
  python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    print(json.dumps(json.loads(raw), indent=2))
except ValueError:
    sys.stdout.write(raw if raw.strip() else "(empty response)\n")'
}

# ---------------------------------------------------------------------------
# pom — the PMM side: topology documents derived from inventory + VictoriaMetrics
# ---------------------------------------------------------------------------

pom_cmd_show() {
  info "POM topology (pmm-managed)"
  pmm_api topology | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit("  could not read /v1/pom/topology — is pmm-managed up with the POM service?")
s, snap = d["summary"], d["snapshot"]
gen, obs, stale = snap["generated_at"], snap["observed_at"], snap["stale"]
run, origin = snap["run_id"], d.get("origin_node")
print("  generated %s  observed %s  stale=%s" % (gen, obs, stale))
print("  run %s  origin %s" % (run, origin))
print("  %d service(s): %d up, %d down  |  %d cluster(s) in %d environment(s)" % (
    s["services_total"], s["services_up"], s["services_down"], s["clusters"], s["environments"]))
print("  roles: " + ", ".join("%s=%d" % kv for kv in sorted(s["by_process_role"].items())))
'
  echo
  pom_cmd_topology
}

# One row per service, which is what you actually want to look at: the document is
# nested environment -> cluster -> service and unreadable as raw JSON at any size.
pom_cmd_topology() {
  pmm_api topology | python3 -c '
import json, sys
d = json.load(sys.stdin)
rows = [(e.get("env_name") or "-", c.get("name") or "-", s)
        for e in d["environments"] for c in e["clusters"] for s in c["services"]]
if not rows:
    sys.exit("  no MongoDB services in the document")
def g(v, dash="-"):
    return dash if v is None else str(v)
def num(v):
    return "-" if v is None or v == -1 else f"{float(v):.0f}"
hdr = ("SERVICE", "CLUSTER", "ROLE", "STATE", "STATUS", "VERSION", "INSTALLED", "CPU%", "FREE%", "LAG", "OPLOG")
w = [max(len(h), *(len(x) for x in col)) for h, col in zip(hdr, zip(*[
    (s["service_name"], cl, s["process_role"], g(s["state"]), s["status"], g(s["version"]),
     g(s.get("installed_version")), num(s["cpu_usage_percent"]), num(s["connections_free_percent"]),
     num(s["replication_lag_seconds"]), num(s["oplog_window_seconds"]))
    for _, cl, s in rows]))]
print("  " + "  ".join(h.ljust(n) for h, n in zip(hdr, w)))
for _, cl, s in rows:
    cells = (s["service_name"], cl, s["process_role"], g(s["state"]), s["status"], g(s["version"]),
             g(s.get("installed_version")), num(s["cpu_usage_percent"]), num(s["connections_free_percent"]),
             num(s["replication_lag_seconds"]), num(s["oplog_window_seconds"]))
    print("  " + "  ".join(c.ljust(n) for c, n in zip(cells, w)))
'
}

pom_cmd_raw() { pmm_api topology | json_out; }

pom_cmd_runs() {
  info "POM collection runs (pmm-managed)"
  pmm_api "discovery/runs?limit=${1:-15}" | python3 -c '
import json, sys
runs = json.load(sys.stdin).get("runs") or []
if not runs:
    sys.exit("  no runs recorded yet — trigger one with ./om pom run")
for r in runs:
    c = r["counts"]
    src = " ".join("%s=%s" % (x["source"], x["status"]) for x in r.get("sources") or [])
    print("  %s  %-8s total=%-3d up=%-3d stale=%-3d %s" % (
        r["started_at"][11:19], r["status"], c["services_total"],
        c["probes_ok"], c["services_stale"], src))
    for e in r.get("errors") or []:
        print("      ! [%s] %s: %s" % (e["scope"], e["code"], e["message"][:96]))
'
}

pom_cmd_run() {
  info "Triggering a POM collection"
  # Synchronous on the PMM side: inventory is a local read and VictoriaMetrics is on
  # localhost, so this answers with a terminal status rather than an id to poll. It
  # does NOT probe -- on-host facts come from the discovery sweep, ./om discovery run.
  local body; body="$(pmm_api discovery/runs -X POST -d '{}')"
  printf '%s\n' "$body" | json_out
  echo
  pom_cmd_runs 1
}

pom_cmd_sql() {
  [[ $# -gt 0 ]] || die "usage: ./om pom sql <query>   (tables: pom_runs, pom_snapshots)"
  pmm_psql -c "$*"
}

pom_cmd_api() {
  [[ $# -gt 0 ]] || die "usage: ./om pom api <path> [curl args]   e.g. ./om pom api topology"
  local path="$1"; shift
  pmm_api "$path" "$@" | json_out
}

cmd_pom() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show)     pom_cmd_show "$@" ;;
    topology) pom_cmd_topology "$@" ;;
    raw)      pom_cmd_raw "$@" ;;
    runs)     pom_cmd_runs "$@" ;;
    run)      pom_cmd_run "$@" ;;
    sql)      pom_cmd_sql "$@" ;;
    api)      pom_cmd_api "$@" ;;
    *) die "unknown pom subcommand '$sub' (show|topology|raw|runs|run|sql|api)" ;;
  esac
}

# ---------------------------------------------------------------------------
# discovery — the SEP side: on-host facts no metric carries
# ---------------------------------------------------------------------------

disc_cmd_show() {
  info "POM discovery (SEP app pom_discovery)"
  sep_api pom_discovery hosts | python3 -c '
import json, sys
from collections import Counter
try:
    hosts = json.load(sys.stdin)
except ValueError:
    sys.exit("  could not read the app - is sep-backend up and pom_discovery enabled?")
if not isinstance(hosts, list):
    sys.exit("  unexpected answer from /hosts: %s" % str(hosts)[:200])
if not hosts:
    sys.exit("  no host rows - has a sweep run? ./om discovery run")

services = [s for h in hosts for s in h["services"]]
probed = [h for h in hosts if h["last_success_at"]]
failing = [h for h in hosts if h["failing_since"]]
no_executor = [h for h in hosts if not h["executor_host"]]
answered = [s for s in services if s["last_success_at"]]
strangers = sum(len(h["observed"].get("unregistered_mongods") or []) for h in hosts)

print("  %d host(s): %d probed, %d failing, %d with no executor" % (
    len(hosts), len(probed), len(failing), len(no_executor)))
print("  %d service(s): %d answered" % (len(services), len(answered)))
if strangers:
    print("  %d mongod(s) running that PMM has no service for" % strangers)

# The estate is upserted, so what a field is worth knowing is how many rows still
# carry it - not how many the last sweep happened to reach.
fields = Counter(k for s in services for k in s["observed"] if k != "collected_at")
if fields:
    print("  service fields: " + ", ".join(
        "%s=%d" % kv for kv in sorted(fields.items())))
'
}

# The observations themselves, one service per block, labelled with the service name.
#
# Reads the estate rather than the database, which is what makes this different from
# `estate`: the same rows as PMM sees them, through the same endpoint, so a
# disagreement between this and the sql view is a serialisation bug worth finding.
# The optional argument matches the name or any observed value.
disc_cmd_facts() {
  sep_api pom_discovery services | FILTER="${1:-}" python3 -c '
import json, os, sys

services = json.load(sys.stdin)
if not isinstance(services, list):
    sys.exit("  unexpected answer from /services: %s" % str(services)[:200])
if not services:
    sys.exit("  no service rows - has a sweep run? ./om discovery run")

needle = os.environ.get("FILTER", "").lower()
shown = 0
for service in sorted(services, key=lambda s: s["name"] or s["service_id"]):
    observed = {k: v for k, v in service["observed"].items() if k != "collected_at"}
    label = "%s  (%s)" % (service["name"], service["service_id"])
    blob = " ".join([label] + ["%s=%s" % kv for kv in observed.items()]).lower()
    if needle and needle not in blob:
        continue
    shown += 1
    print("  " + label)
    if service["failing_since"]:
        print("      ! %d consecutive failure(s) since %s: %s" % (
            service["consecutive_failures"], service["failing_since"][:16],
            (service["last_error"] or "no detail recorded")[:100]))
    if not observed:
        print("      (never answered a probe)")
    for k, v in sorted(observed.items()):
        print("      %-20s %s" % (k, v))
if not shown:
    sys.exit("  nothing matched %r" % needle)
'
}

# The app's settings, read and written over its own /config.
#
# Not `./om discovery sql "select * from settingoverride"`: that shows the rows that
# *override* the YAML and nothing else, so a value the deployment configured looks
# identical to one that was never configured at all. The endpoint reports both, which
# is the question worth asking -- "why is it sweeping every 10 minutes" is answered by
# the origin, not by the number.
#
# The key set is not symmetric between reading and writing: SCHEDULE is listed as
# SCHEDULE__every and SCHEDULE__period, but only the parent key accepts null, which is
# how the sweep is turned off. Both spellings are passed straight through.
disc_cmd_config() {
  local key="${1:-}" value="${2:-}"

  if [[ -z "$key" ]]; then
    info "POM discovery configuration"
    sep_api pom_discovery config | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except ValueError:
    sys.exit("  could not read the app - is sep-backend up?")
if not isinstance(rows, list):
    sys.exit("  unexpected answer from /config: %s" % str(rows)[:200])
for row in rows:
    if row["reload"] != "hot":
        continue
    origin = "overridden" if row["has_override"] else "from settings.yaml"
    advanced = "  (advanced)" if row["is_advanced"] else ""
    print("  %-22s %-20s %s%s" % (row["key"], row["value"], origin, advanced))
print()
print("  change one with: ./om discovery config <key> <value>")
print("  revert one with: ./om discovery config <key> -")
'
    return
  fi

  [[ -n "$value" ]] || die "usage: ./om discovery config <key> <value>   ('-' reverts)"

  if [[ "$value" == "-" ]]; then
    dim "reverting $key to the deployed value"
    sep_api pom_discovery "config/$key" -X DELETE -o /dev/null -w '%{http_code}\n'
    return
  fi

  # Passed through as JSON so `null`, `true` and numbers keep their types; anything
  # that is not valid JSON is sent as a string, which is what a bare path or name is.
  local body
  body="$(KEY="$key" VALUE="$value" python3 -c '
import json, os
raw = os.environ["VALUE"]
try:
    parsed = json.loads(raw)
except ValueError:
    parsed = raw
print(json.dumps({os.environ["KEY"]: parsed}))
')"
  sep_api pom_discovery config -X PATCH \
    -H 'Content-Type: application/json' -d "$body" | json_out
}


disc_cmd_runs() {
  info "Probe sweeps (SEP)"
  sep_api pom_discovery "runs?limit=${1:-15}" | python3 -c '
import json, sys
runs = json.load(sys.stdin)
if not runs:
    sys.exit("  no sweeps recorded yet — trigger one with ./om discovery run")
for r in runs:
    c = r["counts"]
    print("  %s  %-8s resolved=%-3d answered=%-3d orphaned=%-3d facts=%d" % (
        r["started_at"][11:19], r["status"], c["services_resolved"],
        c["services_answered"], c["services_orphaned"], r["facts_collected"]))
    if r.get("error"):
        print("      ! %s" % r["error"][:100])
'
}

disc_cmd_run() {
  info "Queueing a probe sweep"
  dim "dispatches a Nomad job per executor host; tens of seconds, not instant"
  sep_api pom_discovery runs -X POST | json_out
  echo
  dim "watch it with: ./om discovery runs"
}

# The estate as POM currently holds it: one line per host, its services indented
# under it, and anything running that PMM has no service for called out.
#
# Reads the tables rather than the API on purpose. The API is what a consumer sees;
# this is for the question the API cannot answer -- "is the row actually there, and
# what does it say" -- which is the one you have when a sweep looks right and a page
# looks wrong.
disc_cmd_estate() {
  local filter="${1:-}"
  # Two plain selects rather than one shaped query. Everything that made the shaped
  # version readable -- to_char, ::text, string_agg, jsonb_array_length -- is
  # PostgreSQL-only, and SEP's data can now be on SQLite. `cast(x as text)` and
  # `coalesce` are the portable subset; the rest is done below, where it is easier to
  # read anyway.
  local hosts services
  hosts="$(sep_query "
    select h.node_id, h.name, coalesce(h.executor_host, ''),
           coalesce(cast(h.last_success_at as text), ''),
           coalesce(cast(h.observed as text), '{}'),
           coalesce(h.consecutive_failures, 0)
    from $(pom_table host) h order by h.name;")"
  services="$(sep_query "
    select s.node_id, coalesce(s.name, '?'), coalesce(cast(s.port as text), '?'),
           coalesce(cast(s.last_success_at as text), '')
    from $(pom_table service) s order by s.name;")"

  FILTER="$filter" SERVICES="$services" python3 -c '
import json, os, sys
from collections import defaultdict

by_node = defaultdict(list)
for line in os.environ.get("SERVICES", "").splitlines():
    if not line.strip():
        continue
    node_id, name, port, probed = (line.split("\t") + [""] * 4)[:4]
    by_node[node_id].append("%s :%s%s" % (name, port, "" if probed else " (not probed)"))

needle = os.environ.get("FILTER", "").lower()
shown = rows = 0
for line in sys.stdin:
    if not line.strip():
        continue
    rows += 1
    node_id, name, executor, seen, observed, failures = (
        line.rstrip("\n").split("\t") + [""] * 6
    )[:6]
    try:
        document = json.loads(observed or "{}")
    except ValueError:
        document = {}
    os_name = document.get("os") or "-"
    strangers = len(document.get("unregistered_mongods") or [])
    services = by_node.get(node_id, [])

    if needle and needle not in " ".join([name, executor, os_name, *services]).lower():
        continue
    shown += 1

    marks = []
    # Three different answers to "nothing can run here", not one. Never onboarded,
    # onboarded and down, and onboarded with a broken driver need three different
    # people to fix them, so the view says which.
    state = document.get("executor") or {}
    if not state.get("registered", bool(executor)):
        marks.append("no executor client registered")
    elif not state.get("reachable", True):
        marks.append("executor registered but unreachable")
    elif not state.get("driver_healthy", True):
        detail = state.get("detail")
        marks.append(
            "executor reachable but its driver is unhealthy"
            + (": %s" % detail if detail else "")
        )
    if int(failures or 0):
        marks.append("%s consecutive failure(s)" % failures)
    if strangers:
        marks.append("%s mongod(s) PMM does not know" % strangers)

    # Only when it is a problem. A working repository on every host would be one
    # more line per host saying nothing, and this view is read by scanning it.
    repo = document.get("repo") or {}
    if repo and not repo.get("reachable"):
        via = " via %s" % repo["proxy"] if repo.get("proxy") else ""
        marks.append(
            "cannot reach %s%s: %s"
            % (repo.get("url", "the repository"), via, repo.get("error") or "no detail")
        )

    print("  %-30s %-20s last probed %s" % (name, os_name, seen[:16] or "never"))
    if marks:
        print("      ! " + "; ".join(marks))
    for service in services:
        print("      %s" % service)
    if not services:
        print("      (no MongoDB service registered here)")

if not rows:
    sys.exit("  no host rows - has a sweep run? ./om discovery run")
if not shown:
    sys.exit("  nothing matched %r" % needle)
' <<< "$hosts"
}


disc_cmd_sql() {
  [[ $# -gt 0 ]] || die "usage: ./om discovery sql <query>
    tables: $(pom_table host), $(pom_table service), $(pom_table discovery_run)"
  if [[ -z "$SEP_DB_DIR" ]]; then
    sep_psql -c "$*"
    return
  fi
  # Column-aligned rather than the tab-separated form sep_query gives, because this
  # one is read by a person rather than piped into another program.
  python3 - "$(sep_sqlite_file)" "$*" <<'SQLITE'
import sqlite3, sys
path, query = sys.argv[1:3]
try:
    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    cursor = con.execute(query)
except sqlite3.Error as err:
    sys.exit(str(err))
rows = cursor.fetchall()
if cursor.description is None:
    sys.exit(0)
headers = [column[0] for column in cursor.description]
table = [headers, *[["" if v is None else str(v) for v in row] for row in rows]]
widths = [max(len(row[i]) for row in table) for i in range(len(headers))]
for index, row in enumerate(table):
    print("  ".join(cell.ljust(width) for cell, width in zip(row, widths)).rstrip())
    if index == 0:
        print("  ".join("-" * width for width in widths))
print(f"({len(rows)} rows)")
SQLITE
}

# Any path under the app's API. Extra arguments go straight to curl, so a write is
# `discovery api hosts/<node_id> -X DELETE`.
#
# The status line is printed as well as the body, because the useful writes here have
# no body: a successful DELETE is `204` and nothing else, which json_out can only
# render as "(empty response)" -- indistinguishable from a request that failed
# silently. Reporting the code makes 204 and 404 tell their own story.
disc_cmd_api() {
  [[ $# -gt 0 ]] || die "usage: ./om discovery api <path> [curl args]   e.g. ./om discovery api hosts"
  local path="$1"; shift
  local response status body
  response="$(sep_api pom_discovery "$path" -w $'\n%{http_code}' "$@")"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"

  [[ -n "$body" ]] && printf '%s' "$body" | json_out
  case "$status" in
    2*) ok   "HTTP $status" ;;
    *)  warn "HTTP $status" ;;
  esac
}

disc_cmd_sync() {
  [[ -x "$SEP_DIR/venv/bin/python" ]] || die "SEP venv missing — run ./om setup first"
  info "Syncing SEP inventory from PMM"
  dim "run this after rebuilding a cluster, or every service maps as orphaned"
  ( cd "$SEP_DIR" && "$SEP_DIR/venv/bin/python" - <<'PY'
import asyncio, logging, sys
logging.basicConfig(level=logging.WARNING, stream=sys.stdout)
from app.sep.apps.inventory.sync import run_scheduled_inventory_sync
asyncio.run(run_scheduled_inventory_sync("app.sep.sync.syncers.pmm.PMMSyncer"))
PY
  ) || die "the sync failed — see the traceback above"
  ok "inventory synced"
  sep_psql -c "
    select coalesce(cluster, '-') as cluster, count(*) as services
    from service where type = 'MONGODB' group by 1 order by 1"
}

cmd_discovery() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    show)  disc_cmd_show "$@" ;;
    estate) disc_cmd_estate "$@" ;;
    config) disc_cmd_config "$@" ;;
    facts) disc_cmd_facts "$@" ;;
    runs)  disc_cmd_runs "$@" ;;
    run)   disc_cmd_run "$@" ;;
    sync)  disc_cmd_sync "$@" ;;
    sql)   disc_cmd_sql "$@" ;;
    api)   disc_cmd_api "$@" ;;
    token) sep_token ;;
    *) die "unknown discovery subcommand '$sub' (show|estate|facts|config|runs|run|sync|sql|api|token)" ;;
  esac
}

# Any SEP app's API, for the apps that come after discovery.
cmd_sep_api() {
  [[ $# -ge 2 ]] || die "usage: ./om sep-api <app> <path> [curl args]   e.g. ./om sep-api pom_discovery facts"
  local app="$1" path="$2"; shift 2
  sep_api "$app" "$path" "$@" | json_out
}

# ---------------------------------------------------------------------------
# component dispatch
# ---------------------------------------------------------------------------

# Populates the global COMPONENTS array. Deliberately NOT echo-and-capture: a
# `die` inside a process substitution or $( ) only kills the subshell, so a bad
# component name would print an error and then be silently ignored, leaving the
# caller to act on an empty list.
COMPONENTS=()
expand_components() {
  COMPONENTS=()
  if [[ $# -eq 0 ]]; then
    COMPONENTS=(pmm sep-backend sep-frontend)
    return 0
  fi
  local a
  for a in "$@"; do
    case "$a" in
      all)          COMPONENTS+=(pmm sep-backend sep-frontend) ;;
      sep)          COMPONENTS+=(sep-backend sep-frontend) ;;
      pmm)          COMPONENTS+=(pmm) ;;
      sep-backend|backend)   COMPONENTS+=(sep-backend) ;;
      sep-frontend|frontend) COMPONENTS+=(sep-frontend) ;;
      # `psmdb` is spelled both ways because it is what the directory is called.
      # It stays the four *database* topologies: the client hosts are not a
      # cluster and nobody asking for "the clusters" means them.
      clusters|psmdb)        COMPONENTS+=("${PSMDB_PROFILES[@]}") ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) COMPONENTS+=("$a") ;;
      # The whole pool, or one host of it by name.
      pmm-client|pmm-clients|clients) COMPONENTS+=("$CLIENT_PROFILE") ;;
      *)
        client_node_name "$a" || die "unknown component '$a' (pmm|sep-backend|sep-frontend|sep|all|clusters|standalone|replicaset-single|replicaset-cluster|sharded-cluster|pmm-client|$(client_node_names | paste -sd'|' -))"
        COMPONENTS+=("$a")
        ;;
    esac
  done
}

# `./om start` and `./om stop` with no arguments act on the whole machine, clusters
# included, and the clusters they act on are the ones that were up last time. Naming
# components explicitly bypasses all of that and means exactly what it says.
cmd_start() {
  if [[ $# -eq 0 ]]; then
    local remembered=() line
    while read -r line; do [[ -n "$line" ]] && remembered+=("$line"); done < <(psmdb_remembered)
    if [[ ${#remembered[@]} -gt 0 ]]; then
      dim "clusters from the last ./om stop: ${remembered[*]}"
      set -- pmm sep-backend sep-frontend "${remembered[@]}"
    fi
  fi
  expand_components "$@"
  local c
  for c in "${COMPONENTS[@]}"; do
    case "$c" in
      pmm)          start_pmm ;;
      sep-backend)  start_sep_backend ;;
      sep-frontend) start_sep_frontend ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) start_sandbox_node "$c" ;;
      pmm-client|pmm-client-node[0-9][0-9]) start_sandbox_node "$c" ;;
    esac
  done
  echo
  cmd_status
}

cmd_stop() {
  if [[ $# -eq 0 ]]; then
    # Record before stopping anything: afterwards there is nothing left to look at.
    psmdb_remember_up
    local running=() line
    while read -r line; do [[ -n "$line" ]] && running+=("$line"); done < <(psmdb_remembered)
    [[ ${#running[@]} -gt 0 ]] && dim "clusters to restore on the next ./om start: ${running[*]}"
    set -- pmm sep-backend sep-frontend "${running[@]}"
  fi
  expand_components "$@"
  # Reverse order so dependents go down before what they depend on.
  local comps=() i
  for (( i=${#COMPONENTS[@]}-1; i>=0; i-- )); do comps+=("${COMPONENTS[$i]}"); done
  local c
  for c in "${comps[@]}"; do
    case "$c" in
      pmm)          stop_pmm ;;
      sep-backend)  info "sep-backend: stopping";  stop_native sep-backend ;;
      sep-frontend) info "sep-frontend: stopping"; stop_native sep-frontend ;;
      standalone|replicaset-single|replicaset-cluster|sharded-cluster) stop_sandbox_node "$c" ;;
      pmm-client|pmm-client-node[0-9][0-9]) stop_sandbox_node "$c" ;;
    esac
  done
}

cmd_restart() {
  cmd_stop "$@"
  echo
  cmd_start "$@"
}

# Prints the header comment block as the help text: from the first line of the
# block to the blank line that ends it, so it stays right as the block grows.
usage() { sed -n '3,/^$/p' "${BASH_SOURCE[0]}" | sed "s/^# \{0,1\}//"; }

main() {
  local cmd="${1:-}"; shift || true
  # Before anything, so every command works from one rendered file. Cheap, and it
  # has to happen here rather than in start_sep_backend: migrations, the beat
  # bootstrap and the inventory sync all build settings in their own processes.
  render_sep_settings
  case "$cmd" in
    bootstrap) cmd_bootstrap "$@" ;;
    setup)   cmd_setup "$@" ;;
    env)     cmd_env "$@" ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    status)  cmd_status ;;
    logs)    cmd_logs "$@" ;;
    build)   cmd_build "$@" ;;
    pom)     cmd_pom "$@" ;;
    discovery) cmd_discovery "$@" ;;
    sep-api) cmd_sep_api "$@" ;;
    ports)   cmd_ports ;;
    urls|uris) cmd_urls "$@" ;;
    hosts)   cmd_hosts "$@" ;;
    inventory) cmd_inventory "$@" ;;
    reset)   cmd_reset "$@" ;;
    doctor)  cmd_doctor ;;
    ""|-h|--help|help) usage ;;
    *) err "unknown command '$cmd'"; echo; usage; exit 1 ;;
  esac
}

main "$@"
