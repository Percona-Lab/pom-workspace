{
	"folders": [
		{
			"name": "PMM (Percona Monitoring & Management)",
			"path": "pmm"
		},
		{
			"name": "SEP (Services Enablement Platform)",
			"path": "SEP"
		},
		{
			"name": "PSMDB Sandbox (mongo_terraform_ansible)",
			"path": "mongo_terraform_ansible"
		},
		{
			"name": "UI view",
			"path": "ui-view"
		}
	],
	"settings": {
		// --- Python Settings (SEP) ---
		"python.defaultInterpreterPath": "${workspaceFolder:SEP}/venv/bin/python",
		"python.languageServer": "Pylance",
		"python.analysis.typeCheckingMode": "basic",
		"python.analysis.indexing": true,
		"python.analysis.autoSearchPaths": true,
		"python.analysis.extraPaths": [
			"${workspaceFolder:SEP}/app",
			"${workspaceFolder:SEP}"
		],
		"python.terminal.activateEnvironment": true,
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff",
			"editor.formatOnSave": true,
			"editor.codeActionsOnSave": {
				"source.organizeImports.ruff": "explicit",
				"source.fixAll.ruff": "explicit"
			}
		},

		// --- Go Settings (PMM) ---
		"go.useLanguageServer": true,
		"go.formatTool": "gofmt",
		"go.lintTool": "golangci-lint",
		"go.lintFlags": [
			"--fast"
		],
		"go.goplsOptions": {
			"formatting.gofumpt": true,
			"ui.completion.usePlaceholders": true,
			"ui.diagnostic.staticcheck": true,
			"ui.navigation.importShortcut": "Definition"
		},
		"[go]": {
			"editor.defaultFormatter": "golang.go",
			"editor.formatOnSave": true,
			"editor.codeActionsOnSave": {
				"source.organizeImports": "explicit"
			}
		},

		// --- Frontend & TypeScript / JavaScript Settings (PMM & SEP) ---
		"eslint.workingDirectories": [
			"./pmm/ui",
			"./SEP/frontend"
		],
		"typescript.tsdk": "${workspaceFolder:pmm}/ui/node_modules/typescript/lib",
		"typescript.suggest.completeFunctionCalls": true,
		"[typescript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[typescriptreact]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[javascript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[javascriptreact]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},

		// --- General Formatters & Code Style ---
		"[json]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[jsonc]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[yaml]": {
			"editor.defaultFormatter": "redhat.vscode-yaml",
			"editor.formatOnSave": true
		},
		"[html]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},

		// --- Exclusions for Performance & Clean Search ---
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/node_modules/*/**": true,
			"**/venv/*/**": true,
			"**/build/**": true,
			"**/dist/**": true,
			"**/.ruff_cache/**": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/venv": true,
			"**/build": true,
			"**/dist": true,
			"**/.coverage": true,
			"**/.ruff_cache": true,
			"**/go.sum": true,
			"**/pnpm-lock.yaml": true,
			"**/yarn.lock": true
		}
	},
	"extensions": {
		"recommendations": [
			// Go Development
			"golang.go",
			// Python Development
			"ms-python.python",
			"ms-python.vscode-pylance",
			"charliermarsh.ruff",
			// Web / TypeScript / JavaScript
			"esbenp.prettier-vscode",
			"dbaeumer.vscode-eslint",
			"oxc.oxc-vscode",
			// Claude AI Agent Integration
			"saoudrizwan.claude-dev",
			"anthropic.claude-code",
			// Infrastructure & DevOps
			"ms-azuretools.vscode-docker",
			"redhat.vscode-yaml",
			"ms-vscode.makefile-tools",
			"tamasfe.even-better-toml",
			"eamodio.gitlens"
		]
	}
}
