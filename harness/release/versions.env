# The release stack's versions, the one place they are pinned. ./om reads this for
# both the containers and the node images; compose.yaml refuses to start without it.
#
# The server and client tags move with each RC build, so every image carries its
# digest. The client is built into every node from PMM_CLIENT_IMAGE, so the
# package channel below only supplies its user, unit and symlinks.

PMM_SERVER_IMAGE=perconalab/pmm-server:3.10.0-rc3002@sha256:0014c6dd7ab5a68a2a3a91ff56a7eb0f9848b708f22d5a8d975946c03c6ce89a
PMM_EXTENSIONS_IMAGE=percona/pmm-extensions:3.10.0-rc1@sha256:11f3d63458e6dce2d2f7c1e51d99eee6113e235b936b57e972e43b5b5339a4c1
PMM_CLIENT_IMAGE=docker.io/perconalab/pmm-client:3.10.0-rc@sha256:5fc2d8f1af16469209a5bdf686b5ec6b99904b9c9160619ca2085adfc02bf13c
PMM_CLIENT_CHANNEL=testing
