# Runtime state written by ./om — pids, logs, and whatever a component leaves
# behind. Recreated on every `./om start`.
.om/
*.log

# Secrets. None of these are templates or examples — they hold live values.
#   passwd.txt          scratch credentials for the dev stack
passwd.txt
.env
*.pem
*.key

# Byte-cache for the tools/ scripts. clusters.py is imported by its siblings, so
# running any of them leaves a __pycache__ behind, one per interpreter version.
__pycache__/

# Working notes, kept local. docs/ is the committed documentation.
notes/
todo/

# A standalone checkout that used to be a submodule here. Kept on disk for
# reference, but no longer part of this workspace.
mongo_terraform_ansible/

# Per-machine Claude Code permissions. .claude/settings.json IS committed.
.claude/settings.local.json

# Rendered by ./om start pmm from pmm.conf + harness/sep-locations.conf.
harness/pmm.conf
harness/sep-settings.yaml
# Rendered by ./om start sep-backend from SEP/.env, minus the database credentials.
harness/sep.env
