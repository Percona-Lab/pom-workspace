#!/usr/bin/env bash
# Stub `pbm` for local payload debugging: records argv, emits plausible output,
# exits 0 — so the payload's control flow runs without a cluster or storage.
[ -n "$SEP_PBM_STUB_LOG" ] && printf 'pbm %s\n' "$*" >> "$SEP_PBM_STUB_LOG"
case "$1" in
  version) echo "Version:   2.15.0" ;;
  config)
    # `pbm config` with no args prints the current config; the payload parses it.
    if [ "$2" = "--file" ] || [ "$2" = "--set" ]; then
      echo "[stub] applied: $*"
    else
      cat <<'YAML'
storage:
  type: s3
  s3:
    region: us-east-1
    endpointUrl: http://omtest1-minio:9000
    bucket: mongo-backups
YAML
    fi ;;
  status) echo '{"backups":{"snapshot":[]},"cluster":[]}' ;;
  list)   echo '{"snapshots":[]}' ;;
  backup) echo "Starting backup '[stub]' ... done" ;;
  restore) echo "Starting restore '[stub]' ... done" ;;
  *) echo "[stub] pbm $*" ;;
esac
exit 0
